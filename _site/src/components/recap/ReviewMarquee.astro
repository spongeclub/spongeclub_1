---
import type { ReviewItem } from '../../lib/recap';
type Props = {
  items: ReviewItem[];
  durationSec?: number;
  reverse?: boolean;
  ariaLabel?: string;
};
const { items, durationSec = 140, reverse = false, ariaLabel = '크루 후기 롤링' } = Astro.props;
const loop = [...items, ...items]; // 이음매 없는 루프용 2벌
---
<div class="rv" role="region" aria-label={ariaLabel}>
  <ul class="rv-track" class:list={[{ rev: reverse }]} style={`--dur:${durationSec}s`}>
    {loop.map((it, i) => (
      <li class="rv-card" aria-hidden={i >= items.length ? 'true' : null}>
        <span class="rv-quote" aria-hidden="true">”</span>
        <p class="rv-text">{it.text}</p>
        <div class="rv-foot">
          <span class="rv-mono" style={`background:${it.color}`}>{it.monogram}</span>
          <span class="rv-who">
            <strong>{it.nickname}</strong>
            <span class="rv-team">{it.team}</span>
          </span>
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  .rv {
    overflow: hidden; padding: 8px 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  .rv-track {
    display: flex; gap: 16px; width: max-content; margin: 0; padding: 0 16px;
    list-style: none; animation: rv-scroll var(--dur, 140s) linear infinite;
  }
  .rv-track.rev { animation-direction: reverse; }
  .rv:hover .rv-track { animation-play-state: paused; }
  @keyframes rv-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  .rv-card {
    flex: 0 0 auto; width: 320px; min-height: 200px;
    display: flex; flex-direction: column;
    padding: 20px 22px 18px; border: 1px solid #e2e8f0; border-radius: 18px;
    background: #fff; box-shadow: 0 2px 10px rgba(15,23,42,.04);
    position: relative;
  }
  .rv-quote {
    position: absolute; top: 6px; right: 18px;
    font-size: 56px; line-height: 1; color: #e2e8f0; font-weight: 900;
    font-family: Georgia, 'Times New Roman', serif;
  }
  .rv-text {
    flex: 1; margin: 6px 0 16px; font-size: 13.5px; line-height: 1.65; color: #334155;
    overflow: hidden; text-overflow: ellipsis;
    display: -webkit-box; -webkit-line-clamp: 7; -webkit-box-orient: vertical;
  }
  .rv-foot { display: flex; align-items: center; gap: 10px; margin-top: auto; }
  .rv-mono {
    flex: 0 0 34px; height: 34px; border-radius: 50%; color: #fff;
    font-weight: 800; font-size: 15px; display: flex; align-items: center; justify-content: center;
  }
  .rv-who { display: flex; flex-direction: column; line-height: 1.25; }
  .rv-who strong { font-size: 13.5px; color: #0f172a; }
  .rv-team { font-size: 11px; color: #94a3b8; font-weight: 700; }

  @media (max-width: 640px) {
    .rv-card { width: 270px; min-height: 188px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rv { -webkit-mask-image: none; mask-image: none; overflow-x: auto; }
    .rv-track { animation: none; }
  }
</style>
