---
import type { SpotlightItem } from '../../lib/recap';
type Props = { items: SpotlightItem[] };
const { items } = Astro.props;
---
<section class="sl" data-spotlight>
  <div class="sl-viewport">
    <ul class="sl-track" data-sl-track>
      {items.map((d) => (
        <li class="sl-slide">
          <a class="sl-card" href={d.href}>
            <div class="sl-top" style={`--c:${d.color}`}>
              <span class="sl-mono" style={`background:${d.color}`}>{d.monogram}</span>
              <span class="sl-id">
                <strong>{d.nickname}</strong>
                <span class="sl-team">{d.team} · {d.teamTopic}</span>
              </span>
            </div>
            <div class="sl-body">
              <p class="sl-label">📚 이런 걸 배우고</p>
              <p class="sl-learn">{d.learned}</p>
              <p class="sl-label">🛠️ 6주 동안 만든 것</p>
              <div class="sl-made">{d.made.map((m) => <span class="made">{m}</span>)}</div>
              <div class="sl-weeks">
                {[1,2,3,4,5,6].map((w) => <span class:list={['wk', { on: d.weeksActive.includes(w) }]}>{w}주</span>)}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="sl-nav">
    <button class="sl-arrow" data-sl-prev type="button" aria-label="이전 멤버">‹</button>
    <span class="sl-count"><b data-sl-cur>1</b> <span class="sl-count-sep">/</span> {items.length}</span>
    <button class="sl-arrow" data-sl-next type="button" aria-label="다음 멤버">›</button>
  </div>
</section>

<style>
  .sl { max-width: 560px; margin: 0 auto; }
  .sl-viewport { overflow: hidden; border-radius: 20px; box-shadow: 0 10px 34px rgba(15,23,42,.08); transition: height .45s cubic-bezier(.4, 0, .2, 1); }
  .sl-track { display: flex; align-items: flex-start; margin: 0; padding: 0; list-style: none; transition: transform .5s cubic-bezier(.4, 0, .2, 1); }
  .sl-slide { flex: 0 0 100%; min-width: 0; display: flex; }
  .sl-card { flex: 1; display: block; background: #fff; text-decoration: none; color: inherit; }
  .sl-top { display: flex; align-items: center; gap: 12px; padding: 18px 20px; background: linear-gradient(135deg, #0f172a, var(--c, #1e3a5f)); color: #fff; }
  .sl-mono { flex: 0 0 46px; width: 46px; height: 46px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 20px; }
  .sl-id { display: flex; flex-direction: column; min-width: 0; }
  .sl-id strong { font-size: 22px; font-weight: 800; }
  .sl-team { font-size: 12px; color: #cbd5e1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sl-body { padding: 16px 20px 20px; }
  .sl-label { font-size: 10px; letter-spacing: 1px; color: #0891b2; font-weight: 800; text-transform: uppercase; margin: 12px 0 4px; }
  .sl-body .sl-label:first-child { margin-top: 0; }
  .sl-learn { font-size: 14px; line-height: 1.6; color: #0f172a; }
  .sl-made { display: flex; flex-wrap: wrap; gap: 6px; }
  .made { background: #ecfeff; border: 1px solid #a5f3fc; color: #083344; border-radius: 8px; padding: 5px 9px; font-size: 12px; font-weight: 600; }
  .sl-weeks { display: flex; gap: 4px; margin-top: 14px; }
  .wk { flex: 1; text-align: center; font-size: 10px; color: #94a3b8; background: #f1f5f9; border-radius: 6px; padding: 6px 0; }
  .wk.on { background: #fde68a; color: #451a03; font-weight: 700; }

  .sl-nav { display: flex; align-items: center; justify-content: center; gap: 14px; padding: 14px 0 0; }
  .sl-arrow { width: 36px; height: 36px; border-radius: 50%; border: 1px solid #cbd5e1; background: #fff; color: #0f172a; font-size: 20px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .15s, border-color .15s; }
  .sl-arrow:hover { background: #f1f5f9; border-color: #94a3b8; }
  .sl-count { font-size: 13px; color: #64748b; font-variant-numeric: tabular-nums; min-width: 56px; text-align: center; }
  .sl-count b { color: #0f172a; font-weight: 800; }
  .sl-count-sep { color: #cbd5e1; margin: 0 2px; }

  @media (prefers-reduced-motion: reduce) {
    .sl-track { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((root) => {
    const viewport = root.querySelector<HTMLElement>('.sl-viewport');
    const track = root.querySelector<HTMLElement>('[data-sl-track]');
    if (!track || !viewport) return;
    const slideEls = Array.from(track.children) as HTMLElement[];
    const slides = slideEls.length;
    if (slides === 0) return;
    const cur = root.querySelector<HTMLElement>('[data-sl-cur]');
    let i = 0, paused = false;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 활성 카드 높이에 뷰포트를 맞춘다 → 슬라이드마다 어색한 빈 여백 없음
    function setHeight() {
      const h = slideEls[i]?.offsetHeight;
      if (h) viewport!.style.height = h + 'px';
    }
    function go(n: number) {
      i = (n + slides) % slides;
      track!.style.transform = `translateX(-${i * 100}%)`;
      if (cur) cur.textContent = String(i + 1);
      setHeight();
    }

    setHeight();
    window.addEventListener('resize', setHeight);
    window.addEventListener('load', setHeight); // 이미지·폰트 로드 후 높이 보정

    if (slides > 1) {
      root.querySelector('[data-sl-prev]')?.addEventListener('click', () => go(i - 1));
      root.querySelector('[data-sl-next]')?.addEventListener('click', () => go(i + 1));
      root.addEventListener('mouseenter', () => { paused = true; });
      root.addEventListener('mouseleave', () => { paused = false; });
      root.addEventListener('focusin', () => { paused = true; });
      root.addEventListener('focusout', () => { paused = false; });
      if (!reduce) setInterval(() => { if (!paused) go(i + 1); }, 3000);
    }
  });
</script>
