---
import type { RecapStats } from '../../lib/recap';
import SpongeVillageGif from '../SpongeVillageGif.astro';
type Props = { stats: RecapStats };
const { stats } = Astro.props;

// 라이브 홈페이지(spongeclub-homepage.vercel.app) 히어로 디자인 그대로.
// 배너 이미지 = 홈페이지와 동일한 SpongeVillageGif 컴포넌트(파인애플 빌리지).
// 정량데이터: 함께한 지(D-day, 매일 갱신) · 멤버 · 누적 기록 · 산출물.
// ⚠️ '누적 기록 226' / '산출물 20' 은 라이브 값 그대로 — 실제 1기 최종 수치로 바꾸려면 아래 상수만 수정.
const DDAY_FROM = '2026-05-03';
const recordCount = 226;
const artifactCount = 20;
const villageTeams = ['1조', '2조', '3조', '4조', '5조', '6조'].map((name) => ({ name }));
---
<section class="hp-hero">
  <div class="hp-hero-text">
    <span class="hp-hero-kicker">SEASON 1 · 회고</span>
    <h1 class="hp-hero-title">흡수하고, 짜내고, 냅다 만든다</h1>
    <p class="hp-hero-lede">
      스폰지처럼 AI를 빨아들여 나만의 제품으로<br />
      <span class="hp-hero-lede-em">AI 빌더 커뮤니티 · 스폰지클럽</span>
    </p>
  </div>
  <div class="hp-hero-village">
    <SpongeVillageGif teams={villageTeams} interactive={false} />
  </div>
</section>

<section class="hp-stats">
  <div class="hp-stats-inner">
    <div class="hp-stat"><span class="hp-stat-num" id="hp-stat-dday" data-dday-from={DDAY_FROM}>{stats.togetherDays}</span><span class="hp-stat-label">함께한 지</span></div>
    <div class="hp-stat"><span class="hp-stat-num">{stats.members}</span><span class="hp-stat-label">멤버</span></div>
    <div class="hp-stat"><span class="hp-stat-num">{recordCount}</span><span class="hp-stat-label">누적 기록</span></div>
    <div class="hp-stat"><span class="hp-stat-num">{artifactCount}</span><span class="hp-stat-label">산출물</span></div>
  </div>
</section>

<style>
  /* 라이브 홈페이지 히어로 그대로 (sc 디자인 토큰은 global.css에서 옴) */
  .hp-hero { position: relative; width: 100%; display: grid; }
  .hp-hero-village { grid-area: 1 / 1; width: 100%; height: 100%; display: block; position: relative; z-index: 1; background: #e5cfaa; overflow: hidden; }
  .hp-hero-village::after { content: ""; position: absolute; left: 0; right: 0; top: 100%; height: 100px; background: linear-gradient(180deg, #e5cfaa 0% 14%, #ecdfc4 42%, #f4ecd8 70%, #fffbed); pointer-events: none; z-index: 1; }
  .hp-hero-text { grid-area: 1 / 1; z-index: 2; align-self: center; justify-self: center; width: 100%; max-width: 1000px; margin-inline: auto; padding: clamp(56px, 8vw, 104px) clamp(20px, 3.4vw, 44px); display: flex; flex-direction: column; gap: 16px; align-items: center; justify-content: center; text-align: center; }
  .hp-hero-kicker { font-family: var(--sc-font-body); font-size: 12px; font-weight: 700; letter-spacing: .14em; color: var(--sc-text-primary); background: var(--sc-bg-signature); padding: 6px 13px; border-radius: var(--sc-radius-pill); box-shadow: 0 4px 14px #1a1f361f; }
  .hp-hero-title { font-family: var(--sc-font-display); font-weight: 400; font-size: clamp(32px, 5vw, 68px); line-height: 1.1; letter-spacing: -.015em; color: var(--sc-text-primary); word-break: keep-all; }
  .hp-hero-lede { font-size: clamp(15px, 1.7vw, 19px); font-weight: 600; line-height: 1.6; color: var(--sc-text-primary); }
  .hp-hero-lede-em { display: inline-block; margin-top: 2px; font-weight: 800; color: var(--sc-text-primary); }

  /* .sv-village 기본 스타일은 SpongeVillageGif 컴포넌트(is:global)에서 제공 */

  .hp-stats { background: #f8d64d; border-top: 1px solid rgba(26,31,54,.1); border-bottom: 1px solid rgba(26,31,54,.1); }
  .hp-stats-inner { position: relative; z-index: 3; max-width: 1200px; margin: 0 auto; padding: 24px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .hp-stat { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; }
  .hp-stat-num { font-family: var(--sc-font-display); font-weight: 400; font-size: clamp(34px, 4vw, 52px); line-height: 1; color: #523a0b; font-variant-numeric: tabular-nums; }
  .hp-stat-label { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #1a1f36a6; }
  @media (max-width: 600px) { .hp-stats-inner { grid-template-columns: repeat(2, 1fr); gap: 16px; } }
</style>

<!-- 자식 컴포넌트(.sv-village)에 닿아야 하는 오버라이드는 전역으로 (홈페이지 히어로와 동일 높이) -->
<style is:global>
  .hp-hero-village .sv-village { aspect-ratio: auto; height: 100%; min-height: 100%; max-height: none; overflow: hidden; -webkit-mask-image: linear-gradient(180deg, #000 94%, transparent 100%); mask-image: linear-gradient(180deg, #000 94%, transparent 100%); }
  .hp-hero-village .sv-village-gif { object-position: center bottom; filter: blur(48px) saturate(1.15); transform: scale(1.35); }
</style>

<script>
  // 함께한 지 D-day 매일 클라이언트 갱신 (라이브 동작 동일)
  const el = document.getElementById('hp-stat-dday');
  if (el?.dataset.ddayFrom) {
    const [y, m, d] = el.dataset.ddayFrom.split('-').map(Number);
    const fromUTC = Date.UTC(y, m - 1, d);
    const now = new Date();
    const kst = new Date(now.getTime() + (now.getTimezoneOffset() + 540) * 60000);
    const todayUTC = Date.UTC(kst.getFullYear(), kst.getMonth(), kst.getDate());
    const days = Math.max(0, Math.floor((todayUTC - fromUTC) / 86400000));
    el.textContent = String(days);
  }
</script>
