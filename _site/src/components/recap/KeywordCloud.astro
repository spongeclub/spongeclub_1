---
import type { KeywordWeight } from '../../lib/recap';
type Props = { keywords: KeywordWeight[] };
const { keywords } = Astro.props;
const palette = ['#0891b2', '#6366f1', '#16a34a', '#db2777', '#f59e0b', '#7c3aed', '#0f172a'];
// 폰트 크기: weight 0~1 → 0.9rem ~ 2.8rem
const fontFor = (w: number) => (0.9 + w * 1.9).toFixed(2);
const opacityFor = (w: number) => (0.5 + w * 0.5).toFixed(2);
---
<div class="kw-cloud" role="img" aria-label={`1기 키워드 분석 — 가장 많이 나온 키워드: ${keywords.slice(0, 5).map((k) => k.keyword).join(', ')}`}>
  {keywords.map((k, i) => (
    <span
      class="kw"
      title={`${k.count}회`}
      style={`font-size:${fontFor(k.weight)}rem;color:${palette[i % palette.length]};opacity:${opacityFor(k.weight)}`}
    >{k.keyword}</span>
  ))}
</div>

<style>
  .kw-cloud {
    display: flex; flex-wrap: wrap; gap: 6px 18px;
    align-items: center; justify-content: center;
    max-width: 820px; margin: 0 auto; padding: 24px 20px; line-height: 1.15;
  }
  .kw { font-weight: 800; letter-spacing: -.01em; white-space: nowrap; transition: transform .15s ease; }
  .kw:hover { transform: scale(1.08); opacity: 1 !important; }
</style>
