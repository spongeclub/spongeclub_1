---
import type { MemberProfile } from '../lib/members';
const { m } = Astro.props as { m: MemberProfile };
const LOGO = '/assets/sponge-logo.png';
const sns = m.sns;
const hasSns = !!(sns.instagram || sns.linkedin || sns.threads || sns.blog || sns.portfolio);
const jobField = [m.jobTitle, m.field].filter(Boolean).join(' · ');
---
<button class="mm-card" type="button" aria-label={`${m.nickname} 카드 뒤집기`}>
  <div class="mm-inner">
    <!-- 앞면 -->
    <div class="mm-front">
      <div class="mm-avatar">
        <img src={m.image || LOGO} alt={m.nickname} loading="lazy" class={m.image ? '' : 'is-logo'} />
      </div>
      <div class="mm-name">{m.nickname}</div>
      <div class="mm-team">{m.team}{m.isLeader && <span class="mm-crew">조장</span>}</div>
    </div>
    <!-- 뒷면 -->
    <div class="mm-back">
      <div class="mm-back-head">
        <div class="mm-back-name">{m.nickname}</div>
        {hasSns && (
          <div class="mm-sns">
            {sns.instagram && <a href={sns.instagram} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()" aria-label="Instagram"><img src="/assets/sns/instagram.svg" alt="Instagram" class="mm-sns-icon" /></a>}
            {sns.linkedin && <a href={sns.linkedin} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()" aria-label="LinkedIn"><img src="/assets/sns/linkedin.svg" alt="LinkedIn" class="mm-sns-icon" /></a>}
            {sns.threads && <a href={sns.threads} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()" aria-label="Threads"><img src="/assets/sns/threads.png" alt="Threads" class="mm-sns-icon" /></a>}
            {sns.blog && <a href={sns.blog} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()" aria-label="Blog"><span class="mm-sns-text-icon">N</span></a>}
            {sns.portfolio && <a href={sns.portfolio} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()" aria-label="Portfolio"><svg class="mm-sns-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></a>}
          </div>
        )}
      </div>
      {jobField && <p class="mm-oneliner">{jobField}</p>}
      {m.gallery.length > 0 && (
        <div class="mm-works">
          {m.gallery.map((w) => (
            <a class="mm-work" href={w.url} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">🔗 {w.title}</a>
          ))}
        </div>
      )}
      {!jobField && !hasSns && m.gallery.length === 0 && (
        <p class="mm-empty">소개 준비 중</p>
      )}
    </div>
  </div>
</button>
