---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/recap/Hero.astro';
import ActText from '../../components/recap/ActText.astro';
import Spotlight from '../../components/recap/Spotlight.astro';
import Marquee from '../../components/recap/Marquee.astro';
import {
  recapStats, buildSpotlight, buildMemberRolling, buildGalleryStrip,
  afterKeywords, assertRecapData,
} from '../../lib/recap';

assertRecapData(); // 빌드타임 불변식 (깨지면 빌드 실패)

const stats = recapStats();
const spotlight = buildSpotlight();
const memberItems = buildMemberRolling();
const galleryItems = buildGalleryStrip();
const keywords = afterKeywords(8);

// ⚠️ 사용자 검수 대상 카피 (BEFORE / AFTER / CLOSING)
const beforeBody = '막막함, 혼자, 작심삼일. 누가 시키지 않아도 매주 무언가를 만들어 올린다는 건 처음엔 낯선 일이었다. 우리는 그렇게 조심스럽게 첫 줄을 적었다.';
const afterBody = '6주 뒤, 남은 건 결과물만이 아니었다. "일단 끝내는 힘", "나만의 OS", 그리고 같이 만드는 동료. 각자 다른 길을 갔지만 우리는 같은 리듬을 익혔다.';
const closingTitle = '그래서 시즌 1은, 우리에게 "매주 끝내는 근육"이었다';
---
<Layout title="시즌1 회고 | 스폰지클럽" description="76명이 6주간 매주 만들고 나눈 기록 — 우리가 이렇게 성장했다.">
  <Hero stats={stats} />

  <ActText tag="🌱 ACT 1 · BEFORE" title="우리는 이렇게 시작했다" body={beforeBody} />

  <p class="recap-bridge">↓ 그리고 6주가 흘렀다 ↓</p>

  <section class="recap-section">
    <p class="recap-tag">⭐ 76명의 6주</p>
    <h2 class="recap-h2">이 사람은 이렇게 성장했다</h2>
    <Spotlight items={spotlight} />
  </section>

  <section class="recap-section">
    <p class="recap-tag">👥 멤버 전체</p>
    <Marquee items={memberItems} durationSec={80} reverse ariaLabel="멤버 성장 롤링" />
  </section>

  <p class="recap-bridge">↓ 우리가 만든 것들 ↓</p>

  <section class="recap-section">
    <p class="recap-tag">🖼️ 결과물 갤러리</p>
    <h2 class="recap-h2">1기가 만든 것들</h2>
    <Marquee items={galleryItems} durationSec={45} ariaLabel="결과물 갤러리 롤링" />
  </section>

  <ActText tag="🌳 ACT 3 · AFTER" title="그래서, 무엇이 남았나" body={afterBody}>
    <ul class="recap-kw">
      {keywords.map((k) => <li>#{k.keyword}</li>)}
    </ul>
  </ActText>

  <ActText tag="SEASON 1 · CLOSING" title={closingTitle} variant="dark">
    <a class="recap-cta" href="/">스폰지클럽 홈으로 →</a>
  </ActText>
</Layout>

<style>
  .recap-section { max-width: 760px; margin: 0 auto; padding: 18px 16px; }
  .recap-tag { max-width: 720px; margin: 0 auto; padding: 0 8px; font-size: 11px; letter-spacing: 2px; font-weight: 800; color: #64748b; }
  .recap-h2 { max-width: 720px; margin: 4px auto 14px; padding: 0 8px; font-size: clamp(20px, 4vw, 26px); font-weight: 800; color: #0f172a; }
  .recap-bridge { text-align: center; font-size: 12px; letter-spacing: 1px; font-weight: 700; color: #f59e0b; padding: 10px 0; }
  .recap-kw { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0; padding: 0; list-style: none; }
  .recap-kw li { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 6px 12px; font-size: 13px; color: #334155; }
  .recap-cta { display: inline-block; margin-top: 14px; background: #38bdf8; color: #04293a; font-weight: 800; padding: 10px 18px; border-radius: 12px; text-decoration: none; }
</style>
