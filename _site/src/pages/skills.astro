---
import Layout from '../layouts/Layout.astro';
import SkillCard from '../components/SkillCard.astro';
import { loadGeneratedSkills, SKILL_AREAS, type GeneratedSkill } from '../lib/skills-generated';

const skills = loadGeneratedSkills();

// 대표 카드 = usedBy ≥ 5 중 최다 1개
const sortedByUsed = [...skills].sort((a, b) => b.usedBy - a.usedBy);
const featured = sortedByUsed.find((s) => s.usedBy >= 5) ?? null;
const rest = featured ? skills.filter((s) => s.slug !== featured.slug) : skills;

// 3단 위계 — 많이 써본(5+)/떠오르는(2-4)/새로 들어온(1)
const tierDefs = [
  { key: 'hot',  title: '많이 써본 스킬',   eyebrow: '5명 이상',   test: (s: GeneratedSkill) => s.usedBy >= 5 },
  { key: 'mid',  title: '떠오르는 스킬',     eyebrow: '2~4명 사용', test: (s: GeneratedSkill) => s.usedBy >= 2 && s.usedBy < 5 },
  { key: 'base', title: '새로 들어온 스킬',  eyebrow: '1명 사용',   test: (s: GeneratedSkill) => s.usedBy < 2 },
] as const;
const groups = tierDefs
  .map((t) => ({ ...t, items: rest.filter(t.test) }))
  .filter((g) => g.items.length > 0);

// 분야 칩 카운트
const fieldCounts: Record<string, number> = { 전체: skills.length };
SKILL_AREAS.forEach((f) => { fieldCounts[f] = skills.filter((s) => s.area === f).length; });

// 후기를 남긴 사람 수
const people = new Set<string>();
skills.forEach((s) => s.quotes.forEach((q) => people.add(q.author)));
const totalUsers = people.size;

// 칩 활성/비활성 클래스 (JS 토글과 동일 문자열 — Tailwind 스캔용으로 여기에도 명시)
const chipBase = 'sk-chip2 text-[12.5px] px-3 py-1.5 rounded-full border tracking-[-0.01em] transition-all font-normal';
const chipActive = 'bg-[#1A1A1A] border-[#1A1A1A] text-white';
const chipInactive = 'bg-transparent border-[#ECE7DC] text-[#4D4D4D] hover:border-[#DDD6C5] hover:text-[#1A1A1A]';
---

<Layout title="스킬 & 인사이트 — 스폰지클럽" bodyClass="sk-body">
  <!-- ─── HEADER (스폰지클럽 공통 틀) ─────────────────── -->
  <header class="sk-header">
    <div class="sk-header-inner">
      <a href="/" class="sk-brand">
        <span class="sk-brand-mark">🧽</span>
        <span class="sk-brand-name">spongeclub</span>
        <span class="sk-brand-sep">/</span>
        <span class="sk-brand-sub">스킬 &amp; 인사이트</span>
      </a>
      <nav class="sk-nav" aria-label="메인 메뉴">
        <a href="/skills/" class="active">스킬&인사이트</a>
        <a href="/gallery/">갤러리</a>
        <a href="/members/">크루</a>
        <a href="/archive/">주차별 아카이브</a>
      </nav>
    </div>
  </header>

  <!-- ─── MAIN (web 최신 카드 디자인) ─────────────────── -->
  <div class="flex-1 bg-[#FFFDF7]">
    <div class="max-w-[1200px] mx-auto px-8 pt-10 pb-32">

      <!-- HERO -->
      <section class="mb-7 max-w-[760px]">
        <h1 class="text-[clamp(34px,4.4vw,48px)] leading-[1.1] tracking-[-0.01em] font-normal [font-family:var(--sc-font-display)] m-0 mb-3.5 text-[#1A1A1A]">
          멤버들이 직접 써본{' '}
          <em class="not-italic px-1 bg-[linear-gradient(180deg,transparent_62%,#FFF3D0_62%)]">스킬</em>만 모았어요
        </h1>
        <p class="text-[17px] text-[#4D4D4D] max-w-[56ch] m-0 mb-5 tracking-[-0.01em]">
          실제 일에 적용해보고 후기까지 남긴 스킬을 큐레이션합니다. 궁금한 카드를 펼쳐서 누가 어떻게 썼는지 살펴보세요.
        </p>
        <div class="flex items-center gap-3.5 flex-wrap text-[13px] text-[#888888]">
          <span><b class="text-[#1A1A1A] font-semibold">{skills.length}</b>개의 스킬</span>
          <span class="w-[3px] h-[3px] rounded-full bg-[#DDD6C5] inline-block"></span>
          <span><b class="text-[#1A1A1A] font-semibold">{totalUsers}</b>명의 멤버가 후기 작성</span>
          <span class="w-[3px] h-[3px] rounded-full bg-[#DDD6C5] inline-block"></span>
          <span>표시 중 <b id="sk-visible" class="text-[#1A1A1A] font-semibold">{skills.length}</b>개</span>
        </div>
      </section>

      <!-- FILTER BAR (sticky, 헤더 높이 60px 아래) -->
      <div class="sticky top-[60px] z-20 -mx-8 mb-7 px-8 py-3.5 bg-[rgba(255,253,247,0.85)] backdrop-blur-[14px] backdrop-saturate-[160%] border-b border-[#ECE7DC] flex gap-4 items-center flex-wrap">
        <div class="flex items-center gap-2 px-3 py-2 bg-white border border-[#ECE7DC] rounded-[10px] min-w-[260px] focus-within:border-[#1A1A1A] text-[#888888] focus-within:text-[#1A1A1A]">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="7" cy="7" r="5" /><path d="M14 14l-3-3" />
          </svg>
          <input
            type="text"
            id="sk-search"
            placeholder="스킬 이름이나 키워드로 검색"
            autocomplete="off"
            class="flex-1 border-0 outline-none bg-transparent text-[14px] text-[#1A1A1A] placeholder:text-[#888888] min-w-0"
          />
          <button type="button" id="sk-search-clear" aria-label="지우기" hidden
            class="appearance-none border-0 bg-transparent cursor-pointer text-[#888888] text-[12px] p-1 hover:text-[#1A1A1A]">✕</button>
        </div>
        <div class="flex gap-1.5 flex-wrap" id="sk-chips">
          <button type="button" data-field="전체" class={`${chipBase} ${chipActive}`}>전체 {fieldCounts['전체']}</button>
          {SKILL_AREAS.map((f) => (
            <button type="button" data-field={f} class={`${chipBase} ${chipInactive}`}>{f} {fieldCounts[f]}</button>
          ))}
        </div>
      </div>

      <!-- 대표 카드 -->
      {featured && (
        <section class="mb-9 pt-2" data-skill-section="featured">
          <SkillCard skill={featured} variant="featured" />
        </section>
      )}

      <!-- 3단 위계 섹션 -->
      <main class="flex flex-col gap-10">
        {groups.map((g) => (
          <section data-skill-section={g.key}>
            <div class="flex items-baseline justify-between mx-1 mb-3.5 pb-2.5 border-b border-[#ECE7DC]">
              <div class="flex flex-col gap-0.5">
                <div class="text-[11px] text-[#D98E0E] uppercase tracking-[0.08em] font-semibold">{g.eyebrow}</div>
                <h2 class="text-[18px] tracking-[-0.018em] font-bold m-0 text-[#1A1A1A]">{g.title}</h2>
              </div>
              <div class="text-[12.5px] text-[#888888] tabular-nums" data-section-count>{g.items.length}</div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 items-stretch">
              {g.items.map((sk) => (
                <SkillCard skill={sk} variant="compact" tier={g.key} />
              ))}
            </div>
          </section>
        ))}

        <div id="sk-empty" hidden
          class="text-center py-14 px-5 text-[#888888] text-sm border border-dashed border-[#ECE7DC] rounded-[14px]">
          검색 결과가 없어요. 다른 키워드를 시도해 보세요.
        </div>
      </main>

      <!-- 범례 -->
      <div class="mt-14 flex gap-[18px] flex-wrap text-xs text-[#888888] pt-5 border-t border-[#ECE7DC]">
        <span class="inline-flex items-center gap-1.5">
          <span class="w-3.5 h-3.5 rounded-[4px] border border-[#F5A623] bg-[#F5A623]"></span>
          5명 이상 — 커뮤니티 추천
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="w-3.5 h-3.5 rounded-[4px] border border-[#ECDFC0] bg-[#FFFBEF]"></span>
          2~4명 사용
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="w-3.5 h-3.5 rounded-[4px] border border-[#ECE7DC] bg-white"></span>
          1명 사용
        </span>
      </div>

      <footer class="sk-footer">
        스폰지클럽 1기 · 스킬 &amp; 인사이트 · 데굴데굴 큐레이션
      </footer>
    </div>
  </div>
</Layout>

<script is:inline>
  (function () {
    var ACTIVE = 'bg-[#1A1A1A] border-[#1A1A1A] text-white';
    var INACTIVE = 'bg-transparent border-[#ECE7DC] text-[#4D4D4D] hover:border-[#DDD6C5] hover:text-[#1A1A1A]';

    var activeField = '전체';
    var query = '';
    var cards = Array.prototype.slice.call(document.querySelectorAll('article.sk-card2'));
    var sections = Array.prototype.slice.call(document.querySelectorAll('[data-skill-section]'));
    var chips = Array.prototype.slice.call(document.querySelectorAll('#sk-chips [data-field]'));
    var visibleEl = document.getElementById('sk-visible');
    var emptyEl = document.getElementById('sk-empty');
    var searchEl = document.getElementById('sk-search');
    var clearEl = document.getElementById('sk-search-clear');

    function tokens(q) {
      return q.toLowerCase().split(/\s+/).filter(function (t) { return t.length > 0; });
    }

    function apply() {
      var qTokens = tokens(query);
      var n = 0;
      cards.forEach(function (card) {
        var area = card.getAttribute('data-area') || '';
        var hay = card.getAttribute('data-search') || '';
        var queryMatch = qTokens.length === 0 || qTokens.every(function (t) { return hay.indexOf(t) !== -1; });
        var pass = (activeField === '전체' || area === activeField) && queryMatch;
        card.hidden = !pass;
        if (pass) n++;
      });
      // 카드가 하나도 안 보이는 섹션은 숨김
      sections.forEach(function (sec) {
        var anyVisible = Array.prototype.slice
          .call(sec.querySelectorAll('article.sk-card2'))
          .some(function (c) { return !c.hidden; });
        sec.hidden = !anyVisible;
      });
      if (visibleEl) visibleEl.textContent = String(n);
      if (emptyEl) emptyEl.hidden = n !== 0;
      if (clearEl) clearEl.hidden = query.length === 0;
    }

    // 분야 칩 필터
    chips.forEach(function (btn) {
      btn.addEventListener('click', function () {
        activeField = btn.getAttribute('data-field') || '전체';
        chips.forEach(function (b) {
          var on = b.getAttribute('data-field') === activeField;
          b.classList.remove.apply(b.classList, ACTIVE.split(' '));
          b.classList.remove.apply(b.classList, INACTIVE.split(' '));
          b.classList.add.apply(b.classList, (on ? ACTIVE : INACTIVE).split(' '));
        });
        apply();
      });
    });

    // 검색 (IME 한글 입력 대응)
    if (searchEl) {
      var composing = false;
      searchEl.addEventListener('compositionstart', function () { composing = true; });
      searchEl.addEventListener('compositionend', function () {
        composing = false; query = searchEl.value; apply();
      });
      searchEl.addEventListener('input', function () {
        if (composing) return; query = searchEl.value; apply();
      });
      searchEl.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && searchEl.value) {
          searchEl.value = ''; query = ''; apply(); e.preventDefault();
        }
      });
    }
    if (clearEl) {
      clearEl.addEventListener('click', function () {
        if (!searchEl) return;
        searchEl.value = ''; query = ''; searchEl.focus(); apply();
      });
    }

    // 카드 펼치기/접기
    function toggle(card) {
      var open = card.getAttribute('aria-expanded') === 'true';
      card.setAttribute('aria-expanded', open ? 'false' : 'true');
    }
    cards.forEach(function (card) {
      card.addEventListener('click', function (e) {
        var t = e.target;
        while (t && t !== card) {
          if (t.tagName === 'A' || t.tagName === 'BUTTON') return;
          t = t.parentNode;
        }
        toggle(card);
      });
      card.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(card); }
      });
    });
  })();
</script>

<style is:global>
  /* ─── 스폰지클럽 공통 틀 (헤더/바디 베이스) ─── */
  body.sk-body {
    margin: 0;
    min-height: 100vh;
    background: var(--sc-bg-base);
    color: var(--sc-text-primary);
    font-family: var(--sc-font-body);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.005em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    display: flex;
    flex-direction: column;
  }
  body.sk-body * { box-sizing: border-box; }

  /* HEADER */
  .sk-header {
    position: sticky; top: 0; z-index: 30;
    background: var(--sc-bg-base);
    border-bottom: 1px solid var(--sc-border-soft);
  }
  .sk-header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    height: 60px;
    display: flex; align-items: center; gap: 24px;
  }
  .sk-brand { display: inline-flex; align-items: baseline; gap: 8px; flex-shrink: 0; }
  .sk-brand-mark { font-size: 20px; line-height: 1; }
  .sk-brand-name {
    font-family: var(--sc-font-display);
    font-weight: 400; font-size: 22px; letter-spacing: -0.01em;
    color: var(--sc-text-primary);
  }
  .sk-brand-sep { color: var(--sc-text-muted-low); }
  .sk-brand-sub { font-size: 13px; color: var(--sc-text-muted-high); font-weight: 500; }
  .sk-nav {
    display: flex; align-items: center; gap: 20px;
    margin-left: auto; font-size: 14px; font-weight: 500;
  }
  .sk-nav a { color: var(--sc-text-muted-mid); transition: color 160ms; text-decoration: none; }
  .sk-nav a:hover { color: var(--sc-text-primary); }
  .sk-nav a.active { color: var(--sc-text-primary); font-weight: 700; }
  .sk-ext {
    font-size: 13px; font-weight: 500;
    padding: 8px 14px; border-radius: var(--sc-radius-pill);
    background: var(--sc-bg-signature); color: var(--sc-text-primary);
    flex-shrink: 0; transition: filter 160ms; text-decoration: none;
  }
  .sk-ext:hover { filter: brightness(0.96); }
  @media (max-width: 820px) {
    .sk-nav { gap: 14px; font-size: 13px; }
    .sk-brand-sep, .sk-brand-sub { display: none; }
  }
  @media (max-width: 640px) {
    .sk-header-inner { gap: 12px; }
    .sk-ext { display: none; }
  }

  /* FOOTER */
  .sk-footer {
    text-align: center;
    font-size: 12px;
    color: var(--sc-text-muted-low);
    padding: 40px 0 0;
  }

  /* ─── 카드 펼침 상태 (web 디자인) ─── */
  .sk-card2 .sk-detail { display: none; }
  .sk-card2[aria-expanded="true"] .sk-detail { display: block; }
  .sk-card2[aria-expanded="true"] .sk-chev { transform: rotate(180deg); color: #1A1A1A; }
  /* 펼치면 그리드 한 줄 전체 차지 */
  .sk-card2[aria-expanded="true"] { grid-column: 1 / -1; box-shadow: 0 8px 32px -18px rgba(40,30,10,0.28); }
  .sk-card2[aria-expanded="true"] { border-color: #1A1A1A; }
  .sk-card2[data-tier="hot"][aria-expanded="true"] { border-color: #F5A623; }

  /* ─── 펼침 영역 마크다운(주요 내용) ─── */
  .sk-md p { margin: 0 0 8px; }
  .sk-md p:last-child { margin-bottom: 0; }
  .sk-md ul { list-style: disc; padding-left: 1.25rem; margin: 4px 0 8px; }
  .sk-md ol { list-style: decimal; padding-left: 1.25rem; margin: 4px 0 8px; }
  .sk-md li { margin: 2px 0; }
  .sk-md strong { font-weight: 600; color: #1A1A1A; }
  .sk-md a { color: #D98E0E; text-decoration: underline; text-underline-offset: 2px; }
  .sk-md code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    background: #FFF4D6; padding: 1px 5px; border-radius: 4px; font-size: 13px;
  }
  .sk-md pre {
    background: #1A1A1A; color: rgba(255,251,237,0.94);
    padding: 12px 14px; border-radius: 8px; overflow-x: auto;
    font-size: 12px; line-height: 1.55; margin: 8px 0;
  }
  .sk-md pre code { background: transparent; padding: 0; color: inherit; }
  .sk-md blockquote {
    border-left: 3px solid #F5A623; background: #FFF9EE;
    padding: 6px 12px; margin: 8px 0; border-radius: 0 6px 6px 0;
  }

  /* A11Y */
  body.sk-body a:focus-visible,
  body.sk-body button:focus-visible,
  body.sk-body article:focus-visible {
    outline: 3px solid var(--sc-accent-blue);
    outline-offset: 2px;
    border-radius: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sk-card2, .sk-chip2, .sk-chev { transition: none !important; }
  }
</style>
