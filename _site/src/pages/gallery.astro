---
import Layout from '../layouts/Layout.astro';
import CohortTabs from '../components/CohortTabs.astro';
import { loadGallery } from '../lib/gallery';
import s2 from '../data/season2.json';

// 결과물 허브 — 전 기수 산출물을 한곳에. 시즌은 [전체·2기·1기] 필터.
// 1기 = 실데이터(loadGallery), 2기 = season2.json 조별 MVP에서 빌드한 예시(isSample).
const { items: rawS1 } = loadGallery();
const season1Items = rawS1.map((i) => ({ ...i, season: '1기' }));

const season2Items = (s2.teams ?? [])
  .filter((t) => t.mvp)
  .map((t) => ({
    title: t.mvp!.name, member: t.mvp!.name, team: t.team, week: 1,
    category: t.mvp!.kw || '2기', description: t.mvp!.tagline, descriptionShort: t.mvp!.tagline,
    url: '', notePath: '', mvp: true, insights: [] as string[], techStack: [] as string[],
    season: '2기',
  }));

// 모달 조회용 전체 목록 (2기 최신 먼저 → 1기). 카드의 data-idx 는 이 배열 기준.
const items = [...season2Items, ...season1Items];
const idxOf = new Map(items.map((it, i) => [it, i]));

// 기수별 패널 — 1기 누르면 1기 전체, 2기 누르면 2기 전체. 시즌 혼합("전체") 없음.
const cohortViews = [
  { id: '1', label: '1기', items: season1Items },
  { id: '2', label: '2기', items: season2Items },
];

// 기수 탭 (아카이브 표준 디자인 공유)
const cohortTabs = [
  { id: '1', label: '1기', meta: `${season1Items.length}개` },
  { id: '2', label: '2기', meta: '준비중' },
];
---

<Layout title="갤러리 — 스폰지클럽" bodyClass="sc-page">
  <header class="sc-header">
    <div class="sc-header-inner">
      <a href="/" class="sc-brand">
        <span class="sc-brand-mark">🧽</span>
        <span class="sc-brand-name">spongeclub</span>
        <span class="sc-brand-sep">/</span>
        <span class="sc-brand-sub">결과물</span>
      </a>
      <nav class="sc-nav" aria-label="메인 메뉴">
        <a href="/skills/">스킬&인사이트</a>
        <a href="/gallery/" class="active">갤러리</a>
        <a href="/members/">크루</a>
        <a href="/archive/">주차별 아카이브</a>
      </nav>
    </div>
  </header>

  <main class="sc-main">
    <section class="sc-title-section">
      <p class="sc-kicker">전 기수 산출물</p>
      <h1 class="sc-h1">
        결과물
      </h1>
      <p class="sc-lede">
        스폰지클럽이 만든 <span class="sc-highlight">{season1Items.length}개 산출물</span><br />
        클릭하면 기술 스택·핵심 기능까지 볼 수 있어요.
      </p>
      <CohortTabs cohorts={cohortTabs} defaultId="1" />
    </section>

    <div class="arc-cohort-panels">
    {cohortViews.map((cv) => {
      const cats = [...new Set(cv.items.map((i) => i.category))];
      return (
        <div
          id={`arc-cohort-${cv.id}`}
          class="arc-cohort-panel"
          data-cohort-panel={cv.id}
          role="tabpanel"
          aria-label={`${cv.label} 결과물`}
          hidden={cv.id !== '1'}
        >
          {cv.id === '2' ? (
            <div class="cohort-empty">
              <div class="cohort-empty-emoji" aria-hidden="true">🧽🚧</div>
              <h2 class="cohort-empty-title">2기 갤러리는 아직 굽는 중!</h2>
              <p class="cohort-empty-desc">
                2기 빌더들이 곧 따끈한 산출물로 이 자리를 채울 예정이에요.<br />
                그동안 <button class="cohort-empty-link" data-cohort-tab="1" type="button">1기 갤러리</button>의 멋진 결과물을 먼저 구경해보세요 👀
              </p>
            </div>
          ) : (
          <div class="gl-listing">
            <div class="gl-controls">
              {cv.id === '1' ? (
                <div class="gl-tabs">
                  <button class="gl-tab" data-cat="all" data-active="true">
                    <span>전체</span>
                    <span class="gl-tab-count">{cv.items.length}</span>
                  </button>
                  {cats.map((cat) => (
                    <button class="gl-tab" data-cat={cat} data-active="false">
                      <span>{cat}</span>
                      <span class="gl-tab-count">{cv.items.filter((i) => i.category === cat).length}</span>
                    </button>
                  ))}
                </div>
              ) : (
                <div class="gl-tabs" />
              )}
              <div class="gl-sort">
                <span class="gl-sort-label">정렬</span>
                <button class="gl-sort-btn" data-sort="name" data-active="false" data-dir="asc">
                  가나다<span class="gl-sort-arrow" aria-hidden="true">↑</span>
                </button>
              </div>
            </div>

            <div class="gl-filter-row">
              <div class="gl-search">
                <span class="gl-search-icon" aria-hidden="true">🔍</span>
                <input type="search" class="gl-search-input" placeholder="멤버 검색" aria-label="멤버 이름으로 검색" autocomplete="off" />
              </div>
            </div>

            <div class="gl-grid">
              {cv.items.map((item) => (
                <article
                  class="gl-card"
                  data-cat={item.category}
                  data-idx={idxOf.get(item)}
                  data-title={item.title}
                  data-member={item.member}
                  data-team={item.team}
                  data-mvp={item.mvp ? 'true' : 'false'}
                  data-season={item.season}
                  role="button"
                  tabindex="0"
                  aria-haspopup="dialog"
                  aria-label={`${item.title} 상세 보기`}
                >
                  <div class="gl-card-thumb">
                    {item.images?.[0]
                      ? <img src={item.images[0]} alt={`${item.title} 미리보기`} loading="lazy" />
                      : <span class="gl-card-thumb-ph">{item.title}</span>}
                  </div>
                  <header class="gl-card-head">
                    <span class:list={['gl-season-badge', item.season === '2기' ? 'gl-season-badge--s2' : 'gl-season-badge--s1']}>{item.season}</span>
                    <span class="gl-card-cat">{item.category}</span>
                  </header>
                  <h3 class="gl-card-title">{item.title}</h3>
                  <p class="gl-card-desc">{item.descriptionShort || item.description}</p>
                  <footer class="gl-card-foot">
                    <span class="gl-card-by"><b>{item.member}</b> · {item.team}</span>
                    <span class="gl-card-more">자세히 →</span>
                  </footer>
                </article>
              ))}
            </div>
            <div class="gl-empty" hidden>
              <p>이 필터에는 아직 산출물이 없어요.</p>
              <button class="gl-empty-reset" type="button">전체 보기</button>
            </div>
          </div>
          )}
        </div>
      );
    })}
    </div>

    <a href="/" class="sc-back">← 홈으로</a>
  </main>

  <!-- ─── MODAL ─── -->
  <div class="gl-modal-overlay" id="glModal" role="dialog" aria-modal="true" aria-labelledby="glModalTitle" hidden>
    <div class="gl-modal">
      <button class="gl-modal-close" id="glModalClose" aria-label="닫기">×</button>
      <div class="gl-modal-body">
        <div class="gl-modal-chips" id="glModalChips"></div>
        <h2 class="gl-modal-title" id="glModalTitle"></h2>
        <p class="gl-modal-by" id="glModalBy"></p>
        <div class="gl-modal-thumbs" id="glModalThumbs" hidden></div>
        <blockquote class="gl-modal-highlight" id="glModalHighlight" hidden></blockquote>

        <p class="gl-modal-desc" id="glModalDesc"></p>

        <!-- Before / After -->
        <div class="gl-modal-ba" id="glModalBA" hidden>
          <div class="gl-modal-ba-col gl-modal-ba--before">
            <div class="gl-modal-ba-label">Before</div>
            <div class="gl-modal-ba-text" id="glModalBefore"></div>
          </div>
          <div class="gl-modal-ba-col gl-modal-ba--after">
            <div class="gl-modal-ba-label">After</div>
            <div class="gl-modal-ba-text" id="glModalAfter"></div>
          </div>
        </div>

        <!-- 이모지 기능 리스트 -->
        <div class="gl-modal-feat-simple" id="glModalFeatSimple" hidden></div>

        <!-- 삽질 & 인사이트 (접이식) -->
        <details class="gl-modal-details" id="glModalInsightDetails">
          <summary class="gl-modal-details-summary">삽질 &amp; 인사이트</summary>
          <ul class="gl-modal-insights" id="glModalInsights"></ul>
        </details>

        <!-- Tech Stack (접이식) -->
        <details class="gl-modal-details" id="glModalTechDetails">
          <summary class="gl-modal-details-summary">이렇게 만들었어요</summary>
          <div class="gl-modal-tech" id="glModalTech"></div>
        </details>
        <div class="gl-modal-cta" id="glModalCta"></div>
      </div>
    </div>
  </div>

  <footer class="sc-footer">
    스폰지클럽 · 큐레이션 {items.length}개
  </footer>
</Layout>

<script is:inline define:vars={{ itemsData: items }}>
  (function () {
    // ── 기수 패널별 필터 + 정렬 (각 패널 독립: 카테고리 · MVP · 정렬) ──
    document.querySelectorAll('[data-cohort-panel]').forEach((panel) => {
      const tabs = panel.querySelectorAll('.gl-tab');
      const panelCards = panel.querySelectorAll('.gl-card');
      const grid = panel.querySelector('.gl-grid');
      if (!grid) return; // 준비중(빈 상태) 패널은 건너뜀
      const sortBtns = panel.querySelectorAll('.gl-sort-btn');
      const searchEl = panel.querySelector('.gl-search-input');
      const emptyEl = panel.querySelector('.gl-empty');

      let currentCat = 'all';
      let query = '';

      function applyFilter() {
        const q = query.trim().toLowerCase();
        let visible = 0;
        panelCards.forEach(c => {
          const catOk = currentCat === 'all' || c.getAttribute('data-cat') === currentCat;
          const searchOk = !q
            || (c.getAttribute('data-member') || '').toLowerCase().includes(q)
            || (c.getAttribute('data-team') || '').toLowerCase().includes(q)
            || (c.getAttribute('data-title') || '').toLowerCase().includes(q);
          const show = catOk && searchOk;
          c.hidden = !show;
          if (show) visible++;
        });
        if (emptyEl) emptyEl.hidden = visible !== 0;
      }

      const emptyReset = panel.querySelector('.gl-empty-reset');
      if (emptyReset) emptyReset.addEventListener('click', () => {
        currentCat = 'all'; query = '';
        if (searchEl) searchEl.value = '';
        tabs.forEach(t => t.setAttribute('data-active', t.getAttribute('data-cat') === 'all' ? 'true' : 'false'));
        applyFilter();
      });

      // 멤버 검색 (이름·조·산출물명 부분일치)
      if (searchEl) {
        searchEl.addEventListener('input', () => {
          query = searchEl.value;
          applyFilter();
        });
      }

      function applySort(key, dir) {
        const arr = Array.from(grid.querySelectorAll('.gl-card'));
        if (key === 'random') {
          for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            const tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
          }
          arr.forEach(c => grid.appendChild(c));
          return;
        }
        arr.sort((a, b) => {
          const ai = Number(a.getAttribute('data-idx'));
          const bi = Number(b.getAttribute('data-idx'));
          if (key === 'name') {
            const an = a.getAttribute('data-title') || '';
            const bn = b.getAttribute('data-title') || '';
            const cmp = an.localeCompare(bn, 'ko');
            return dir === 'asc' ? cmp : -cmp;
          }
          return ai - bi;
        });
        arr.forEach(c => grid.appendChild(c));
      }

      // 카테고리 탭
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.setAttribute('data-active', 'false'));
          tab.setAttribute('data-active', 'true');
          currentCat = tab.getAttribute('data-cat');
          applyFilter();
        });
      });

      // MVP만 모아보기
      if (mvpOnlyEl) {
        mvpOnlyEl.addEventListener('change', () => {
          mvpOnly = mvpOnlyEl.checked;
          applyFilter();
        });
      }

      // 정렬 (기준 + 방향 토글)
      sortBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-sort');
          // 이미 활성인 기준을 다시 누르면 방향 토글
          if (btn.getAttribute('data-active') === 'true') {
            const next = btn.getAttribute('data-dir') === 'asc' ? 'desc' : 'asc';
            btn.setAttribute('data-dir', next);
            const arrow = btn.querySelector('.gl-sort-arrow');
            if (arrow) arrow.textContent = next === 'asc' ? '↑' : '↓';
          }
          sortBtns.forEach(b => b.setAttribute('data-active', 'false'));
          btn.setAttribute('data-active', 'true');
          applySort(key, btn.getAttribute('data-dir'));
        });
      });

      // 초기 정렬: 랜덤
      applySort('random');
    });

    // 모달 바인딩용 전체 카드 (양 패널 합산)
    const cards = document.querySelectorAll('.gl-card');

    // 모달
    const modal = document.getElementById('glModal');
    const closeBtn = document.getElementById('glModalClose');
    const titleEl = document.getElementById('glModalTitle');
    const byEl = document.getElementById('glModalBy');
    const chipsEl = document.getElementById('glModalChips');
    const highlightEl = document.getElementById('glModalHighlight');
    const descEl = document.getElementById('glModalDesc');
    const techEl = document.getElementById('glModalTech');
    const ctaEl = document.getElementById('glModalCta');

    function openModal(idx) {
      const it = itemsData[idx];
      if (!it) return;
      titleEl.textContent = it.title;
      byEl.innerHTML = `<b>${it.member}</b> · ${it.team}`;
      chipsEl.innerHTML =
        `<span class="gl-modal-chip gl-modal-chip--cat">${it.category}</span>`;
      if (it.highlight) {
        highlightEl.textContent = it.highlight;
        highlightEl.hidden = false;
      } else {
        highlightEl.hidden = true;
      }
      descEl.textContent = it.description;

      // 미리보기 이미지 (여러 장 모두 표시)
      var thumbsEl = document.getElementById('glModalThumbs');
      var imgs = Array.isArray(it.images) ? it.images : (it.thumbnail ? [it.thumbnail] : []);
      if (imgs.length) {
        thumbsEl.innerHTML = imgs.map(function(src, i) {
          return '<img class="gl-modal-thumb" src="' + src + '" alt="' + it.title + ' 미리보기 ' + (i + 1) + '" />';
        }).join('');
        thumbsEl.hidden = false;
      } else {
        thumbsEl.innerHTML = '';
        thumbsEl.hidden = true;
      }

      // Before / After
      var baEl = document.getElementById('glModalBA');
      var beforeEl = document.getElementById('glModalBefore');
      var afterEl = document.getElementById('glModalAfter');
      if (it.before && it.after) {
        beforeEl.textContent = it.before;
        afterEl.textContent = it.after;
        baEl.hidden = false;
      } else {
        baEl.hidden = true;
      }

      // 주요 기능 리스트 (이모지 버전 우선, 없으면 일반 기능 폴백)
      var featSimpleEl = document.getElementById('glModalFeatSimple');
      if (Array.isArray(it.featuresSimple) && it.featuresSimple.length) {
        featSimpleEl.innerHTML = it.featuresSimple.map(function(f) {
          return '<div class="gl-modal-feat-item"><span class="gl-modal-feat-emoji">' + f.emoji + '</span><span>' + f.text + '</span></div>';
        }).join('');
        featSimpleEl.hidden = false;
      } else if (Array.isArray(it.features) && it.features.length) {
        featSimpleEl.innerHTML = it.features.map(function(f) {
          return '<div class="gl-modal-feat-item"><span class="gl-modal-feat-emoji">•</span><span>' + f + '</span></div>';
        }).join('');
        featSimpleEl.hidden = false;
      } else {
        featSimpleEl.hidden = true;
      }

      // 삽질 & 인사이트 (접이식)
      var insightDetails = document.getElementById('glModalInsightDetails');
      var insightsEl = document.getElementById('glModalInsights');
      if (Array.isArray(it.insights) && it.insights.length) {
        insightsEl.innerHTML = it.insights.map(function(s) { return '<li>' + s + '</li>'; }).join('');
        insightDetails.hidden = false;
        insightDetails.removeAttribute('open');
      } else {
        insightDetails.hidden = true;
      }

      // Tech Stack (접이식)
      var techDetails = document.getElementById('glModalTechDetails');
      if (Array.isArray(it.techStack) && it.techStack.length) {
        techEl.innerHTML = it.techStack.map(t => `<span class="gl-modal-tech-tag">${t}</span>`).join('');
        techDetails.hidden = false;
        techDetails.removeAttribute('open');
      } else {
        techDetails.hidden = true;
      }
      ctaEl.innerHTML = it.url
        ? `<a class="gl-modal-cta-btn" href="${it.url}" target="_blank" rel="noopener noreferrer">사이트 방문 ↗</a>`
        : `<span class="gl-modal-no-url">로컬 운영 · 외부 링크 없음</span>`;

      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function closeModal() {
      modal.hidden = true;
      document.body.style.overflow = '';
    }

    cards.forEach(card => {
      const idx = Number(card.getAttribute('data-idx'));
      card.addEventListener('click', () => openModal(idx));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal(idx);
        }
      });
    });

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) closeModal(); });
    // 기수(1기/2기) 탭 전환은 공유 CohortTabs 컴포넌트가 처리한다.
    // (2기 빈상태의 "1기 갤러리" 링크는 data-cohort-tab="1" 로 컴포넌트 핸들러에 연결됨)

    // 외부(회고 롤링 등)에서 ?item=<제목> 으로 들어오면 해당 카드 모달 자동 오픈
    try {
      const wanted = new URLSearchParams(location.search).get('item');
      if (wanted) {
        const target = Array.from(cards).find(c => c.getAttribute('data-title') === wanted);
        if (target) openModal(Number(target.getAttribute('data-idx')));
      }
    } catch (e) { /* noop */ }
  })();
</script>

<style is:global>
  /* 기수 탭(.arc-cohort-*)·준비중 빈상태(.cohort-empty*)는 global.css 공유 디자인 시스템 */

  /* 카드 시즌 뱃지 (헤더 인라인 칩) */
  .gl-season-badge {
    flex-shrink: 0;
    font-size: 10.5px; font-weight: 800; letter-spacing: 0.04em;
    padding: 3px 8px; border-radius: var(--sc-radius-pill); color: #fff;
  }
  .gl-season-badge--s1 { background: var(--sc-accent-blue); }
  .gl-season-badge--s2 { background: var(--sc-accent-red); }

  /* 빈 상태 */
  .gl-empty {
    text-align: center; padding: 48px 20px; color: var(--sc-text-muted-mid);
    display: flex; flex-direction: column; align-items: center; gap: 14px;
  }
  .gl-empty p { font-size: 15px; font-weight: 600; }
  button.gl-empty-reset {
    padding: 10px 20px; border-radius: var(--sc-radius-pill); border: none;
    background: var(--sc-bg-signature); color: var(--sc-text-primary);
    font-size: 13px; font-weight: 800; cursor: pointer;
  }

  /* tabs */
  .gl-controls {
    display: flex; flex-wrap: wrap; align-items: center;
    justify-content: space-between; gap: 12px;
  }
  .gl-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .gl-sort { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }
  .gl-sort-label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--sc-text-muted-mid);
    margin-right: 4px;
  }
  button.gl-sort-btn {
    display: inline-flex; align-items: center; gap: 3px;
    padding: 6px 11px;
    border-radius: var(--sc-radius-pill);
    border: 1px solid transparent;
    background: transparent;
    color: var(--sc-text-muted-mid);
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 140ms;
  }
  .gl-sort-btn:hover { color: var(--sc-text-primary); background: rgba(26,31,54,0.05); }
  .gl-sort-btn[data-active="true"] {
    background: var(--sc-bg-signature);
    color: var(--sc-text-primary);
    font-weight: 700;
  }
  .gl-sort-arrow {
    font-size: 11px; line-height: 1;
    opacity: 0.4;
    transition: opacity 140ms;
  }
  .gl-sort-btn[data-active="true"] .gl-sort-arrow { opacity: 1; }

  /* 필터·정렬·그리드 묶음 — 내부 간격 좁게 */
  .gl-listing {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* 필터 행 (멤버 검색) */
  .gl-filter-row {
    margin: 0;
    display: flex; flex-wrap: wrap; align-items: center;
    justify-content: flex-start; gap: 12px;
  }

  /* 멤버 검색 */
  .gl-search {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 12px;
