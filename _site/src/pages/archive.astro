---
import Layout from '../layouts/Layout.astro';
import CohortTabs from '../components/CohortTabs.astro';
import WeekRecords from '../components/WeekRecords.astro';
import { buildAllWeeks, buildWeekArticles, weekTheme } from '../lib/data';
import type { WeekData } from '../lib/data';

function weekStartTs(folderName: string): number {
  const m = folderName.match(/_(\d{4})$/);
  if (!m) return 0;
  const mm = parseInt(m[1].slice(0, 2), 10);
  const dd = parseInt(m[1].slice(2), 10);
  const year = new Date().getFullYear();
  return new Date(year, mm - 1, dd, 0, 0, 0).getTime();
}

const today = Date.now();
const allSubmitted = buildAllWeeks().filter((w) => w.submittedCount > 0);
// 아카이브는 메인 발행 게이트(publishedWeek)·MVP 선정 여부와 무관하게,
// 날짜가 지난(또는 날짜 미지정) 주차를 모두 노출한다. MVP 없는 주차도 보인다.
const weeks = allSubmitted.filter((w) => {
  const ts = weekStartTs(w.folderName);
  return ts === 0 || ts <= today;
});
const upcomingWeeks = allSubmitted.filter((w) => {
  const ts = weekStartTs(w.folderName);
  return ts !== 0 && ts > today;
});

const teamOrder = ['1조', '2조', '3조', '4조', '5조', '6조'];
function weekMvps(w: WeekData): string[] {
  return w.submissions
    .filter((s) => s.mvp && s.filePath && s.status === 'submitted')
    .sort((a, b) => teamOrder.indexOf(a.member.team) - teamOrder.indexOf(b.member.team))
    .map((s) => s.member.nickname);
}
const toIssue = (w: WeekData) => {
  const arts = buildWeekArticles(w);
  return { week: w, theme: weekTheme(arts), count: arts.length, mvps: weekMvps(w) };
};

// 기수 설정. launched=false 인 기수는 아직 공개 전 → 탭·패널 모두 숨긴다.
// (2기는 시즌2 시작 시 launched: true 로 전환)
const cohortConfigs = [
  { id: '1', label: '1기', startWeek: 0, endWeek: 6, launched: true },
  { id: '2', label: '2기', startWeek: 7, endWeek: null, launched: false },
] as const;
const visibleCohorts = cohortConfigs.filter((c) => c.launched);

const allPastIssues = [...weeks].reverse().map(toIssue);
const allUpcomingIssues = [...upcomingWeeks].reverse().map(toIssue);
const belongsToCohort = (
  issue: ReturnType<typeof toIssue>,
  cohort: (typeof cohortConfigs)[number]
) =>
  issue.week.weekNumber >= cohort.startWeek &&
  (cohort.endWeek == null || issue.week.weekNumber <= cohort.endWeek);
const cohortArchives = visibleCohorts.map((cohort) => ({
  cohort,
  pastIssues: allPastIssues.filter((issue) => belongsToCohort(issue, cohort)),
  upcomingIssues: allUpcomingIssues.filter((issue) => belongsToCohort(issue, cohort)),
}));
const defaultCohortId =
  [...cohortArchives].reverse().find(({ pastIssues }) => pastIssues.length > 0)?.cohort.id ??
  visibleCohorts[0]?.id ??
  cohortConfigs[0].id;
const cohortTabs = cohortArchives.map(({ cohort, pastIssues }) => ({
  id: cohort.id,
  label: cohort.label,
  meta: pastIssues.length > 0 ? `${pastIssues.length}호` : '준비중',
}));
const totalPublished = allPastIssues.filter((issue) =>
  visibleCohorts.some((c) => belongsToCohort(issue, c))
).length;
const padVol = (n: number) => String(n).padStart(2, '0');
---

<Layout title="주차별 아카이브 — 스폰지클럽" bodyClass="sc-page">
  <header class="sc-header">
    <div class="sc-header-inner">
      <a href="/season1/" class="sc-brand">
        <span class="sc-brand-mark">🧽</span>
        <span class="sc-brand-name">spongeclub</span>
        <span class="sc-brand-sep">/</span>
        <span class="sc-brand-sub">주차별 아카이브</span>
      </a>
      <nav class="sc-nav" aria-label="메인 메뉴">
        <a href="/skills/">스킬&인사이트</a>
        <a href="/gallery/">갤러리</a>
        <a href="/members/">크루</a>
        <a href="/archive/" class="active">주차별 아카이브</a>
      </nav>
    </div>
  </header>

  <main class="sc-main">
    <section class="sc-title-section">
      <p class="sc-kicker">지난 호 모아보기</p>
      <h1 class="sc-h1">
        주차별 아카이브
      </h1>
      <p class="sc-lede">
        최신 주차부터 아래로 쭉 이어집니다. 각 주차의 <b>개별 기록 펼쳐보기</b>를 누르면
        그 자리에서 조별 기록이 펼쳐져요 — 따로 들어가지 않아도 됩니다.
      </p>
      {cohortTabs.length > 1 && <CohortTabs cohorts={cohortTabs} defaultId={defaultCohortId} />}
    </section>

    <div class="arc-cohort-panels">
      {cohortArchives.map(({ cohort, pastIssues, upcomingIssues }) => (
        <section
          id={`arc-cohort-${cohort.id}`}
          class="arc-cohort-panel"
          role="tabpanel"
          aria-label={`${cohort.label} 기록`}
          data-cohort-panel={cohort.id}
          hidden={cohort.id !== defaultCohortId}
        >
          {pastIssues.length === 0 ? (
            <p class="arc-empty">{cohort.label} 기록은 아직 비어 있어요.</p>
          ) : (
            <div class="arc-weeks">
              {pastIssues.map(({ week, theme, count, mvps }) => (
                <article class="arc-week">
                  <header class="arc-week-head">
                    <span class="arc-week-vol">{cohort.label} · VOL.{padVol(week.weekNumber)}</span>
                    <h2 class="arc-week-title">
                      <span class="arc-week-num">{padVol(week.weekNumber)}</span>
                      <span>{theme || `${week.weekNumber}주차의 기록`}</span>
                    </h2>
                    {mvps.length > 0 && (
                      <span class="arc-week-tags">
                        <span class="arc-week-tags-label">MVP</span>
                        {mvps.slice(0, 3).map((n) => <span class="arc-week-tag">{n}</span>)}
                        {mvps.length > 3 && <span class="arc-week-tag arc-week-tag--more">+{mvps.length - 3}</span>}
                      </span>
                    )}
                    <span class="arc-week-meta">
                      {week.dateLabel ? `${week.dateLabel} · ` : ''}{count}개 기록{week.submittedCount ? ` · ${week.submittedCount}명 참여` : ''}
                    </span>
                  </header>
                  <WeekRecords week={week} />
                </article>
              ))}
            </div>
          )}

          {upcomingIssues.length > 0 && (
            <details class="arc-upcoming">
              <summary class="arc-upcoming-summary">
                준비 중인 주차 {upcomingIssues.length}개 — 아직 공개 전이라 접어뒀어요
                <span class="arc-upcoming-chevron" aria-hidden="true">▾</span>
              </summary>
              <div class="arc-upcoming-list">
                {upcomingIssues.map(({ week, theme }) => (
                  <div class="arc-upcoming-item">
                    <span class="arc-upcoming-vol">{cohort.label} · VOL.{padVol(week.weekNumber)}</span>
                    <span class="arc-upcoming-title">{theme || `${week.weekNumber}주차의 기록`}</span>
                    <span class="arc-upcoming-tag">준비 중</span>
                  </div>
                ))}
              </div>
            </details>
          )}
        </section>
      ))}
    </div>

    <a href="/season1/" class="sc-back">← 홈으로</a>

    <script is:inline>
      {
        const avatars = Array.from(document.querySelectorAll('.iss-person-comment-avatar[data-comment-images]'));
        if (avatars.length > 0) {
          try {
            const images = JSON.parse(avatars[0].getAttribute('data-comment-images') || '[]');
            if (Array.isArray(images) && images.length > 1) {
              const shuffled = [...images].sort(() => Math.random() - 0.5);
              avatars.forEach((img) => {
                img.src = shuffled[avatars.indexOf(img) % shuffled.length];
              });
            }
          } catch {
            // Keep the static fallback image.
          }
        }
      }
    </script>
  </main>

  <footer class="sc-footer">
    스폰지클럽 · 발행 {totalPublished}호
  </footer>
</Layout>

<style>
  /* 페이지 제목 — 기본 sc-h1보다 작게, 한 줄 유지 */
  .sc-h1 {
    font-size: clamp(30px, 4vw, 46px);
    white-space: nowrap;
  }
  .sc-lede b { font-weight: 700; color: var(--sc-text-primary); }
  /* 기수 탭/패널·빈상태(.arc-cohort-*, .arc-empty)는 global.css 공유 디자인 시스템 */

  /* 주차별 세로 스택 */
  .arc-weeks {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .arc-week {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 36px;
    border-top: 2px solid var(--sc-border-card);
  }
  .arc-week:first-child {
    padding-top: 0;
    border-top: none;
  }
  .arc-week-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .arc-week-vol {
    font-family: var(--sc-font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--sc-accent-red);
  }
  .arc-week-title {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--sc-text-primary);
    word-break: keep-all;
    overflow-wrap: anywhere;
    margin: 0;
  }
  .arc-week-num {
    font-size: 1.5em;
    line-height: 0.9;
    color: var(--sc-bg-signature);
    -webkit-text-stroke: 1.5px var(--sc-surface-dark);
    flex: none;
  }
  .arc-week-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px;
  }
  .arc-week-tags-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--sc-accent-blue);
    margin-right: 2px;
  }
  .arc-week-tag {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--sc-text-primary);
    background: rgba(255, 230, 122, 0.5);
    border: 1px solid rgba(26, 31, 54, 0.06);
    padding: 2px 8px;
    border-radius: var(--sc-radius-pill);
  }
  .arc-week-tag--more {
    background: transparent;
    border-color: transparent;
    color: var(--sc-text-muted-mid);
    font-weight: 700;
    padding-left: 2px;
  }
  .arc-week-meta {
    font-size: 13px;
    color: var(--sc-text-muted-mid);
    font-weight: 500;
  }

  /* 준비 중 주차 토글 */
  .arc-upcoming {
    margin-top: 44px;
    border-top: 1px dashed var(--sc-border-card);
    padding-top: 20px;
  }
  .arc-upcoming-summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: var(--sc-text-muted-mid);
    user-select: none;
  }
  .arc-upcoming-summary::-webkit-details-marker { display: none; }
  .arc-upcoming-summary:hover { color: var(--sc-text-primary); }
  .arc-upcoming-chevron { transition: transform 160ms; font-size: 11px; }
  .arc-upcoming[open] .arc-upcoming-chevron { transform: rotate(180deg); }
  .arc-upcoming-list {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .arc-upcoming-item {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: 12px 16px;
    border: 1px dashed var(--sc-border-card);
    border-radius: var(--sc-radius-card);
    opacity: 0.85;
  }
  .arc-upcoming-vol {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--sc-text-muted-mid);
  }
  .arc-upcoming-title {
    font-family: var(--sc-font-display);
    font-size: 18px;
    color: var(--sc-text-primary);
  }
  .arc-upcoming-tag {
    margin-left: auto;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: var(--sc-radius-pill);
    background: var(--sc-surface-dark);
    color: var(--sc-bg-signature);
  }
  @media (max-width: 760px) {
    .arc-week-title {
      font-size: clamp(24px, 7vw, 32px);
    }
  }
</style>
