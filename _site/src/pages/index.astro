    keywords: ['처방 아닌 가설', '커뮤니티 입구', '답변은 다음 연료'],
    lead: "하늘이 만든 건 '판매 제품'이 아니라 '커뮤니티 입구'. 이 한 줄을 정하니 나머지 결정이 전부 쉬워졌대.",
    paragraphs: [
      "사용자가 컨디션을 입력하면 영양제를 추천해주는데, '확정 처방'이 아니라 <b>'함께 볼 가설'</b>로 건네. 전문가가 검증 안 된 걸 단정하면 신뢰가 깨지니까 — 가장 오래 고민한 게 이 결과지 톤이었대.",
      '설계에서 영리한 한 수는 답변 저장. 처음엔 신청자 이메일만 저장했는데, 비유하면 문진 다 받고 차트엔 이름만 적고 문진표는 버리는 격이잖아. 앞으로 여러 AI를 엮어 확장하려면 그 답변 전체가 <b>연료</b>라는 판단으로, 답변을 통째로 저장하게 바꿨어.',
      "코드 들어가기 전에 'Why'와 장기 비전부터 Claude에 학습시키고, 브랜드 컨셉·질문지·진단 알고리즘을 채팅으로 미리 잡고 시작하니 구현이 훨씬 빨랐대. zapier·make·notion 연결은 처음이라 한 스텝마다 캡처해 물어가며 헤맸지만, 그 기술적 삽질을 견디는 게 중요하다는 걸 배웠다고.",
    ],
    diagram: {
      cap: '컨디션 입력 → 가설 추천 → 연료로 저장',
      nodes: [
        { label: '🩹 컨디션 입력' },
        { label: "💊 영양제 '가설' 추천", key: true },
        { label: '🗄 답변 전체 저장', sub: '다음 AI의 연료', key: true },
        { label: '🚪 커뮤니티 입구' },
      ],
      note: "'처방'이 아니라 '함께 볼 가설' — 신뢰가 먼저.",
    },
  },
};

// 카드 + 모달 렌더 데이터
const mvpCards = weeklyMvps.map((m) => {
  const d = mvpDetails[`${m.team}|${m.week}`] || {};
  const paragraphs = d.paragraphs && d.paragraphs.length
    ? d.paragraphs
    : (m.content ? [m.content] : (m.summary ? [m.summary] : []));
  return {
    team: m.team,
    name: m.nickname,
    tagline: m.summary || m.title,
    keywords: d.keywords || [],
    ready: !!(m.nickname && m.nickname !== '미정'),
    week: m.week,
    isPast: m.isPast,
    detail: {
      team: m.team,
      name: m.nickname,
      week: m.week,
      isPast: m.isPast,
      title: d.title || m.nickname,
      by: d.by || m.summary || '',
      lead: d.lead || '',
      keywords: d.keywords || [],
      paragraphs,
      diagram: d.diagram || null,
      url: m.url && m.url !== '#' ? m.url : '',
    },
  };
});

// 조별 마을 hotspot — 메인 hero에서는 이동 비활성 (이름만 표시)
const villageTeams = teamOrder.map((team) => ({ name: team }));

// 조별 분석 카드 — 90_analysis/teams/Week_0N_조M.md 에서 로드
const teamAnalyses = latest ? loadTeamAnalyses(latest.weekNumber) : [];
const teamCards = teamOrder.map((team) => {
  const a = teamAnalyses.find((x) => x.team === team);
  if (a) return { team, title: a.title, subtitle: a.subtitle, tagline: a.tagline, insight: a.insight };
  return {
    team,
    title: `${latest?.weekNumber ?? ''}주차의 기록`,
    subtitle: '',
    tagline: '아직 분석이 생성되지 않았습니다.',
    insight: '',
  };
});

const weekLabel = (n: number) => `WEEK ${String(n).padStart(2, '0')}`;
const year = new Date().getFullYear();

// 주차 선택 버튼 — 제출된 전 주차(0주차 OT 제외). 카드는 최신 호만 띄우고,
// 다른 주차를 누르면 그 호의 issue 페이지로 이동(페이지 전환). 현재 호는 active.
const weekNav = allSubmitted
  .filter((w) => w.weekNumber >= 1)
  .map((w) => ({
    weekNumber: w.weekNumber,
    href: `/issue/${w.weekNumber}/`,
    isCurrent: latest ? w.weekNumber === latest.weekNumber : false,
  }));

// 메인 아카이브 미리보기 — 최신 발행호 1장만 표지로. MVP 닉네임(조 순서)을 칩으로.
const latestIssue = pastIssues[0] ?? null;
const latestIssueMvps = latest
  ? latest.submissions
      .filter((s) => s.mvp && s.filePath && s.status === 'submitted')
      .sort((a, b) => teamOrder.indexOf(a.member.team) - teamOrder.indexOf(b.member.team))
      .map((s) => s.member.nickname)
  : [];
