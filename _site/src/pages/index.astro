<script>
  // MVP 카드 클릭 → 모달
  const dataEl = document.getElementById('mvpDetailsData');
  const overlay = document.getElementById('mvpOverlay');
  if (dataEl && overlay) {
    let data: any[] = [];
    try { data = JSON.parse(dataEl.textContent || '[]'); } catch (e) { data = []; }
    const closeBtn = document.getElementById('mvpModalClose');
    const chipsEl = document.getElementById('mvpModalChips');
    const titleEl = document.getElementById('mvpModalTitle');
    const byEl = document.getElementById('mvpModalBy');
    const leadWrap = document.getElementById('mvpModalLeadWrap');
    const leadEl = document.getElementById('mvpModalLead');
    const bodyEl = document.getElementById('mvpModalBody');
    const diagramEl = document.getElementById('mvpModalDiagram');
    const ctaEl = document.getElementById('mvpModalCta');

    function esc(s: string) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function openModal(idx: number) {
      const it = data[idx];
      if (!it || !chipsEl || !titleEl || !byEl || !bodyEl || !diagramEl || !ctaEl) return;
      let chips = `<span class="hp-mvp-modal-chip hp-mvp-modal-chip--team">${esc(it.team)} · ${esc(it.name)}</span>`;
      if (it.isPast && it.week) chips += `<span class="hp-mvp-modal-chip hp-mvp-modal-chip--key">${esc(String(it.week))}주차</span>`;
      (it.keywords || []).forEach((k: string) => {
        chips += `<span class="hp-mvp-modal-chip hp-mvp-modal-chip--key"># ${esc(k)}</span>`;
      });
      chipsEl.innerHTML = chips;
      titleEl.textContent = it.title || it.name;
      byEl.textContent = it.by || '';
      byEl.hidden = !it.by;
      if (leadWrap && leadEl) {
        if (it.lead) { leadEl.textContent = it.lead; leadWrap.hidden = false; }
        else { leadWrap.hidden = true; }
      }
      // 본문 — paragraphs 는 신뢰된 정적 콘텐츠(빌드 데이터)라 <b> 허용
      bodyEl.innerHTML = (it.paragraphs || []).map((p: string) => `<p>${p}</p>`).join('');
      // 도식화
      if (it.diagram && Array.isArray(it.diagram.nodes) && it.diagram.nodes.length) {
        const nodes = it.diagram.nodes.map((n: any, i: number) => {
          const cls = 'hp-mvp-node' + (n.key ? ' hp-mvp-node--key' : '');
          const sub = n.sub ? `<small>${esc(n.sub)}</small>` : '';
          const arrow = i < it.diagram.nodes.length - 1 ? '<span class="hp-mvp-arrow">→</span>' : '';
          return `<div class="${cls}">${esc(n.label)}${sub}</div>${arrow}`;
        }).join('');
        const note = it.diagram.note ? `<p class="hp-mvp-flow-note">${esc(it.diagram.note)}</p>` : '';
        diagramEl.innerHTML = `<div class="hp-mvp-diagram-cap">⛓ ${esc(it.diagram.cap)}</div><div class="hp-mvp-flow">${nodes}</div>${note}`;
        diagramEl.hidden = false;
      } else {
        diagramEl.hidden = true;
      }
      ctaEl.innerHTML = it.url
        ? `<a href="${esc(it.url)}" target="_blank" rel="noopener noreferrer">제출 노트 보기 ↗</a>`
        : '';
      overlay!.hidden = false;
      document.body.style.overflow = 'hidden';
      if (closeBtn) (closeBtn as HTMLElement).focus();
    }
    function closeModal() {
      overlay!.hidden = true;
      document.body.style.overflow = '';
    }
    document.querySelectorAll('.hp-mvp-card[data-mvp-idx]').forEach((card) => {
      if ((card as HTMLButtonElement).disabled) return;
      card.addEventListener('click', () => openModal(Number((card as HTMLElement).dataset.mvpIdx)));
    });
    closeBtn?.addEventListener('click', closeModal);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !overlay.hidden) closeModal(); });
  }
</script>

<style is:global>
  /* ═══════════════════════════════════════════════════════
     /index — 스폰지클럽 디자인 시스템 적용 (hp-* prefix)
     ═══════════════════════════════════════════════════════ */

  body.hp-body {
    margin: 0;
    min-height: 100vh;
    background: var(--sc-bg-base);
    color: var(--sc-text-primary);
    font-family: var(--sc-font-body);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.005em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  body.hp-body * { box-sizing: border-box; }
  body.hp-body h1, body.hp-body h2, body.hp-body h3, body.hp-body h4, body.hp-body p, body.hp-body ul { margin: 0; padding: 0; }
  body.hp-body ul { list-style: none; }
  body.hp-body a { color: inherit; text-decoration: none; }
  body.hp-body button { font: inherit; color: inherit; background: none; border: none; cursor: pointer; }

  /* ─── 공통 ─── */
  .hp-highlight {
    background: linear-gradient(transparent 55%, var(--sc-highlight-orange) 55%);
    font-weight: 700;
    padding: 0 4px;
  }

  /* ─── HEADER ─── */
  .hp-header {
    position: sticky; top: 0; z-index: 30;
    background: var(--sc-bg-base);
    border-bottom: 1px solid var(--sc-border-soft);
  }
  .hp-header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex; align-items: center; gap: 24px;
  }
  .hp-brand {
    display: inline-flex; align-items: baseline; gap: 8px;
    flex-shrink: 0;
  }
  .hp-brand-mark { font-size: 22px; line-height: 1; }
  .hp-brand-name {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 24px;
    letter-spacing: -0.01em;
    color: var(--sc-text-primary);
  }
  .hp-nav {
    display: flex; align-items: center; gap: 22px;
    margin-left: auto;
    font-size: 14px;
    font-weight: 500;
  }
  .hp-nav a {
    color: var(--sc-text-muted-mid);
    transition: color 160ms;
  }
  .hp-nav a:hover { color: var(--sc-text-primary); }
  .hp-week-pill {
    flex-shrink: 0;
    font-family: var(--sc-font-body);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.06em;
    padding: 7px 14px;
    border-radius: var(--sc-radius-pill);
    background: var(--sc-bg-signature);
    color: var(--sc-text-primary);
  }
  @media (max-width: 860px) {
    .hp-nav { gap: 14px; font-size: 13px; }
  }

  /* ─── HERO (잡지 표지) — GIF 배경 + 텍스트 오버레이 ─── */
  .hp-hero {
    position: relative;
    isolation: isolate;
    width: 100%;
  }
  .hp-hero-village {
    width: 100%;
    display: block;
  }
  .hp-hero-village .sv-village {
    aspect-ratio: 1440 / 460;
    max-height: 64vh;
  }
  /* 텍스트는 GIF 위 가운데 정렬 오버레이 */
  .hp-hero-text {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    max-width: 1200px;
    margin-inline: auto;
    padding: clamp(20px, 3.4vw, 44px);
    display: flex; flex-direction: column;
    gap: 14px;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .hp-hero-text > * { pointer-events: auto; }
  .hp-hero-kicker {
    font-family: var(--sc-font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--sc-text-primary);
    background: var(--sc-bg-signature);
    padding: 6px 13px;
    border-radius: var(--sc-radius-pill);
    box-shadow: 0 4px 14px rgba(26, 31, 54, 0.12);
  }
  .hp-hero-title {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(28px, 4.2vw, 60px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--sc-text-primary);
    background: var(--sc-bg-signature);
    padding: 8px 20px;
    border-radius: 14px;
    box-shadow: 0 8px 22px rgba(26, 31, 54, 0.12);
    display: inline-block;
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .hp-hero-title { white-space: normal; }
  }
  .hp-hero-lede {
    font-size: clamp(15px, 1.7vw, 19px);
    font-weight: 600;
    line-height: 1.6;
    color: var(--sc-text-primary);
    text-shadow:
      0 0 6px rgba(255, 251, 237, 0.95),
      0 0 14px rgba(255, 251, 237, 0.85),
      0 2px 6px rgba(255, 251, 237, 0.7);
    padding: 0;
    background: none;
    box-shadow: none;
  }
  .hp-hero-lede-em {
    display: inline-block;
    margin-top: 2px;
    font-weight: 800;
    color: var(--sc-text-primary);
  }
  .hp-hero-cta {
    margin-top: 6px;
    display: flex; gap: 10px; flex-wrap: wrap;
  }
  .hp-btn {
    padding: 13px 24px;
    border-radius: var(--sc-radius-pill);
    font-weight: 700;
    font-size: 14px;
    transition: filter 160ms, transform 160ms, background 160ms;
  }
  .hp-btn.hp-btn-dark {
    background: var(--sc-surface-dark);
    color: var(--sc-text-on-dark);
  }
  .hp-btn.hp-btn-dark:hover { transform: translateY(-1px); filter: brightness(1.06); }
  .hp-btn.hp-btn-ghost {
    background: transparent;
    color: var(--sc-text-primary);
    border: 1.5px solid var(--sc-text-primary);
  }
  .hp-btn.hp-btn-ghost:hover { background: var(--sc-text-primary); color: var(--sc-bg-signature); }

  /* ─── STATS 옐로우 띠 (시그니처 옐로우 사용처 1) ─── */
  .hp-stats {
    background: var(--sc-bg-signature);
    border-top: 1px solid rgba(26, 31, 54, 0.10);
    border-bottom: 1px solid rgba(26, 31, 54, 0.10);
  }
  .hp-stats-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .hp-stat {
    display: flex; flex-direction: column; align-items: center;
    gap: 4px;
    text-align: center;
  }
  .hp-stat-num {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1;
    color: var(--sc-text-primary);
    font-variant-numeric: tabular-nums;
  }
  .hp-stat-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(26, 31, 54, 0.65);
  }
  @media (max-width: 600px) {
    .hp-stats-inner { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }

  /* ─── MAIN ─── */
  .hp-main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 56px 24px 80px;
    display: flex; flex-direction: column; gap: 64px;
  }

  /* ─── SECTION HEADING ─── */
  .hp-section { display: flex; flex-direction: column; gap: 24px; }
  .hp-sh {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 18px;
    row-gap: 4px;
    align-items: end;
  }
  .hp-sh .sc-shape {
    grid-row: 1 / span 2;
    align-self: center;
    margin-bottom: 0;
  }
  .hp-sh-title {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--sc-text-primary);
  }
  .hp-sh-desc {
    font-size: 14px;
    font-weight: 500;
    color: var(--sc-text-muted-mid);
    margin-top: -2px;
  }

  /* ─── MVP 그리드 ─── */
  .hp-mvp-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  body.hp-body .hp-mvp-card {
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-card);
    padding: 22px 22px 20px;
    display: flex; flex-direction: column; gap: 8px;
    transition: transform 160ms, box-shadow 160ms, border-color 160ms;
    width: 100%;
    text-align: left;
    font-family: inherit;
    color: inherit;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }
  body.hp-body .hp-mvp-card:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(26, 31, 54, 0.07);
    border-color: var(--sc-accent-blue);
  }
  .hp-mvp-card:disabled { cursor: default; opacity: 0.6; }
  .hp-mvp-card-top { display: flex; align-items: center; gap: 8px; }
  .hp-mvp-week-tag {
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.04em;
    padding: 3px 8px; border-radius: var(--sc-radius-pill);
    background: rgba(26, 31, 54, 0.07); color: var(--sc-text-muted-high);
  }
  .hp-mvp-keys { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .hp-mvp-key {
    font-size: 11.5px; font-weight: 600; color: var(--sc-text-muted-high);
    background: rgba(255, 230, 122, 0.45); border: 1px solid rgba(26, 31, 54, 0.06);
    padding: 3px 9px; border-radius: var(--sc-radius-pill);
  }
  .hp-mvp-team {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    background: var(--sc-accent-blue);
    color: var(--sc-surface-white);
    border-radius: var(--sc-radius-pill);
    align-self: flex-start;
  }
  .hp-mvp-name {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.15;
    color: var(--sc-text-primary);
    margin-top: 4px;
  }
  .hp-mvp-title {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--sc-text-primary);
  }
  .hp-mvp-tagline {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.45;
    color: var(--sc-text-primary);
    letter-spacing: -0.01em;
    margin-top: 4px;
  }
  .hp-mvp-content {
    font-size: 13px;
    line-height: 1.6;
    color: var(--sc-text-muted-high);
    margin-top: 4px;
  }
  .hp-mvp-reason {
    font-size: 13px;
    line-height: 1.55;
    color: var(--sc-text-muted-high);
    padding: 8px 12px;
    background: rgba(255, 230, 122, 0.40);
    border-radius: 8px;
    margin-top: 6px;
  }
  @media (max-width: 900px) { .hp-mvp-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .hp-mvp-grid { grid-template-columns: 1fr; } }

  /* ─── 주차 선택 버튼 (최신호 카드 + 다른 주차는 issue 페이지로 이동) ─── */
  .hp-week-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 2px 0 20px;
  }
  .hp-week-btn {
    font-family: var(--sc-font-body);
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.01em;
    padding: 7px 17px;
    border-radius: var(--sc-radius-pill);
    border: 1.5px solid var(--sc-border-card);
    background: var(--sc-surface-white);
    color: var(--sc-text-muted-high);
    text-decoration: none;
    transition: transform 140ms, border-color 140ms, background 140ms, color 140ms, box-shadow 140ms;
  }
  .hp-week-btn:hover {
    transform: translateY(-2px);
    border-color: var(--sc-accent-blue);
    color: var(--sc-accent-blue);
    box-shadow: 0 5px 14px rgba(23, 86, 232, 0.14);
  }
  .hp-week-btn--active,
  .hp-week-btn--active:hover {
    background: var(--sc-accent-blue);
    border-color: var(--sc-accent-blue);
    color: var(--sc-surface-white);
  }

  /* ─── 물방울 (수중 무드를 메인까지) ─── */
  .hp-section--mvp { position: relative; }
  .hp-section--mvp > :not(.hp-bubbles) { position: relative; z-index: 1; }
  .hp-bubbles {
    position: absolute;
    inset: -12px -4px 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .hp-bubbles span {
    position: absolute;
    bottom: -36px;
    left: var(--bx);
    width: var(--bs);
    height: var(--bs);
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%,
      rgba(255, 255, 255, 0.9),
      rgba(84, 200, 212, 0.20) 58%,
      rgba(84, 200, 212, 0.05));
    border: 1px solid rgba(84, 200, 212, 0.32);
    opacity: 0;
    animation: hp-bubble-rise var(--bdur, 14s) ease-in var(--bd, 0s) infinite;
  }
  @keyframes hp-bubble-rise {
    0%   { transform: translateY(0) scale(0.6);  opacity: 0; }
    12%  { opacity: 0.55; }
    55%  { opacity: 0.45; }
    100% { transform: translateY(-440px) translateX(16px) scale(1.08); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-bubbles { display: none; }
  }

  /* ─── MVP 모달 ─── */
  .hp-mvp-overlay {
    position: fixed; inset: 0; z-index: 60;
    background: rgba(26, 31, 54, 0.5);
    display: flex; align-items: flex-start; justify-content: center;
    padding: 40px 16px; overflow-y: auto;
  }
  .hp-mvp-overlay[hidden] { display: none; }
  .hp-mvp-modal {
    position: relative; width: 560px; max-width: 100%;
    background: var(--sc-surface-white); border-radius: 18px;
    box-shadow: 0 24px 60px rgba(26, 31, 54, 0.28);
    animation: hpMvpPop 0.18s ease;
  }
  @keyframes hpMvpPop { from { transform: translateY(12px); opacity: 0; } to { transform: none; opacity: 1; } }
  .hp-mvp-modal-close {
    position: absolute; top: 14px; right: 16px;
    width: 34px; height: 34px; border: none; border-radius: 50%;
    background: rgba(26, 31, 54, 0.06); color: var(--sc-text-primary);
    font-size: 20px; line-height: 1; cursor: pointer;
  }
  .hp-mvp-modal-pad { padding: 30px; display: flex; flex-direction: column; gap: 14px; }
  .hp-mvp-modal-chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .hp-mvp-modal-chip { font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: var(--sc-radius-pill); }
  .hp-mvp-modal-chip--team { background: var(--sc-accent-blue); color: #fff; }
  .hp-mvp-modal-chip--key { background: rgba(255, 230, 122, 0.5); color: var(--sc-text-primary); border: 1px solid rgba(26, 31, 54, 0.07); }
  .hp-mvp-modal-title { font-size: 26px; font-weight: 800; line-height: 1.18; letter-spacing: -0.01em; margin: 2px 0 0; }
  .hp-mvp-modal-by { font-size: 13px; color: var(--sc-text-muted-mid); font-weight: 600; margin: -6px 0 0; }
  .hp-mvp-modal-lead-wrap { margin: 0; }
  .hp-mvp-modal-lead { font-size: 15px; font-weight: 700; line-height: 1.5; background: linear-gradient(transparent 58%, var(--sc-highlight-orange) 58%); }
  .hp-mvp-modal-body { display: flex; flex-direction: column; gap: 12px; }
  .hp-mvp-modal-body p { font-size: 13.5px; line-height: 1.72; color: var(--sc-text-muted-high); margin: 0; }
  .hp-mvp-modal-body p b { color: var(--sc-text-primary); }
  .hp-mvp-modal-diagram { padding: 16px; background: var(--sc-bg-base); border: 1px solid var(--sc-border-soft); border-radius: 12px; }
  .hp-mvp-modal-diagram[hidden] { display: none; }
  .hp-mvp-diagram-cap { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; color: var(--sc-text-muted-mid); text-transform: uppercase; margin-bottom: 12px; text-align: center; }
  .hp-mvp-flow { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6px; }
  .hp-mvp-node { font-size: 11.5px; font-weight: 700; line-height: 1.25; padding: 8px 11px; border-radius: 9px; background: var(--sc-surface-white); border: 1.5px solid var(--sc-text-primary); text-align: center; }
  .hp-mvp-node small { display: block; font-size: 9.5px; font-weight: 600; color: var(--sc-text-muted-mid); margin-top: 2px; }
  .hp-mvp-node--key { background: var(--sc-accent-yellow); }
  .hp-mvp-arrow { color: var(--sc-accent-blue); font-size: 15px; font-weight: 800; }
  .hp-mvp-flow-note { font-size: 11px; color: var(--sc-text-muted-mid); margin: 10px 0 0; text-align: center; }
  .hp-mvp-modal-cta:empty { display: none; }
  body.hp-body .hp-mvp-modal-cta a { display: inline-block; font-size: 13px; font-weight: 700; color: #fff; background: var(--sc-text-primary); padding: 9px 18px; border-radius: var(--sc-radius-pill); text-decoration: none; }
  @media (max-width: 560px) { .hp-mvp-modal-pad { padding: 24px 20px; } }

  /* ─── 조별 그리드 ─── */
  .hp-team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .hp-team-card {
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-card);
    display: flex; flex-direction: column;
    overflow: hidden;
    transition: transform 160ms, box-shadow 160ms, border-color 160ms;
  }
  .hp-team-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(26, 31, 54, 0.07);
    border-color: var(--sc-accent-red);
  }
  .hp-team-card-head {
    padding: 16px 20px;
    background: var(--sc-text-primary);
    color: var(--sc-bg-signature);
    display: flex; flex-direction: column; gap: 6px;
  }
  .hp-team-card-team {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    opacity: 0.75;
  }
  .hp-team-card-title {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 23px;
    line-height: 1.18;
    color: var(--sc-bg-signature);
  }
  .hp-team-card-subtitle {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.45;
    color: rgba(255, 251, 237, 0.72);
  }
  .hp-team-card-body {
    padding: 18px 20px 20px;
    display: flex; flex-direction: column; gap: 14px;
  }
  .hp-team-card-block { display: flex; flex-direction: column; gap: 6px; }
  .hp-team-card-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--sc-text-muted-mid);
  }
  .hp-team-card-block--insight .hp-team-card-label { color: var(--sc-accent-red); }
  .hp-team-card-text {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--sc-text-primary);
  }
  .hp-team-card-block--insight .hp-team-card-text {
    background: rgba(255, 230, 122, 0.40);
    padding: 8px 10px;
    border-radius: 8px;
  }
  @media (max-width: 900px) { .hp-team-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .hp-team-grid { grid-template-columns: 1fr; } }

  /* ─── 주차별 아카이브 — 매거진 백이슈 표지 ─── */
  .hp-issue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }
  .hp-issue-card {
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-card);
    overflow: hidden;
    display: flex; flex-direction: column;
    transition: transform 160ms, box-shadow 160ms, border-color 160ms;
  }
  .hp-issue-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 26px rgba(26, 31, 54, 0.12);
    border-color: var(--sc-surface-dark);
  }
  /* 표지 — 다크 블록에 큰 주차 번호 */
  .hp-issue-cover {
    position: relative;
    background: var(--sc-surface-dark);
    color: var(--sc-bg-signature);
    padding: 40px 20px 14px;
    display: flex;
    align-items: flex-end;
    gap: 8px;
    overflow: hidden;
  }
  .hp-issue-vol {
    position: absolute;
    top: 16px; left: 20px;
    font-family: var(--sc-font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    opacity: 0.7;
  }
  .hp-issue-num {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 64px;
    line-height: 0.92;
    color: var(--sc-bg-signature);
  }
  .hp-issue-coverlabel {
    font-family: var(--sc-font-display);
    font-size: 20px;
    line-height: 1;
    padding-bottom: 6px;
    opacity: 0.85;
  }
  .hp-issue-body {
    padding: 16px 20px 18px;
    display: flex; flex-direction: column; gap: 8px;
    flex: 1;
  }
  .hp-issue-title {
    font-family: var(--sc-font-display);
    font-weight: 400;
