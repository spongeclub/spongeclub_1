---
import Layout from '../layouts/Layout.astro';
import SpongeVillageGif from '../components/SpongeVillageGif.astro';
import {
  buildAllWeeks,
  buildWeekArticles,
  buildArticle,
  pickFeature,
  cardTitle,
  weekTheme,
  loadTeamAnalyses,
} from '../lib/data';
import { loadCuratedSkills, getLatestSkills } from '../lib/curated-skills';
import publishConfig from '../data/publish-week.json';

// 수동 발행 게이트: publishedWeek 가 숫자면 그 주차까지만 노출(새 주차 MVP가
// 다 채워질 때까지 자동 전환을 막음). null 이면 폴더 날짜 기준 자동 전환.
const publishedWeek: number | null = publishConfig.publishedWeek;

// 폴더명 끝 _MMDD 에서 주차 시작 날짜 추출 (현재 연도 기준)
function weekStartTs(folderName: string): number {
  const m = folderName.match(/_(\d{4})$/);
  if (!m) return 0;
  const mm = parseInt(m[1].slice(0, 2), 10);
  const dd = parseInt(m[1].slice(2), 10);
  const year = new Date().getFullYear();
  return new Date(year, mm - 1, dd, 0, 0, 0).getTime();
}

// 발행된 호 = 제출 기록 1건 이상 + 폴더 날짜가 오늘 이전(미래 주차 제외)
const today = Date.now();
const allSubmitted = buildAllWeeks().filter((w) => w.submittedCount > 0);
const weeks = allSubmitted.filter((w) => {
  // 수동 발행 게이트가 켜져 있으면 날짜와 무관하게 publishedWeek 까지만.
  if (publishedWeek != null) return w.weekNumber <= publishedWeek;
  const ts = weekStartTs(w.folderName);
  return ts === 0 || ts <= today;
});
// 게이트로 아직 발행 안 한 주차 — 페이지·기록은 그대로 두되 아카이브에서 토글로
// 접어서 노출(MVP가 다 정해지면 publishedWeek 를 올려 정식 발행). 자동 모드(null)
// 에선 토글 없이 날짜 기준으로 알아서 펼쳐지므로 upcoming 은 비운다.
const upcomingWeeks = publishedWeek != null
  ? allSubmitted.filter((w) => w.weekNumber > publishedWeek)
  : [];
const hasData = weeks.length > 0;
const latest = hasData ? weeks[weeks.length - 1] : null;

const totalWeeks = weeks.length;
const totalMembers = latest ? latest.totalMembers : 0;
const totalSubmissions = weeks.reduce((sum, w) => sum + w.submittedCount, 0);

const latestArticles = latest ? buildWeekArticles(latest) : [];
pickFeature(latestArticles); // 호환 유지 (사용처 없음)

const pastIssues = [...weeks].reverse().map((w) => {
  const arts = buildWeekArticles(w);
  return { week: w, theme: weekTheme(arts), count: arts.length };
});

// 토글로 접어둘 준비 중 주차 카드 (최신 주차가 위로)
const upcomingIssues = [...upcomingWeeks].reverse().map((w) => {
  const arts = buildWeekArticles(w);
  return { week: w, theme: weekTheme(arts), count: arts.length };
});

// 신규 등록 스킬 TOP 3 (skill md `created` 기준 최신)
const latestSkills = getLatestSkills(loadCuratedSkills(), 3);

// 이번 주 MVP — submit.md frontmatter `mvp: true` + 실제 제출(submitted: true) 기준.
// 이번 호에 그 조의 MVP가 없으면 가장 최근 과거 주차의 MVP로 폴백(카드에 'N주차' 표시).
const teamOrder = ['1조', '2조', '3조', '4조', '5조', '6조'];
const latestWeekNum = latest?.weekNumber ?? 0;
const weeklyMvps = teamOrder.map((team) => {
  for (let i = weeks.length - 1; i >= 0; i--) {
    const w = weeks[i];
    const sub = w.submissions.find(
      (s) => s.mvp && s.filePath && s.status === 'submitted' && s.member.team === team,
    );
    if (!sub) continue;
    const art = buildArticle(sub, w.weekNumber);
    return {
      team,
      nickname: sub.member.nickname,
      title: art ? cardTitle(art) : (sub.noteTitle || ''),
      excerpt: art ? (art.excerpt || '').slice(0, 90) : '',
      reason: sub.mvpReason || '',
      summary: sub.mvpSummary || '',
      content: sub.mvpContent || '',
      url: art?.url || '#',
      week: w.weekNumber,
      isPast: w.weekNumber !== latestWeekNum,
    };
  }
  return { team, nickname: '미정', title: '이번 주 미정', excerpt: '', reason: '', summary: '', content: '', url: '#', week: latestWeekNum, isPast: false };
});

// MVP 상세 — 클릭 모달용 풍부한 콘텐츠(주제+캐주얼 요약+키워드+도식화).
// 키는 `조|주차`. 검수된 항목만 풀 콘텐츠를 채우고, 없으면 mvp_summary/mvp_content로 폴백.
type MvpDiagramNode = { label: string; sub?: string; key?: boolean };
type MvpDetail = {
  keywords?: string[];
  title?: string;
  by?: string;
  lead?: string;
  paragraphs?: string[];
  diagram?: { cap: string; nodes: MvpDiagramNode[]; note?: string };
};
const mvpDetails: Record<string, MvpDetail> = {
  '1조|3': {
    title: '호흡의 하루',
    by: "혼자 일하는 사람을 위한 '매일 나 챙기기' 자동화",
    keywords: ['매일 자동화 루프', '하네스 오케스트레이션', '자기돌봄'],
    lead: "혼자 일하면 챙겨줄 상사도, 점검할 회의도 없잖아. 그래서 아가타는 '나를 매일 챙기는 장치'를 직접 만들었어.",
    paragraphs: [
      "아침·점심·저녁 하루 세 번, 텔레그램으로 <b>호흡 카드</b>가 톡 날아와. 답만 하면 알아서 정리돼서 차곡차곡 쌓이고, 대시보드로 한눈에 보여. 지금은 본인이 1호 사용자 — 한두 달 직접 써보고 같은 길 걷는 1인 기업가들한테 넓힐 생각이래.",
      "만든 방식이 좀 영리해. cron이 시간 맞춰 텔레그램을 쏘고(<b>컴퓨터 꺼져 있어도!</b>), Claude가 답을 받아 옵시디언에 분류·저장하고, 따로 도는 스크립트가 매일 밤 대시보드를 새로 그려. 발송·정리·저장·시각화를 <b>각각 따로 떼어놔서</b> 하나 고장 나도 나머진 멀쩡해.",
      "제일 크게 삽질한 건 <b>\"클라우드가 다 같은 게 아니더라\"</b>는 거. 처음 쓴 클라우드는 텔레그램으로 메시지 쏘는 게 막혀 있었거든. 로그 까보고 원인 찾자마자 외부 호출이 자유로운 GitHub Actions로 5분 만에 갈아탔대. <b>막힌 데서 끙끙대지 말고 딴 길로 빨리 돌아가기</b> — 이게 이번 호 MVP의 한 수.",
    ],
    diagram: {
      cap: '어떻게 굴러가나 — 8부품 자동 흐름',
      nodes: [
        { label: '⏰ GitHub Actions', sub: 'cron · 하루 3회', key: true },
        { label: '📲 텔레그램 봇', sub: '호흡 카드 발사' },
        { label: '🙋 폰에서 답' },
        { label: '🗂 분류·저장', sub: '옵시디언 vault' },
        { label: '📊 대시보드', sub: '매일 23:30 갱신', key: true },
      ],
      note: '컴퓨터 꺼져 있어도 알아서 발사 — 내 손 가는 건 폰에서 답 한 번이면 끝.',
    },
  },
};

// 카드 + 모달 렌더 데이터
const mvpCards = weeklyMvps.map((m) => {
  const d = mvpDetails[`${m.team}|${m.week}`] || {};
  const paragraphs = d.paragraphs && d.paragraphs.length
    ? d.paragraphs
    : (m.content ? [m.content] : (m.summary ? [m.summary] : []));
  return {
    team: m.team,
    name: m.nickname,
    tagline: m.summary || m.title,
    keywords: d.keywords || [],
    ready: !!(m.nickname && m.nickname !== '미정'),
    week: m.week,
    isPast: m.isPast,
    detail: {
      team: m.team,
      name: m.nickname,
      week: m.week,
      isPast: m.isPast,
      title: d.title || m.nickname,
      by: d.by || m.summary || '',
      lead: d.lead || '',
      keywords: d.keywords || [],
      paragraphs,
      diagram: d.diagram || null,
      url: m.url && m.url !== '#' ? m.url : '',
    },
  };
});

// 조별 마을 hotspot — 메인 hero에서는 이동 비활성 (이름만 표시)
const villageTeams = teamOrder.map((team) => ({ name: team }));

// 조별 분석 카드 — 90_analysis/teams/Week_0N_조M.md 에서 로드
const teamAnalyses = latest ? loadTeamAnalyses(latest.weekNumber) : [];
const teamCards = teamOrder.map((team) => {
  const a = teamAnalyses.find((x) => x.team === team);
  if (a) return { team, title: a.title, subtitle: a.subtitle, tagline: a.tagline, insight: a.insight };
  return {
    team,
    title: `${latest?.weekNumber ?? ''}주차의 기록`,
    subtitle: '',
    tagline: '아직 분석이 생성되지 않았습니다.',
    insight: '',
  };
});

const weekLabel = (n: number) => `WEEK ${String(n).padStart(2, '0')}`;
const year = new Date().getFullYear();
---

<Layout title="스폰지클럽 — 매주 만들고, 각자 나눈다" bodyClass="hp-body">
  <!-- ─── HEADER ─────────────────────────────────────── -->
  <header class="hp-header">
    <div class="hp-header-inner">
      <a href="/" class="hp-brand">
        <span class="hp-brand-mark">🧽</span>
        <span class="hp-brand-name">spongeclub</span>
      </a>
      <nav class="hp-nav" aria-label="메인 메뉴">
        <a href="/skills/">스킬&인사이트</a>
        <a href="/gallery/">갤러리</a>
        <a href="/members/">구성원</a>
        <a href="#archive">주차별 아카이브</a>
      </nav>
    </div>
  </header>

  {!hasData && (
    <main class="hp-empty">
      <h1>스폰지클럽</h1>
      <p>아직 발행된 호가 없습니다.</p>
    </main>
  )}

  {hasData && (
    <>
      <!-- ─── HERO (잡지 표지: 텍스트 + 비키니바텀 마을) ───── -->
      <section class="hp-hero">
        <div class="hp-hero-text">
          <h1 class="hp-hero-title">흡수하고, 짜내고, 냅다 만든다</h1>
          <p class="hp-hero-lede">
            스폰지처럼 AI를 빨아들여 나만의 제품으로<br />
            <span class="hp-hero-lede-em">AI 빌더 커뮤니티 · 스폰지클럽</span>
          </p>
        </div>

        <div class="hp-hero-village">
          <SpongeVillageGif teams={villageTeams} interactive={false} />
        </div>
      </section>

      <!-- ─── STATS 옐로우 시그니처 띠 ────────────── -->
      <section class="hp-stats">
        <div class="hp-stats-inner">
          <div class="hp-stat">
            <span class="hp-stat-num">{String(totalWeeks).padStart(2, '0')}</span>
            <span class="hp-stat-label">발행 호</span>
          </div>
          <div class="hp-stat">
            <span class="hp-stat-num">{totalMembers}</span>
            <span class="hp-stat-label">멤버</span>
          </div>
          <div class="hp-stat">
            <span class="hp-stat-num">{totalSubmissions}</span>
            <span class="hp-stat-label">누적 기록</span>
          </div>
          <div class="hp-stat">
            <span class="hp-stat-num">06</span>
            <span class="hp-stat-label">조</span>
          </div>
        </div>
      </section>

      <main class="hp-main">

        <!-- ─── ● MVP ──────────────────────────────── -->
        <section class="hp-section" id="mvp">
          <div class="hp-sh">
            <span class="sc-shape sc-shape--circle" aria-hidden="true"></span>
            <h2 class="hp-sh-title">이번 호 MVP</h2>
            <p class="hp-sh-desc">6개 조에서 한 명씩 — 이번 호의 6인</p>
          </div>
          <div class="hp-mvp-grid">
            {mvpCards.map((m, i) => (
              <button class="hp-mvp-card" type="button" data-mvp-idx={i} disabled={!m.ready}>
                <span class="hp-mvp-card-top">
                  <span class="hp-mvp-team">{m.team}</span>
                  {m.isPast && <span class="hp-mvp-week-tag">{m.week}주차</span>}
                </span>
                <span class="hp-mvp-name">{m.name}</span>
                <p class="hp-mvp-tagline">{m.tagline}</p>
                {m.keywords.length > 0 && (
                  <span class="hp-mvp-keys">
                    {m.keywords.map((k) => <span class="hp-mvp-key"># {k}</span>)}
                  </span>
                )}
              </button>
            ))}
          </div>
        </section>

        <!-- MVP 모달 -->
        <div class="hp-mvp-overlay" id="mvpOverlay" hidden>
          <div class="hp-mvp-modal" role="dialog" aria-modal="true" aria-labelledby="mvpModalTitle">
            <button class="hp-mvp-modal-close" id="mvpModalClose" type="button" aria-label="닫기">×</button>
            <div class="hp-mvp-modal-pad">
              <div class="hp-mvp-modal-chips" id="mvpModalChips"></div>
              <h3 class="hp-mvp-modal-title" id="mvpModalTitle"></h3>
              <p class="hp-mvp-modal-by" id="mvpModalBy"></p>
              <p class="hp-mvp-modal-lead-wrap" id="mvpModalLeadWrap" hidden><span class="hp-mvp-modal-lead" id="mvpModalLead"></span></p>
              <div class="hp-mvp-modal-body" id="mvpModalBody"></div>
              <div class="hp-mvp-modal-diagram" id="mvpModalDiagram" hidden></div>
              <div class="hp-mvp-modal-cta" id="mvpModalCta"></div>
            </div>
          </div>
        </div>
        <script type="application/json" id="mvpDetailsData" set:html={JSON.stringify(mvpCards.map((m) => m.detail))}></script>

        <!-- ─── ■ 이번 호 (조별 기록) ─────────────── -->
        {latest && (
          <section class="hp-section" id="this-issue">
            <div class="hp-sh">
              <span class="sc-shape sc-shape--square" aria-hidden="true"></span>
              <h2 class="hp-sh-title">{latest.weekNumber}주차의 기록</h2>
              <p class="hp-sh-desc">
                {latestArticles.length}명이 이번 주 만든 것 — 전체는 이슈 페이지에서.
              </p>
            </div>
            <div class="hp-team-grid">
              {teamCards.map((t) => (
                <article class="hp-team-card">
                  <header class="hp-team-card-head">
                    <span class="hp-team-card-team">{t.team}</span>
                    <h3 class="hp-team-card-title">{t.title}</h3>
                    {t.subtitle && <p class="hp-team-card-subtitle">{t.subtitle}</p>}
                  </header>
                  <div class="hp-team-card-body">
                    <div class="hp-team-card-block">
                      <span class="hp-team-card-label">간단 요약</span>
                      <p class="hp-team-card-text">{t.tagline}</p>
                    </div>
                    {t.insight && (
                      <div class="hp-team-card-block hp-team-card-block--insight">
                        <span class="hp-team-card-label">★ 스폰지 인사이트</span>
                        <p class="hp-team-card-text">{t.insight}</p>
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
            <div class="hp-more">
              <a class="hp-more-link" href={`/issue/${latest.weekNumber}/`}>
                이번 호 전체 기록 보기 →
              </a>
            </div>
          </section>
        )}

        <!-- ─── ▲ 신규 스킬 ───────────────────────── -->
        {latestSkills.length > 0 && (
          <section class="hp-section" id="new-skills">
            <div class="hp-sh">
              <span class="sc-shape sc-shape--triangle" aria-hidden="true"></span>
              <h2 class="hp-sh-title">방금 등록된 스킬</h2>
              <p class="hp-sh-desc">이번 주 새로 들어온 스킬 후기 — 따끈할 때 보세요.</p>
            </div>
            <div class="hp-skills-grid">
              {latestSkills.map((sk) => (
                <a class="hp-skill-card" href={`/skills/#${sk.slug}`}>
                  <div class="hp-skill-meta">
                    <span class="hp-skill-cat">{sk.category}</span>
                    {sk.created && <span class="hp-skill-date">{sk.created}</span>}
                  </div>
                  <h3 class="hp-skill-name">{sk.summary || sk.skillName || sk.title}</h3>
                  <p class="hp-skill-handle">{sk.skillName}</p>
                  {sk.userCount > 0 && (
                    <span class="hp-skill-fire">🔥 {sk.userCount}명이 써봄</span>
                  )}
                </a>
              ))}
            </div>
            <div class="hp-more">
              <a class="hp-more-link" href="/skills/">스킬 전체 보기 →</a>
            </div>
          </section>
        )}

        <!-- ─── ■ 주차별 아카이브 ──────────────────────────── -->
        <section class="hp-section" id="archive">
          <div class="hp-sh">
            <span class="sc-shape sc-shape--square" aria-hidden="true"></span>
            <h2 class="hp-sh-title">주차별 아카이브</h2>
            <p class="hp-sh-desc">매주 한 호씩 — 열면 그 주의 모든 기록이 조별로 펼쳐집니다.</p>
          </div>
          <div class="hp-issue-grid">
            {pastIssues.map(({ week, theme, count }) => (
              <a class="hp-issue-card" href={`/issue/${week.weekNumber}/`}>
                <div class="hp-issue-cover">
                  <span class="hp-issue-vol">VOL.{String(week.weekNumber).padStart(2, '0')}</span>
                  <span class="hp-issue-num">{String(week.weekNumber).padStart(2, '0')}</span>
                  <span class="hp-issue-coverlabel">주차</span>
                </div>
                <div class="hp-issue-body">
                  <h3 class="hp-issue-title">
                    {theme || `${week.weekNumber}주차의 기록`}
                  </h3>
                  <span class="hp-issue-meta">
                    {week.dateLabel ? `${week.dateLabel} · ` : ''}{count}개 기록{week.submittedCount ? ` · ${week.submittedCount}명 참여` : ''}
                  </span>
                  <span class="hp-issue-readmore">이 호 펼쳐보기 →</span>
                </div>
              </a>
            ))}
          </div>

          {upcomingIssues.length > 0 && (
            <details class="hp-upcoming">
              <summary class="hp-upcoming-summary">
                준비 중인 주차 {upcomingIssues.length}개 — MVP 선정 중이라 접어뒀어요
                <span class="hp-upcoming-chevron" aria-hidden="true">▾</span>
              </summary>
              <div class="hp-issue-grid hp-upcoming-grid">
                {upcomingIssues.map(({ week, theme, count }) => (
                  <a class="hp-issue-card hp-issue-card--upcoming" href={`/issue/${week.weekNumber}/`}>
                    <div class="hp-issue-cover">
                      <span class="hp-issue-vol">VOL.{String(week.weekNumber).padStart(2, '0')}</span>
                      <span class="hp-issue-num">{String(week.weekNumber).padStart(2, '0')}</span>
                      <span class="hp-issue-coverlabel">주차 · 준비 중</span>
                    </div>
                    <div class="hp-issue-body">
                      <h3 class="hp-issue-title">
                        {theme || `${week.weekNumber}주차의 기록`}
                      </h3>
                      <span class="hp-issue-meta">
                        {week.dateLabel ? `${week.dateLabel} · ` : ''}{count}개 기록{week.submittedCount ? ` · ${week.submittedCount}명 참여` : ''}
                      </span>
                      <span class="hp-issue-readmore">미리 펼쳐보기 →</span>
                    </div>
                  </a>
                ))}
              </div>
            </details>
          )}
        </section>

        <!-- ─── DARK CTA (한 페이지 1개) ──────────── -->
        <section class="hp-cta">
          <p class="hp-cta-head">흡수하고, 짜내고,<br />만든다.</p>
          <p class="hp-cta-body">
