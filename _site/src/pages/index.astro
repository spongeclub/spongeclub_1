          var open = nav.classList.toggle('hp-nav--open');
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
        });
        nav.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function () {
            nav.classList.remove('hp-nav--open');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.setAttribute('aria-label', '메뉴 열기');
          });
        });
      }

      if (header) {
        var threshold = function () {
          return heroImg ? Math.max(heroImg.offsetHeight - 70, 80) : 80;
        };
        var onScroll = function () {
          if (window.scrollY > threshold()) header.classList.add('is-solid');
          else header.classList.remove('is-solid');
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      // "함께한 지" D-day: 매일 한국시간(KST) 기준으로 숫자 갱신
      var dday = document.getElementById('hp-stat-dday');
      if (dday) {
        var fromParts = (dday.getAttribute('data-dday-from') || '2026-05-03').split('-').map(Number);
        var fromUTC = Date.UTC(fromParts[0], fromParts[1] - 1, fromParts[2]);
        var nowD = new Date();
        var kstD = new Date(nowD.getTime() + (nowD.getTimezoneOffset() + 540) * 60000);
        var todayUTC = Date.UTC(kstD.getFullYear(), kstD.getMonth(), kstD.getDate());
        var days = Math.max(0, Math.floor((todayUTC - fromUTC) / 86400000));
        dday.textContent = String(days);
      }
    })();
  </script>
</Layout>

<script>
  // 주차 탭 → 제자리 카드 전환 + 카드 클릭 → 모달 (데이터는 주차별 맵)
  const dataEl = document.getElementById('mvpDetailsData');
  const overlay = document.getElementById('mvpOverlay');
  if (dataEl && overlay) {
    let byWeek: Record<string, any[]> = {};
    try { byWeek = JSON.parse(dataEl.textContent || '{}'); } catch (e) { byWeek = {}; }
    const closeBtn = document.getElementById('mvpModalClose');
    const chipsEl = document.getElementById('mvpModalChips');
    const titleEl = document.getElementById('mvpModalTitle');
    const byEl = document.getElementById('mvpModalBy');
    const leadWrap = document.getElementById('mvpModalLeadWrap');
    const leadEl = document.getElementById('mvpModalLead');
    const bodyEl = document.getElementById('mvpModalBody');
    const diagramEl = document.getElementById('mvpModalDiagram');
    const ctaEl = document.getElementById('mvpModalCta');

    function esc(s: string) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // ── 주차 탭 전환 (페이지 이동 없이 그 호 카드로 교체) ──
    const grids = Array.from(document.querySelectorAll<HTMLElement>('[data-week-grid]'));
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-week-btn]'));
    function selectWeek(week: string) {
      grids.forEach((g) => { g.hidden = g.dataset.weekGrid !== week; });
      tabs.forEach((t) => {
        const on = t.dataset.weekBtn === week;
        t.classList.toggle('hp-week-btn--active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    }
    tabs.forEach((t) => t.addEventListener('click', () => selectWeek(t.dataset.weekBtn || '')));

    // ── 모달 ──
    function openModal(week: string, idx: number) {
      const it = (byWeek[week] || [])[idx];
      if (!it || !chipsEl || !titleEl || !byEl || !bodyEl || !diagramEl || !ctaEl) return;
      let chips = `<span class="hp-mvp-modal-chip hp-mvp-modal-chip--team">${esc(it.team)} · ${esc(it.name)}</span>`;
      if (it.week) chips += `<span class="hp-mvp-modal-chip hp-mvp-modal-chip--key">${esc(String(it.week))}주차</span>`;
      (it.keywords || []).forEach((k: string) => {
        chips += `<span class="hp-mvp-modal-chip hp-mvp-modal-chip--key"># ${esc(k)}</span>`;
      });
      chipsEl.innerHTML = chips;
      titleEl.textContent = it.title || it.name;
      byEl.textContent = it.by || '';
      byEl.hidden = !it.by;
      if (leadWrap && leadEl) {
        if (it.lead) { leadEl.textContent = it.lead; leadWrap.hidden = false; }
        else { leadWrap.hidden = true; }
      }
      // 본문 — paragraphs 는 신뢰된 정적 콘텐츠(빌드 데이터)라 <b> 허용
      bodyEl.innerHTML = (it.paragraphs || []).map((p: string) => `<p>${p}</p>`).join('');
      // 도식화
      if (it.diagram && Array.isArray(it.diagram.nodes) && it.diagram.nodes.length) {
        const nodes = it.diagram.nodes.map((n: any, i: number) => {
          const cls = 'hp-mvp-node' + (n.key ? ' hp-mvp-node--key' : '');
          const sub = n.sub ? `<small>${esc(n.sub)}</small>` : '';
          const arrow = i < it.diagram.nodes.length - 1 ? '<span class="hp-mvp-arrow">→</span>' : '';
          return `<div class="${cls}">${esc(n.label)}${sub}</div>${arrow}`;
        }).join('');
        const note = it.diagram.note ? `<p class="hp-mvp-flow-note">${esc(it.diagram.note)}</p>` : '';
        diagramEl.innerHTML = `<div class="hp-mvp-diagram-cap">⛓ ${esc(it.diagram.cap)}</div><div class="hp-mvp-flow">${nodes}</div>${note}`;
        diagramEl.hidden = false;
      } else {
        diagramEl.hidden = true;
      }
      ctaEl.innerHTML = it.url
        ? `<a href="${esc(it.url)}" target="_blank" rel="noopener noreferrer">제출 노트 보기 ↗</a>`
        : '';
      overlay!.hidden = false;
      document.body.style.overflow = 'hidden';
      if (closeBtn) (closeBtn as HTMLElement).focus();
    }
    function closeModal() {
      overlay!.hidden = true;
      document.body.style.overflow = '';
    }
    document.querySelectorAll('.hp-mvp-card[data-mvp-idx]').forEach((card) => {
      if ((card as HTMLButtonElement).disabled) return;
      const el = card as HTMLElement;
      card.addEventListener('click', () => openModal(el.dataset.mvpWeek || '', Number(el.dataset.mvpIdx)));
    });
    closeBtn?.addEventListener('click', closeModal);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !overlay.hidden) closeModal(); });
  }
</script>

<style is:global>
