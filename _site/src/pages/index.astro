---
import Layout from '../layouts/Layout.astro';
import { activeSeason, seasonByN } from '../config/seasons';

// 시즌 메타 — 2기(현재) · 1기(아카이브)
const s2 = activeSeason;
const s1 = seasonByN(1)!;

// D-day · 시작일 라벨 — 2기 startDate 기준
const today = new Date();
const startDate = s2.startDate ? new Date(s2.startDate) : null;
const dDay = startDate
  ? Math.ceil((startDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24))
  : null;
const [, sM, sD] = (s2.startDate ?? '').split('-');
const startLabel = sM && sD ? `${Number(sM)}월 ${Number(sD)}일` : '곧';

const year = today.getFullYear();
const pageTitle = `스폰지클럽 ${s2.label} — 곧 시작합니다`;
const pageDesc = `스폰지클럽 ${s2.label} 시즌이 ${startLabel} 시작합니다. 그동안 1기 활동을 둘러보세요.`;
---

<Layout title={pageTitle} description={pageDesc} bodyClass="splash-body">
  <div class="splash">

    <!-- 배경 컬러 블롭 (frosted glass 배너 뒤에 비치는 색감) -->
    <div class="splash-bg" aria-hidden="true">
      <div class="splash-blob splash-blob--y"></div>
      <div class="splash-blob splash-blob--o"></div>
      <div class="splash-blob splash-blob--r"></div>
    </div>

    <!-- 최소 헤더 -->
    <header class="splash-header">
      <a href="/" class="splash-brand">
        <span class="splash-brand-mark">🧽</span>
        <span class="splash-brand-name">spongeclub</span>
        <span class="splash-brand-season">{s2.label}</span>
      </a>
      <nav class="splash-nav" aria-label="둘러보기">
        <a href="/skills/">스킬&인사이트</a>
        <a href="/gallery/">갤러리</a>
        <a href="/members/">크루</a>
        <a href={`${s1.path}/recap/`} class="splash-nav-recap">1기 다시보기 →</a>
      </nav>
    </header>

    <!-- 중앙 배너 (불투명한 frosted glass 카드) -->
    <main class="splash-main">
      <article class="splash-card">
        <span class="splash-card-tag">PREPARING · {s2.label} SEASON</span>

        <h1 class="splash-card-title">
          {s2.label} 결과물<br />
          <em>준비 중</em>
        </h1>

        <p class="splash-card-desc">
          스폰지클럽 {s2.label} 시즌이 <b>{startLabel}</b> 시작합니다.<br />
          {dDay != null && dDay > 0
            ? `D-${dDay} — 매주 만들고 나눈 결과물이 곧 이 자리에 차곡차곡 쌓입니다.`
            : `매주 만들고 나눈 결과물이 곧 이 자리에 차곡차곡 쌓입니다.`}
        </p>

        <div class="splash-card-meta">
          <span class="splash-meta-pill"><b>{s2.members ?? '—'}</b> 명</span>
          <span class="splash-meta-pill"><b>{s2.teams ?? '—'}</b> 조</span>
          <span class="splash-meta-pill"><b>{s2.weeks ?? '—'}</b> 주</span>
        </div>

        <div class="splash-card-ctas">
          <a class="splash-btn splash-btn--primary" href={`${s1.path}/recap/`}>
            <span>1기 활동 보러가기</span>
            <span class="splash-btn-arrow">→</span>
          </a>
          <a class="splash-btn splash-btn--ghost" href={s1.path}>
            1기 매거진 전체 보기
          </a>
        </div>
      </article>
    </main>

    <footer class="splash-footer">
      © {year} SPONGECLUB · Seoul · Republic of Korea
    </footer>
  </div>
</Layout>

<style is:global>
  /* ═══════════════════════════════════════════════════════
     /  (스폰지클럽 2기 시즌 시작 전 splash)
     ─ 가운데 frosted glass 배너 + 1기 활동 CTA
     ═══════════════════════════════════════════════════════ */

  body.splash-body {
    margin: 0;
    min-height: 100vh;
    color: var(--sc-text-primary);
    font-family: var(--sc-font-body);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.005em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  body.splash-body * { box-sizing: border-box; }
  body.splash-body a { color: inherit; text-decoration: none; }
  body.splash-body h1, body.splash-body p { margin: 0; }

  .splash {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 20%, #FFFBED 0%, #FFF6D6 35%, #FCE17A 100%);
  }

  /* ── 배경 컬러 블롭 (배너 뒤로 비치는 색) ── */
  .splash-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .splash-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    will-change: transform;
  }
  .splash-blob--y {
    width: 520px; height: 520px;
    top: -160px; left: -120px;
    background: #FFE678;
    opacity: 0.85;
  }
  .splash-blob--o {
    width: 440px; height: 440px;
    bottom: -120px; right: -80px;
    background: #FFB05A;
    opacity: 0.55;
  }
  .splash-blob--r {
    width: 360px; height: 360px;
    top: 38%; left: 56%;
    background: #E53330;
    opacity: 0.18;
  }
  @media (max-width: 720px) {
    .splash-blob--y { width: 380px; height: 380px; top: -120px; left: -80px; }
    .splash-blob--o { width: 320px; height: 320px; }
    .splash-blob--r { width: 260px; height: 260px; }
  }

  /* ── 헤더 ── */
  .splash-header {
    position: relative;
    z-index: 10;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 22px clamp(20px, 4vw, 32px);
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .splash-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .splash-brand-mark { font-size: 24px; line-height: 1; }
  .splash-brand-name {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--sc-text-primary);
  }
  .splash-brand-season {
    font-family: var(--sc-font-body);
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.06em;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--sc-accent-red);
    color: #fff;
  }
  .splash-nav {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-left: auto;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--sc-text-muted-mid);
  }
  .splash-nav a {
    transition: color 160ms;
  }
  .splash-nav a:hover { color: var(--sc-text-primary); }
  .splash-nav-recap {
    font-weight: 800 !important;
    color: var(--sc-accent-red) !important;
  }
  .splash-nav-recap:hover { filter: brightness(0.92); }
  @media (max-width: 720px) {
    .splash-nav { gap: 14px; font-size: 12.5px; }
  }
  @media (max-width: 540px) {
    .splash-nav { display: none; }
  }

  /* ── 중앙 배너 (frosted glass) ── */
  .splash-main {
    position: relative;
    z-index: 10;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(40px, 6vw, 80px) clamp(20px, 4vw, 32px);
  }
  .splash-card {
    position: relative;
    max-width: 720px;
    width: 100%;
    padding: clamp(40px, 5.5vw, 64px) clamp(28px, 4.6vw, 56px);
    background: rgba(255, 251, 237, 0.62);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 28px;
    box-shadow:
      0 30px 80px rgba(26, 31, 54, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .splash-card-tag {
    font-family: var(--sc-font-body);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 7px 13px;
    border-radius: 999px;
    background: var(--sc-text-primary);
    color: var(--sc-bg-signature);
  }
  .splash-card-title {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(40px, 6.4vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--sc-text-primary);
    word-break: keep-all;
  }
  .splash-card-title em {
    font-style: normal;
    background: linear-gradient(transparent 56%, var(--sc-highlight-orange) 56%);
    padding: 0 8px;
  }
  .splash-card-desc {
    font-size: clamp(15px, 1.75vw, 17.5px);
    font-weight: 500;
    line-height: 1.7;
    color: var(--sc-text-muted-high);
    max-width: 560px;
  }
  .splash-card-desc b {
    font-weight: 800;
    color: var(--sc-text-primary);
  }
  .splash-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .splash-meta-pill {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--sc-text-muted-high);
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }
  .splash-meta-pill b {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 15px;
    color: var(--sc-text-primary);
    margin-right: 3px;
  }
  .splash-card-ctas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .splash-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 24px;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 700;
    transition: transform 160ms, filter 160ms, box-shadow 160ms, background 160ms;
  }
  body.splash-body .splash-btn--primary {
    background: var(--sc-text-primary);
    color: var(--sc-bg-signature);
    box-shadow: 0 12px 28px rgba(26, 31, 54, 0.20);
  }
  .splash-btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 34px rgba(26, 31, 54, 0.26);
    filter: brightness(1.06);
  }
  .splash-btn-arrow {
    display: inline-block;
    transition: transform 200ms;
  }
  .splash-btn--primary:hover .splash-btn-arrow {
    transform: translateX(4px);
  }
  body.splash-body .splash-btn--ghost {
    background: rgba(255, 255, 255, 0.5);
    color: var(--sc-text-primary);
    border: 1.5px solid rgba(26, 31, 54, 0.15);
  }
  .splash-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.85);
    border-color: rgba(26, 31, 54, 0.3);
  }

  /* ── 푸터 ── */
  .splash-footer {
    position: relative;
    z-index: 10;
    width: 100%;
    padding: 20px clamp(20px, 4vw, 32px) 28px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--sc-text-muted-mid);
    text-align: center;
  }
</style>
