    z-index: 1;
    background: #E5CFAA; /* 이미지 하단 가장자리 마스크 페이드로 드러나는 모래색 받침 */
  }
  /* 캐릭터(스폰지)까지는 또렷하게. 그 아래에서 모래색→크림 그라데이션이 시작해
     이미지 밖(제목 영역)까지 겹쳐 내려옴. 제목 글씨는 위(z-index)로 떠서 그대로 읽힘.
     이미지 원본 픽셀은 안 건드림 — 위에 그라데이션만 덮음. */
  .hp-hero-village::after {
