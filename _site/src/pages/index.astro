    border-color: var(--sc-accent-blue);
  }
  .hp-mvp-card:disabled { cursor: default; opacity: 0.6; }
  .hp-mvp-card-top { display: flex; align-items: center; gap: 8px; }
  .hp-mvp-week-tag {
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.04em;
    padding: 3px 8px; border-radius: var(--sc-radius-pill);
    background: rgba(26, 31, 54, 0.07); color: var(--sc-text-muted-high);
  }
  .hp-mvp-keys { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .hp-mvp-key {
    font-size: 11.5px; font-weight: 600; color: var(--sc-text-muted-high);
    background: rgba(255, 230, 122, 0.45); border: 1px solid rgba(26, 31, 54, 0.06);
    padding: 3px 9px; border-radius: var(--sc-radius-pill);
  }
  .hp-mvp-team {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    background: var(--sc-accent-blue);
    color: var(--sc-surface-white);
    border-radius: var(--sc-radius-pill);
    align-self: flex-start;
  }
  .hp-mvp-name {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.15;
    color: var(--sc-text-primary);
    margin-top: 4px;
  }
  .hp-mvp-title {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--sc-text-primary);
  }
  .hp-mvp-tagline {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.45;
    color: var(--sc-text-primary);
    letter-spacing: -0.01em;
    margin-top: 4px;
  }
  .hp-mvp-content {
    font-size: 13px;
    line-height: 1.6;
    color: var(--sc-text-muted-high);
    margin-top: 4px;
  }
  .hp-mvp-reason {
    font-size: 13px;
    line-height: 1.55;
    color: var(--sc-text-muted-high);
    padding: 8px 12px;
    background: rgba(255, 230, 122, 0.40);
    border-radius: 8px;
    margin-top: 6px;
  }
  @media (max-width: 900px) { .hp-mvp-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .hp-mvp-grid { grid-template-columns: 1fr; } }

  /* ─── 주차 선택 버튼 (최신호 카드 + 다른 주차는 issue 페이지로 이동) ─── */
  .hp-week-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 2px 0 20px;
  }
  body.hp-body .hp-week-btn {
    font-family: var(--sc-font-body);
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.01em;
    padding: 7px 17px;
    border-radius: var(--sc-radius-pill);
    border: 1.5px solid var(--sc-border-card);
    background: var(--sc-surface-white);
    color: var(--sc-text-primary);
    text-decoration: none;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition: transform 140ms, border-color 140ms, background 140ms, color 140ms, box-shadow 140ms;
  }
  body.hp-body .hp-week-btn:hover {
    transform: translateY(-2px);
    border-color: var(--sc-accent-blue);
    color: var(--sc-accent-blue);
    box-shadow: 0 5px 14px rgba(23, 86, 232, 0.14);
  }
  body.hp-body .hp-week-btn--active,
  body.hp-body .hp-week-btn--active:hover {
    background: var(--sc-accent-blue);
    border-color: var(--sc-accent-blue);
    color: var(--sc-surface-white);
  }

  /* ─── 물방울 (수중 무드를 메인까지) ─── */
  .hp-section--mvp { position: relative; }
  .hp-section--mvp > :not(.hp-bubbles) { position: relative; z-index: 1; }
  .hp-bubbles {
    position: absolute;
    inset: -12px -4px 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .hp-bubbles span {
    position: absolute;
    bottom: -36px;
    left: var(--bx);
    width: var(--bs);
    height: var(--bs);
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%,
      rgba(255, 255, 255, 0.9),
      rgba(84, 200, 212, 0.20) 58%,
      rgba(84, 200, 212, 0.05));
    border: 1px solid rgba(84, 200, 212, 0.32);
    opacity: 0;
    animation: hp-bubble-rise var(--bdur, 14s) ease-in var(--bd, 0s) infinite;
  }
  @keyframes hp-bubble-rise {
    0%   { transform: translateY(0) scale(0.6);  opacity: 0; }
    12%  { opacity: 0.55; }
    55%  { opacity: 0.45; }
    100% { transform: translateY(-440px) translateX(16px) scale(1.08); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-bubbles { display: none; }
  }

  /* ─── ★ 이번 호 주요 기사 (issue 페이지 .iss-feature 와 동일 룩) ─── */
  .hp-feature {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-card);
    overflow: hidden;
  }
  .hp-feature-side {
    padding: clamp(24px, 3vw, 36px);
    background: var(--sc-surface-dark);
    color: var(--sc-text-on-dark);
    display: flex; flex-direction: column; gap: 14px;
    border-right: 1px solid var(--sc-border-card);
  }
  .hp-feature-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--sc-bg-signature);
    color: var(--sc-text-primary);
    border-radius: var(--sc-radius-pill);
    padding: 5px 11px;
    align-self: flex-start;
  }
  .hp-feature-team {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(36px, 4.4vw, 60px);
    line-height: 0.95;
    color: var(--sc-bg-signature);
  }
  .hp-feature-name {
    margin-top: auto;
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 230, 122, 0.85);
  }
  .hp-feature-name b { color: var(--sc-bg-signature); font-weight: 700; }
  .hp-feature-name a { border-bottom: 1px solid rgba(255, 230, 122, 0.35); }
  .hp-feature-main {
    padding: clamp(24px, 3vw, 36px);
    display: flex; flex-direction: column; gap: 14px;
  }
  .hp-feature-title {
    font-family: var(--sc-font-body);
    font-weight: 700;
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--sc-text-primary);
  }
  .hp-feature-excerpt {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--sc-text-muted-high);
    font-weight: 500;
  }
  .hp-feature-cta {
    align-self: flex-start;
    margin-top: 4px;
    padding: 10px 18px;
    border-radius: var(--sc-radius-pill);
    background: var(--sc-text-primary);
    color: var(--sc-bg-signature);
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
    transition: filter 140ms, transform 140ms;
  }
  .hp-feature-cta:hover { filter: brightness(1.1); transform: translateY(-1px); }
  @media (max-width: 760px) {
    .hp-feature { grid-template-columns: 1fr; }
    .hp-feature-side { border-right: none; border-bottom: 1px solid var(--sc-border-card); }
  }

  /* ─── MVP 모달 ─── */
  .hp-mvp-overlay {
    position: fixed; inset: 0; z-index: 60;
    background: rgba(26, 31, 54, 0.5);
    display: flex; align-items: flex-start; justify-content: center;
    padding: 40px 16px; overflow-y: auto;
  }
  .hp-mvp-overlay[hidden] { display: none; }
  .hp-mvp-modal {
    position: relative; width: 560px; max-width: 100%;
    background: var(--sc-surface-white); border-radius: 18px;
    box-shadow: 0 24px 60px rgba(26, 31, 54, 0.28);
    animation: hpMvpPop 0.18s ease;
  }
  @keyframes hpMvpPop { from { transform: translateY(12px); opacity: 0; } to { transform: none; opacity: 1; } }
  .hp-mvp-modal-close {
    position: absolute; top: 14px; right: 16px;
    width: 34px; height: 34px; border: none; border-radius: 50%;
    background: rgba(26, 31, 54, 0.06); color: var(--sc-text-primary);
    font-size: 20px; line-height: 1; cursor: pointer;
  }
  .hp-mvp-modal-pad { padding: 30px; display: flex; flex-direction: column; gap: 14px; }
  .hp-mvp-modal-chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .hp-mvp-modal-chip { font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: var(--sc-radius-pill); }
  .hp-mvp-modal-chip--team { background: var(--sc-accent-blue); color: #fff; }
  .hp-mvp-modal-chip--key { background: rgba(255, 230, 122, 0.5); color: var(--sc-text-primary); border: 1px solid rgba(26, 31, 54, 0.07); }
  .hp-mvp-modal-title { font-size: 26px; font-weight: 800; line-height: 1.18; letter-spacing: -0.01em; margin: 2px 0 0; }
  .hp-mvp-modal-by { font-size: 13px; color: var(--sc-text-muted-mid); font-weight: 600; margin: -6px 0 0; }
  .hp-mvp-modal-lead-wrap { margin: 0; }
  .hp-mvp-modal-lead { font-size: 15px; font-weight: 700; line-height: 1.5; background: linear-gradient(transparent 58%, var(--sc-highlight-orange) 58%); }
  .hp-mvp-modal-body { display: flex; flex-direction: column; gap: 12px; }
  .hp-mvp-modal-body p { font-size: 13.5px; line-height: 1.72; color: var(--sc-text-muted-high); margin: 0; }
  .hp-mvp-modal-body p b { color: var(--sc-text-primary); }
  .hp-mvp-modal-diagram { padding: 16px; background: var(--sc-bg-base); border: 1px solid var(--sc-border-soft); border-radius: 12px; }
  .hp-mvp-modal-diagram[hidden] { display: none; }
  .hp-mvp-diagram-cap { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; color: var(--sc-text-muted-mid); text-transform: uppercase; margin-bottom: 12px; text-align: center; }
  .hp-mvp-flow { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6px; }
  .hp-mvp-node { font-size: 11.5px; font-weight: 700; line-height: 1.25; padding: 8px 11px; border-radius: 9px; background: var(--sc-surface-white); border: 1.5px solid var(--sc-text-primary); text-align: center; }
  .hp-mvp-node small { display: block; font-size: 9.5px; font-weight: 600; color: var(--sc-text-muted-mid); margin-top: 2px; }
  .hp-mvp-node--key { background: var(--sc-accent-yellow); }
  .hp-mvp-arrow { color: var(--sc-accent-blue); font-size: 15px; font-weight: 800; }
  .hp-mvp-flow-note { font-size: 11px; color: var(--sc-text-muted-mid); margin: 10px 0 0; text-align: center; }
  .hp-mvp-modal-cta:empty { display: none; }
  body.hp-body .hp-mvp-modal-cta a { display: inline-block; font-size: 13px; font-weight: 700; color: #fff; background: var(--sc-text-primary); padding: 9px 18px; border-radius: var(--sc-radius-pill); text-decoration: none; }
  @media (max-width: 560px) { .hp-mvp-modal-pad { padding: 24px 20px; } }

  /* ─── 조별 그리드 ─── */
  .hp-team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .hp-team-card {
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-card);
    display: flex; flex-direction: column;
    overflow: hidden;
    transition: transform 160ms, box-shadow 160ms, border-color 160ms;
  }
  .hp-team-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(26, 31, 54, 0.07);
    border-color: var(--sc-accent-red);
  }
  .hp-team-card-head {
    padding: 16px 20px;
    background: var(--sc-text-primary);
    color: var(--sc-bg-signature);
    display: flex; flex-direction: column; gap: 6px;
  }
  .hp-team-card-team {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    opacity: 0.75;
  }
  .hp-team-card-title {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 23px;
    line-height: 1.18;
    color: var(--sc-bg-signature);
  }
  .hp-team-card-subtitle {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.45;
    color: rgba(255, 251, 237, 0.72);
  }
  .hp-team-card-body {
    padding: 18px 20px 20px;
    display: flex; flex-direction: column; gap: 14px;
  }
  .hp-team-card-block { display: flex; flex-direction: column; gap: 6px; }
  .hp-team-card-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--sc-text-muted-mid);
  }
  .hp-team-card-block--insight .hp-team-card-label { color: var(--sc-accent-red); }
  .hp-team-card-text {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--sc-text-primary);
  }
  .hp-team-card-block--insight .hp-team-card-text {
    background: rgba(255, 230, 122, 0.40);
    padding: 8px 10px;
    border-radius: 8px;
  }
  @media (max-width: 900px) { .hp-team-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .hp-team-grid { grid-template-columns: 1fr; } }

  /* ─── 주차별 아카이브 — 매거진 백이슈 표지 ─── */
  .hp-issue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }
  .hp-issue-card {
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-card);
    overflow: hidden;
    display: flex; flex-direction: column;
    transition: transform 160ms, box-shadow 160ms, border-color 160ms;
  }
  .hp-issue-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 26px rgba(26, 31, 54, 0.12);
    border-color: var(--sc-surface-dark);
  }
  /* 표지 — 다크 블록에 큰 주차 번호 */
  .hp-issue-cover {
    position: relative;
    background: var(--sc-surface-dark);
    color: var(--sc-bg-signature);
    padding: 40px 20px 14px;
    display: flex;
    align-items: flex-end;
    gap: 8px;
    overflow: hidden;
  }
  .hp-issue-vol {
    position: absolute;
    top: 16px; left: 20px;
    font-family: var(--sc-font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    opacity: 0.7;
  }
  .hp-issue-num {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 64px;
    line-height: 0.92;
    color: var(--sc-bg-signature);
  }
  .hp-issue-coverlabel {
    font-family: var(--sc-font-display);
    font-size: 20px;
    line-height: 1;
    padding-bottom: 6px;
    opacity: 0.85;
  }
  .hp-issue-body {
    padding: 16px 20px 18px;
    display: flex; flex-direction: column; gap: 8px;
    flex: 1;
  }
  .hp-issue-title {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 21px;
    line-height: 1.22;
    color: var(--sc-text-primary);
  }
  .hp-issue-meta {
    font-size: 12px;
    color: var(--sc-text-muted-mid);
    font-weight: 500;
  }
  .hp-issue-readmore {
    margin-top: auto;
    padding-top: 10px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--sc-accent-red);
  }

  /* 최신호 1장 (메인 아카이브 미리보기) — 그리드 없이 표지 1장만 */
  .hp-issue-single {
    max-width: 360px;
    text-decoration: none;
    color: inherit;
  }
  .hp-issue-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; }
  .hp-issue-tags-label {
    font-size: 10px; font-weight: 800; letter-spacing: 0.06em;
    color: var(--sc-accent-blue); margin-right: 2px;
  }
  .hp-issue-tag {
    font-size: 11.5px; font-weight: 600; color: var(--sc-text-primary);
    background: rgba(255, 230, 122, 0.5); border: 1px solid rgba(26, 31, 54, 0.06);
    padding: 2px 8px; border-radius: var(--sc-radius-pill);
  }
  .hp-issue-tag--more {
    background: transparent; border-color: transparent;
    color: var(--sc-text-muted-mid); font-weight: 700; padding-left: 2px;
  }
  @media (max-width: 560px) { .hp-issue-single { max-width: none; } }

  /* 주차별 아카이브 바로가기 버튼 */
  .hp-archive-go {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    padding: 12px 22px;
    border-radius: var(--sc-radius-pill);
    background: var(--sc-surface-dark);
    color: var(--sc-bg-signature);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: filter 140ms, transform 140ms;
  }
  .hp-archive-go:hover { filter: brightness(1.12); transform: translateY(-1px); }

  /* ─── 섹션 헤더 + 제목 옆 '전체 보기' ─── */
  .hp-sh-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hp-sh-row .hp-sh { flex: 1 1 auto; }
  .hp-sh-all {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 14px;
    font-weight: 700;
    color: var(--sc-text-primary);
    padding-bottom: 4px;
    border-bottom: 2px solid var(--sc-text-primary);
    text-decoration: none;
    transition: color 140ms, border-color 140ms;
  }
  .hp-sh-all:hover { color: var(--sc-accent-red); border-bottom-color: var(--sc-accent-red); }

  /* ─── DARK CTA ─── */
  .hp-cta {
    position: relative;
    background: var(--sc-surface-dark);
    color: var(--sc-text-on-dark);
    border-radius: var(--sc-radius-card);
    padding: clamp(36px, 6vw, 64px);
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
    gap: 14px;
  }
  /* 다크 카드 윗변에 얹힌 밝은 거품 크라운 (깊은 물로 다이브) */
  .hp-cta-foam {
    position: absolute;
    top: 0; left: 50%;
    transform: translate(-50%, -52%);
    display: flex; align-items: flex-end; gap: 9px;
    pointer-events: none;
  }
  .hp-cta-foam span {
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--sc-bg-signature);
    box-shadow: 0 2px 8px rgba(26, 31, 54, 0.25);
  }
  .hp-cta-foam span:nth-child(1) { width: 8px;  height: 8px;  opacity: 0.7; }
  .hp-cta-foam span:nth-child(2) { width: 14px; height: 14px; }
  .hp-cta-foam span:nth-child(3) { width: 20px; height: 20px; }
  .hp-cta-foam span:nth-child(4) { width: 13px; height: 13px; }
  .hp-cta-foam span:nth-child(5) { width: 7px;  height: 7px;  opacity: 0.7; }
  .hp-cta-head {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.1;
    color: var(--sc-text-on-dark);
  }
  .hp-cta-body {
    font-size: 15px;
    color: rgba(255, 251, 237, 0.78);
    line-height: 1.7;
    max-width: 480px;
  }
  .hp-cta-btn {
    margin-top: 8px;
    padding: 14px 28px;
    border-radius: var(--sc-radius-pill);
    background: var(--sc-bg-signature);
    color: var(--sc-text-primary);
    font-weight: 700;
    font-size: 15px;
    transition: filter 160ms, transform 160ms;
  }
  .hp-cta-btn:hover { filter: brightness(1.05); transform: translateY(-1px); }

  /* ─── FOOTER ─── */
  .hp-footer {
    background: var(--sc-bg-base);
    border-top: 1px solid var(--sc-border-soft);
    padding: 56px 24px 24px;
    margin-top: 40px;
  }
  .hp-footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--sc-border-soft);
  }
  .hp-footer-brand .hp-brand-name { font-size: 28px; }
  .hp-footer-pitch {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.25;
    color: var(--sc-text-primary);
    margin-top: 10px;
    max-width: 420px;
  }
  .hp-footer-cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .hp-footer-col h4 {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--sc-text-muted-mid);
    margin-bottom: 12px;
  }
