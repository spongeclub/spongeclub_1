        { label: '🚪 커뮤니티 입구' },
      ],
      note: "'처방'이 아니라 '함께 볼 가설' — 신뢰가 먼저.",
    },
  },
};

// 한 주차의 6조 MVP 카드 — 그 주차 실제 mvp:true 기준(없는 조는 placeholder).
function buildWeekMvpCards(w: WeekData) {
  return teamOrder.map((team) => {
    const sub = w.submissions.find(
      (s) => s.mvp && s.filePath && s.status === 'submitted' && s.member.team === team,
    );
    if (!sub) {
      return {
        team, name: '미정', tagline: '이번 호 미정', keywords: [] as string[], ready: false,
        detail: { team, name: '미정', week: w.weekNumber, title: '미정', by: '', lead: '', keywords: [] as string[], paragraphs: [] as string[], diagram: null, url: '' },
      };
    }
    const art = buildArticle(sub, w.weekNumber);
    const d = mvpDetails[`${team}|${w.weekNumber}`] || {};
    const summary = sub.mvpSummary || '';
    const content = sub.mvpContent || '';
    const excerpt = art ? (art.excerpt || '') : '';
    // 검수 콘텐츠 없으면 mvp_content → 노트 발췌 → mvp_summary 순으로 본문 1단락 폴백
    const paragraphs = d.paragraphs && d.paragraphs.length
      ? d.paragraphs
      : [content, excerpt, summary].filter(Boolean).slice(0, 1);
    return {
      team,
      name: sub.member.nickname,
      tagline: summary || (art ? cardTitle(art) : (sub.noteTitle || '')),
      keywords: d.keywords || [],
      ready: true,
      detail: {
        team,
        name: sub.member.nickname,
        week: w.weekNumber,
        title: d.title || sub.member.nickname,
        by: d.by || summary || '',
        lead: d.lead || '',
        keywords: d.keywords || [],
        paragraphs,
        diagram: d.diagram || null,
        url: art?.url && art.url !== '#' ? art.url : '',
      },
    };
  });
}

// 발행된 주차 중 MVP가 1명 이상 있는 호만 탭으로 (오름차순). 활성 = 가장 최신 호.
const mvpWeekData = weeks
  .filter((w) => w.submissions.some((s) => s.mvp && s.filePath && s.status === 'submitted'))
  .map((w) => ({ weekNumber: w.weekNumber, cards: buildWeekMvpCards(w) }));
const activeWeekNum = mvpWeekData.length
  ? mvpWeekData[mvpWeekData.length - 1].weekNumber
  : (latest?.weekNumber ?? 0);
const mvpTabs = mvpWeekData.map((d) => ({ weekNumber: d.weekNumber, isActive: d.weekNumber === activeWeekNum }));
const mvpDetailsByWeek: Record<string, unknown[]> = Object.fromEntries(
  mvpWeekData.map((d) => [String(d.weekNumber), d.cards.map((c) => c.detail)]),
);

// 조별 마을 hotspot — 메인 hero에서는 이동 비활성 (이름만 표시)
const villageTeams = teamOrder.map((team) => ({ name: team }));

// 조별 분석 카드 — 90_analysis/teams/Week_0N_조M.md 에서 로드
const teamAnalyses = latest ? loadTeamAnalyses(latest.weekNumber) : [];
const teamCards = teamOrder.map((team) => {
  const a = teamAnalyses.find((x) => x.team === team);
  if (a) return { team, title: a.title, subtitle: a.subtitle, tagline: a.tagline, insight: a.insight };
  return {
    team,
    title: `${latest?.weekNumber ?? ''}주차의 기록`,
    subtitle: '',
    tagline: '아직 분석이 생성되지 않았습니다.',
    insight: '',
  };
});

const weekLabel = (n: number) => `WEEK ${String(n).padStart(2, '0')}`;
const year = new Date().getFullYear();

// 메인 아카이브 미리보기 — 최신 발행호 1장만 표지로. MVP 닉네임(조 순서)을 칩으로.
const latestIssue = pastIssues[0] ?? null;
const latestIssueMvps = latest
  ? latest.submissions
      .filter((s) => s.mvp && s.filePath && s.status === 'submitted')
      .sort((a, b) => teamOrder.indexOf(a.member.team) - teamOrder.indexOf(b.member.team))
      .map((s) => s.member.nickname)
  : [];
