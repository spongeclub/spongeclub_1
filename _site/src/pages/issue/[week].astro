---
import Layout from '../../layouts/Layout.astro';
import {
  buildAllWeeks,
  buildWeekArticles,
  pickFeature,
  cardTitle,
  weekTheme,
  type Article,
} from '../../lib/data';
import { getWeekRecordOverride } from '../../data/week-record-overrides';
import { getMemberAnalysis } from '../../lib/analysis';

export function getStaticPaths() {
  const weeks = buildAllWeeks().filter((w) => w.submittedCount > 0);
  return weeks.map((w) => ({
    params: { week: String(w.weekNumber) },
    props: { weekNumber: w.weekNumber },
  }));
}

const { weekNumber } = Astro.props as { weekNumber: number };

const weeks = buildAllWeeks().filter((w) => w.submittedCount > 0);
const idx = weeks.findIndex((w) => w.weekNumber === weekNumber);
const week = weeks[idx];
const prev = idx > 0 ? weeks[idx - 1] : null;
const next = idx < weeks.length - 1 ? weeks[idx + 1] : null;

const articles = buildWeekArticles(week);
const feature = pickFeature(articles);
const weekRecordOverride = getWeekRecordOverride(weekNumber);
const defaultCommentImages = [
  '/assets/comments/comment-darami.png',
  '/assets/comments/comment-jingjing.png',
  '/assets/comments/comment-pingping.png',
  '/assets/comments/comment-ddoong.png',
  '/assets/comments/comment-jibge.png',
];
const commentImages = weekRecordOverride?.commentImages ?? defaultCommentImages;
const commentLabel = weekRecordOverride?.commentLabel ?? "데굴데굴's Comment";
const memberRecordKey = (a: Article) => `${a.member.team}/${a.member.nickname}`;

const TEAMS = ['1조', '2조', '3조', '4조', '5조', '6조'];
const byTeam = new Map<string, Article[]>();
for (const a of articles) {
  if (a === feature) continue;
  const arr = byTeam.get(a.member.team) ?? [];
  arr.push(a);
  byTeam.set(a.member.team, arr);
}

const theme = weekTheme(articles);
const weekLabel = (n: number) => `WEEK ${String(n).padStart(2, '0')}`;
const rate =
  week.totalMembers > 0
    ? Math.round((week.submittedCount / week.totalMembers) * 100)
    : 0;

function cleanDisplayText(value: string): string {
  return value
    .replace(/<[^>]+>/g, '')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .replace(/\s*(?:\.{3}|…)+$/u, '')
    .trim();
}

function shortText(value: string, max = 120): string {
  const text = cleanDisplayText(value);
  if (text.length <= max) return text;
  return text.slice(0, max).replace(/\s+\S*$/, '').trim();
}

function normalizeTitle(value: string): string {
  return cleanDisplayText(value)
    .replace(/^\d+\s*주차\s*과제\s*[—–-]\s*/, '')
    .replace(/^\d+\s*주차\s*미션\s*[—–-]\s*/, '')
    .replace(/^\d+조[_\s-]*/u, '')
    .replace(/^프로젝트명[:：]\s*/u, '')
    .replace(/^링크[:：]?\s*/i, '공유 링크')
    .replace(/^https?:\/\/\S+$/i, '외부 기록 링크')
    .replace(/\s*개발 기간:.*$/u, '')
    .replace(/\s*오후\s*\d{1,2}:\d{2}.*$/u, '')
    .replace(/\s*(오전|오후)\s*\d{1,2}:\d{2}\s*$/u, '')
    .replace(/\s*(만들어\s*보자|만들어보자|만들자)$/u, ' 제작')
    .replace(/\s*(해\s*보자|해보자|하자)$/u, ' 실험')
    .replace(/\s*(했다|했습니다|했어요|한다|합니다|되었다|됐어요|진행했다|완료했다|성공했다|성공|완료)$/u, '')
    .replace(/\s*(만들었다|만들었어요)$/u, ' 제작')
    .replace(/\s*(구현했다|구현했어요)$/u, ' 구현')
    .replace(/\s*(설계했다|설계했어요)$/u, ' 설계')
    .replace(/\s*(정리했다|정리했어요)$/u, ' 정리')
    .replace(/\s*(사용했다|사용했어요)$/u, ' 사용')
    .replace(/\s*(?:하고|한 뒤|한 후|시작해서|중인 상황에서)\s*[,，]?\s*$/u, '')
    .replace(/\s+(?:을|를|은|는|이|가|으로|로|와|과)$/u, '')
    .replace(/[.!?。]+$/u, '')
    .trim();
}

function isWeakTitle(value: string): boolean {
  const title = cleanDisplayText(value);
  return (
    !title ||
    /^[:：]/u.test(title) ||
    title === '작성중' ||
    title === '차주 작성 예정' ||
    title === '외부 기록 링크' ||
    title === '공유 링크' ||
    /^claude code\s*로\s*인터뷰스킬\s*사용해서\s*인터뷰\s*까지\s*진행$/iu.test(title) ||
    /^각자만의\s*정의로\s*\[?운영체제\]?\s*라고\s*정의내리는\s*OS\s*구현$/iu.test(title) ||
    /^각자만의\s*OS\s*구현$/iu.test(title) ||
    /^\d+주차\s*(미션|과제)?\s*제출/u.test(title) ||
    /^(미션|과제)\s*\d*$/u.test(title)
  );
}

function isMemberNameTitle(value: string, a: Article): boolean {
  const title = cleanDisplayText(value);
  return (
    title === a.member.nickname ||
    title === a.member.fullName ||
    title === `${a.member.nickname}(${a.member.fullName})` ||
    title === `${a.member.team}_${a.member.nickname}(${a.member.fullName})`
  );
}

function sourceTitle(a: Article): string {
  const candidates = [
    a.noteTitle,
    a.missions.find((m) => m.title && !/^(미션|과제)\s*\d*$/u.test(m.title))?.title ?? '',
    cardTitle(a),
    a.missions.find((m) => m.summary)?.summary ?? '',
    a.excerpt,
  ];
  for (const candidate of candidates) {
    const title = normalizeTitle(candidate);
    if (!isWeakTitle(title) && !isMemberNameTitle(title, a)) return title;
  }
  return `${a.member.nickname}의 ${weekNumber}주차 기록`;
}

function nounTitle(a: Article): string {
  const title = sourceTitle(a);
  if (!title || title === a.member.nickname) return `${a.member.nickname}의 ${weekNumber}주차 기록`;
  return finishTitle(shortText(title, 38));
}

function hasBatchim(text: string): boolean {
  const match = [...text].reverse().find((char) => /[가-힣]/u.test(char));
  if (!match) return false;
  const code = match.charCodeAt(0) - 0xac00;
  return code >= 0 && code <= 11171 && code % 28 !== 0;
}

function objectJosa(text: string): string {
  return hasBatchim(text) ? '을' : '를';
}

function subjectJosa(text: string): string {
  return hasBatchim(text) ? '은' : '는';
}

function compactTopic(title: string): string {
  return finishTitle(shortText(title.replace(/^["'“”]+|["'“”]+$/g, ''), 34));
}

function finishTitle(value: string): string {
  return value
    .replace(/^[:：]\s*/u, '')
    .replace(/^["'“”]+/g, '')
    .replace(/OS Interview Skill을 GitHub에서 설치하고\s*6단계?$/iu, 'OS Interview Skill 설치와 6단계 인터뷰')
    .replace(/셀피쉬클럽의 OS Interview Skill을 설치하고\s*약?$/iu, '셀피쉬클럽 OS Interview Skill 설치')
    .replace(/\s*(?:를|을)\s*설계하고$/u, ' 설계')
    .replace(/\s*(?:를|을)\s*추가한$/u, ' 추가')
    .replace(/\s*(?:를|을)\s*통해$/u, '')
    .replace(/\s*(?:에서|으로)\s*출발$/u, ' 출발')
    .replace(/\s+(?:을|를|은|는|이|가|으로|로|와|과|약|한)\s*$/u, '')
    .replace(/\s*["'“”]+$/g, '')
    .replace(/\s*[,，·+—–-]+\s*$/u, '')
    .trim();
}

function isUsableRecordText(value: string): boolean {
  const text = cleanDisplayText(value);
  return (
    text.length >= 12 &&
    !/^https?:\/\/\S+$/i.test(text) &&
    !/^(작성중|차주 작성 예정|링크|공유 링크)$/u.test(text)
  );
}

function recordSourceText(a: Article): string {
  const candidates = [
    ...a.missions.map((m) => m.summary),
    ...a.missions.map((m) => m.insight),
    a.excerpt,
  ];
  for (const candidate of candidates) {
    if (isUsableRecordText(candidate)) return cleanDisplayText(candidate);
  }
  return '';
}

function analysisSourceText(a: Article): string {
  const highlight = getMemberAnalysis(a.member.team, a.member.nickname)
    ?.weeklyHighlights.find((h) => h.week === a.weekNumber);
  const summary = highlight?.summary ? cleanDisplayText(highlight.summary) : '';
  return summary ? softenAnalysisTone(summary) : '';
}

function softenAnalysisTone(value: string): string {
  return value
    .replace(/이었다(?=[.!?。]|$)/g, '이었어요')
    .replace(/였다(?=[.!?。]|$)/g, '였어요')
    .replace(/되었다(?=[.!?。]|$)/g, '되었어요')
    .replace(/됐다(?=[.!?。]|$)/g, '됐어요')
    .replace(/했다(?=[.!?。]|$)/g, '했어요')
    .replace(/([가-힣]+[았었였했됐겼꼈냈봤웠왔갔졌쳤켰혔췄])다(?=[.!?。]|$)/g, '$1어요')
    .replace(/이다(?=[.!?。]|$)/g, '이에요')
    .replace(/다(?=[.!?。]|$)/g, '어요');
}

function displaySentence(value: string, max = 160): string {
  const text = shortText(value, max).replace(/\s*[,，·+—–-]+\s*$/u, '').trim();
  if (!text) return '';
  return /(?:[.!?。]|[가-힣])$/u.test(text) ? text : `${text}.`;
}

function summaryText(a: Article, title: string): string {
  const source = analysisSourceText(a) || recordSourceText(a);
  if (source) return displaySentence(source);
  return `${title}${objectJosa(title)} 중심으로 이번 주 시도와 배운 점을 정리했어요.`;
}

function editorNoteText(a: Article, title: string): string {
  const topic = compactTopic(title);
  return `${a.member.nickname} 기록은 ${topic}${objectJosa(topic)} 중심으로 시도와 배운 점을 남겼어요. 다음 기록에서 사용 장면까지 붙으면 더 선명해질 것 같아요.`;
}

function generatedRecord(a: Article) {
  const title = nounTitle(a);
  return {
    title,
    summary: summaryText(a, title),
    editorNote: editorNoteText(a, title),
  };
}

function recordFor(a: Article) {
  return weekRecordOverride?.members[memberRecordKey(a)] ?? generatedRecord(a);
}
---

<Layout
  title={`${weekLabel(weekNumber)} · ${weekNumber}주차 — 스폰지클럽`}
  description={`스폰지클럽 ${weekNumber}주차 — ${articles.length}명의 기록.`}
  bodyClass="sc-page"
>
  <header class="sc-header">
    <div class="sc-header-inner">
      <a href="/season1/" class="sc-brand">
        <span class="sc-brand-mark">🧽</span>
        <span class="sc-brand-name">spongeclub</span>
        <span class="sc-brand-sep">/</span>
        <span class="sc-brand-sub">{weekLabel(weekNumber)}</span>
      </a>
      <nav class="sc-nav" aria-label="메인 메뉴">
        <a href="/skills/">스킬&인사이트</a>
        <a href="/gallery/">갤러리</a>
        <a href="/members/">크루</a>
        <a href="/archive/">주차별 아카이브</a>
      </nav>
      <span class="sc-week-pill">{weekLabel(weekNumber)}</span>
    </div>
  </header>

  <main class="sc-main">
    <!-- 표지 -->
    <section class="iss-cover">
      <p class="iss-cover-vol">{weekLabel(weekNumber)} · {weekNumber}주차{week.dateLabel ? ` · ${week.dateLabel}` : ''}</p>
      <h1 class="iss-cover-title">
        <span>{theme || `${weekNumber}주차의 기록`}</span>
      </h1>
      <p class="iss-cover-sub">{articles.length}명이 각자의 방식으로 이번 주를 기록했어요.</p>
      <div class="iss-cover-stats">
        <span><b>{articles.length}</b> 기록</span>
        <span class="iss-cover-sep">·</span>
        <span><b>{week.submittedCount}</b> / {week.totalMembers} 제출</span>
        <span class="iss-cover-sep">·</span>
        <span><b>{rate}%</b></span>
      </div>
    </section>

    {feature && (
      <article class="iss-feature">
        <div class="iss-feature-side">
          <span class="iss-feature-tag">★ 이번 호 주요 기사</span>
          <span class="iss-feature-team">{feature.member.team}</span>
          <span class="iss-feature-name">
            글 · <a href={`/member/${encodeURIComponent(feature.member.team)}/${encodeURIComponent(feature.member.nickname)}/`}><b>{feature.member.nickname}</b></a>
          </span>
        </div>
        <div class="iss-feature-main">
          {(() => {
            const featureRecord = recordFor(feature);
            return (
              <>
                <h2 class="iss-feature-title">{featureRecord.title ?? nounTitle(feature)}</h2>
                <div class="iss-person-record iss-person-record--feature">
                  <div class="iss-person-summary">
                    <p>{featureRecord.summary}</p>
                  </div>
                  <div class="iss-person-comment">
                    <img
                      class="iss-person-comment-avatar"
                      src={commentImages[0]}
                      data-comment-images={JSON.stringify(commentImages)}
                      alt=""
                      loading="lazy"
                    />
                    <div class="iss-person-comment-bubble">
                      <span class="iss-person-comment-label">{commentLabel}</span>
                      <p>{featureRecord.editorNote}</p>
                    </div>
                  </div>
                </div>
              </>
            );
          })()}
          <a class="iss-feature-cta" href={feature.url}>전체 기록 읽기 →</a>
        </div>
      </article>
    )}

    {articles.length === 0 && (
      <div class="iss-empty">이 호에는 아직 제출된 기록이 없습니다.</div>
    )}

    <!-- 조별 -->
    {TEAMS.map((team) => {
      const list = byTeam.get(team) ?? [];
      if (list.length === 0) return null;
      return (
        <section class="iss-team">
          <header class="iss-team-bar">
            <span class="iss-team-name">{team}</span>
            <span class="iss-team-count">{list.length}개 기록</span>
          </header>
          <div class="iss-articles">
            {list.map((a) => {
              const personalRecord = recordFor(a);
              return (
                <a class="iss-article" href={a.url}>
                  <span class="iss-article-by"><b>{a.member.nickname}</b>{a.member.isCrew ? ' · 크루' : ''}</span>
                  <h3 class="iss-article-title">{personalRecord.title ?? nounTitle(a)}</h3>
                  <div class="iss-person-record">
                    <div class="iss-person-summary">
                      <p>{personalRecord.summary}</p>
                    </div>
                    <div class="iss-person-comment">
                      <img
                        class="iss-person-comment-avatar"
                        src={commentImages[0]}
                        data-comment-images={JSON.stringify(commentImages)}
                        alt=""
                        loading="lazy"
                      />
                      <div class="iss-person-comment-bubble">
                        <span class="iss-person-comment-label">{commentLabel}</span>
                        <p>{personalRecord.editorNote}</p>
                      </div>
                    </div>
                  </div>
                  <span class="iss-article-read">읽기 →</span>
                </a>
              );
            })}
          </div>
        </section>
      );
    })}

    <script is:inline>
      {
        const avatars = Array.from(document.querySelectorAll('.iss-person-comment-avatar[data-comment-images]'));
        if (avatars.length > 0) {
          try {
            const images = JSON.parse(avatars[0].getAttribute('data-comment-images') || '[]');
            if (Array.isArray(images) && images.length > 1) {
              const shuffled = [...images].sort(() => Math.random() - 0.5);
              avatars.forEach((img) => {
                img.src = shuffled[avatars.indexOf(img) % shuffled.length];
              });
            }
          } catch {
            // Keep the static fallback image.
          }
        }
      }
    </script>

    <!-- 이슈 이동 -->
    <nav class="iss-nav">
      {prev ? (
        <a href={`/issue/${prev.weekNumber}/`} class="iss-nav-link">
          <span class="iss-nav-label">← 지난 호</span>
          <span class="iss-nav-vol">{weekLabel(prev.weekNumber)} · {prev.weekNumber}주차</span>
        </a>
      ) : <span></span>}
      {next ? (
        <a href={`/issue/${next.weekNumber}/`} class="iss-nav-link iss-nav-link--next">
          <span class="iss-nav-label">다음 호 →</span>
          <span class="iss-nav-vol">{weekLabel(next.weekNumber)} · {next.weekNumber}주차</span>
        </a>
      ) : <span></span>}
    </nav>
  </main>

  <footer class="sc-footer">
    스폰지클럽 · {weekLabel(weekNumber)}
  </footer>
</Layout>

<style is:global>
  /* 표지 */
  .iss-cover { display: flex; flex-direction: column; gap: 14px; }
  .iss-cover-vol {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--sc-accent-red);
  }
  .iss-cover-title {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.04;
    letter-spacing: -0.015em;
    color: var(--sc-text-primary);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .iss-cover-sub {
    font-size: 16px;
    font-weight: 500;
    color: var(--sc-text-muted-high);
    max-width: 640px;
  }
  .iss-cover-stats {
    display: flex; flex-wrap: wrap; gap: 14px;
    margin-top: 10px;
    font-size: 14px;
    color: var(--sc-text-muted-mid);
  }
  .iss-cover-stats b { color: var(--sc-text-primary); font-weight: 700; }
  .iss-cover-sep { color: var(--sc-text-muted-low); }

  /* 주요 기사 */
  .iss-feature {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-card);
    overflow: hidden;
    min-width: 0;
  }
  .iss-feature-side {
    padding: clamp(24px, 3vw, 36px);
    background: var(--sc-surface-dark);
    color: var(--sc-text-on-dark);
    display: flex; flex-direction: column; gap: 14px;
    border-right: 1px solid var(--sc-border-card);
    min-width: 0;
  }
  .iss-feature-tag {
    font-family: var(--sc-font-display);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--sc-bg-signature);
    color: var(--sc-text-primary);
    border-radius: var(--sc-radius-pill);
    padding: 5px 11px;
    align-self: flex-start;
  }
  .iss-feature-team {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(36px, 4.4vw, 60px);
    line-height: 0.95;
    color: var(--sc-bg-signature);
  }
  .iss-feature-name {
    margin-top: auto;
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 230, 122, 0.85);
  }
  .iss-feature-name b { color: var(--sc-bg-signature); font-weight: 700; }
  .iss-feature-name a { border-bottom: 1px solid rgba(255, 230, 122, 0.35); }
  .iss-feature-main {
    padding: clamp(24px, 3vw, 36px);
    display: flex; flex-direction: column; gap: 14px;
    min-width: 0;
  }
  .iss-feature-title {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--sc-text-primary);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .iss-feature-cta {
    align-self: flex-start;
    margin-top: 4px;
    padding: 10px 18px;
    border-radius: var(--sc-radius-pill);
    background: var(--sc-text-primary);
    color: var(--sc-bg-signature);
    font-weight: 700;
    font-size: 13px;
    transition: filter 140ms, transform 140ms;
  }
  .iss-feature .iss-feature-cta {
    color: var(--sc-bg-signature);
  }
  .iss-feature-cta:hover { filter: brightness(1.1); transform: translateY(-1px); }
  @media (max-width: 760px) {
    .iss-feature {
      grid-template-columns: minmax(0, 1fr);
      width: calc(100vw - 48px);
      max-width: 100%;
    }
    .iss-feature-side { border-right: none; border-bottom: 1px solid var(--sc-border-card); }
  }

  .iss-empty {
    padding: 60px 24px;
    text-align: center;
    color: var(--sc-text-muted-mid);
    border: 1px dashed var(--sc-border-card);
    border-radius: var(--sc-radius-card);
  }

  /* 조별 */
  .iss-team { display: flex; flex-direction: column; gap: 16px; }
  .iss-team-bar {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    padding: 14px 18px;
    background: var(--sc-surface-dark);
    color: var(--sc-text-on-dark);
    border-radius: var(--sc-radius-card);
  }
  .iss-team-name {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 28px;
    color: var(--sc-bg-signature);
    line-height: 1;
