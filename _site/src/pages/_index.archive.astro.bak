---
import Layout from '../layouts/Layout.astro';
import SpongeVillageGif from '../components/SpongeVillageGif.astro';
import { activeSeason, seasonByN } from '../config/seasons';
import { loadGallery } from '../lib/gallery';
import { loadGeneratedSkills } from '../lib/skills-generated';
import s2 from '../data/season2.json';

// ────────────────────────────────────────────────────────────────
// 홈 = "보여주는 얼굴"(공개 쇼케이스). /season1 매거진 스타일로 펼침.
// 두 섹션을 메인에 직접 깔아준다: ① 결과물(대표 산출물 카드) ② 인사이트(배운 것 카드).
// 사람 섹션은 메인에서 제외(nav 크루로만). 각 섹션은 '전체 →' 로 허브로.
// 데이터는 실데이터(gallery/skills)에서 집계, 2기는 season2.json 예시 병합.
// ────────────────────────────────────────────────────────────────

const villageTeams = ['1조', '2조', '3조', '4조', '5조', '6조'].map((name) => ({ name }));
const communityUrl = s2.communityUrl;

// ── 결과물: 1기 실데이터 + 2기 예시 병합, 대표 9개 큐레이션 ──
const { items: rawS1 } = loadGallery();
const s1Outputs = rawS1.map((i) => ({ ...i, season: '1기' as const }));
const s2Outputs = (s2.teams ?? []).filter((t) => t.mvp).map((t) => ({
  title: t.mvp!.name, member: t.mvp!.name, team: t.team, category: t.mvp!.kw || '2기',
  descriptionShort: t.mvp!.tagline, mvp: false, season: '2기' as const,
}));
const outputsTotal = s1Outputs.length;
// 대표 3개 — 1기 MVP 우선 (2기 시작 전이라 홈은 1기만 노출)
const s1Mvp = s1Outputs.filter((i) => i.mvp);
const outputsPreview = [...s1Mvp, ...s1Outputs.filter((i) => !i.mvp)].slice(0, 3);

// ── 인사이트: 스킬&인사이트 실데이터, 대표 6개 ──
const skills = loadGeneratedSkills();
const insightsTotal = skills.length;
const insightsPreview = skills.slice(0, 6);

// 시즌 진입 — 1기(공개 중) 중심, 2기는 시작 전 대기
const s1 = seasonByN(1)!;
const [, upM, upD] = (activeSeason.startDate ?? '').split('-');
const upcomingOpen = upM && upD ? `${Number(upM)}/${Number(upD)}` : '곧';

const year = new Date().getFullYear();
const pageDescription = `스폰지클럽이 만든 것·배운 것을 모았습니다 — AI 빌더 커뮤니티. 결과물·인사이트를 한곳에서.`;
---

<Layout title="스폰지클럽 — 흡수하고, 짜내고, 만든다" description={pageDescription} bodyClass="s2-body">
  <!-- ─── HEADER ─────────────────────────────────────── -->
  <header class="s2-header" id="s2-header">
    <div class="s2-header-inner">
      <a href="/" class="s2-brand">
        <span class="s2-brand-mark">🧽</span>
        <span class="s2-brand-name">spongeclub</span>
        <span class="s2-brand-season">1기</span>
      </a>
      <button class="s2-nav-toggle" id="s2-nav-toggle" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="s2-nav">
        <span></span><span></span><span></span>
      </button>
      <nav class="s2-nav" id="s2-nav" aria-label="메인 메뉴">
        <a href="/skills/">스킬&인사이트</a>
        <a href="/gallery/">갤러리</a>
        <a href="/members/">크루</a>
        <a href="/archive/">주차별 아카이브</a>
        <a href={`${s1.path}/recap/`} class="s2-nav-cta">1기 다시보기 →</a>
      </nav>
    </div>
  </header>

  <!-- ─── HERO ───────────────────────────────────────── -->
  <section class="s2-hero">
    <div class="s2-hero-text">
      <span class="s2-hero-kicker">AI 빌더 커뮤니티 · SPONGECLUB</span>
      <h1 class="s2-hero-title">흡수하고, 짜내고, 만든다</h1>
      <p class="s2-hero-lede">
        스폰지처럼 AI를 빨아들여 나만의 제품으로 —<br />
        <span class="s2-hero-lede-em">스폰지클럽이 만든 것 · 배운 것을 한곳에 모았어요</span>
      </p>
    </div>
    <div class="s2-hero-village">
      <SpongeVillageGif teams={villageTeams} interactive={false} />
    </div>
  </section>

  <main class="s2-main">
    <!-- ─── 결과물 (대표 산출물 매거진) ───────────────── -->
    <section class="s2-section" id="outputs">
      <div class="s2-sh-row">
        <div class="s2-sh">
          <h2 class="s2-sh-title">결과물</h2>
          <p class="s2-sh-desc">스폰지클럽이 만든 {outputsTotal}개 산출물 중 대표작 — 클릭하면 전체 결과물로.</p>
        </div>
        <a class="s2-sh-all" href="/gallery/">전체 결과물 {outputsTotal}개 →</a>
      </div>
      <div class="s2-out-grid">
        {outputsPreview.map((o) => (
          <a class="s2-out-card" href="/gallery/">
            <header class="s2-out-head">
              <span class:list={['s2-season-pill', o.season === '2기' ? 's2-season-pill--s2' : 's2-season-pill--s1']}>{o.season}</span>
              <span class="s2-out-cat">{o.category}</span>
            </header>
            <h3 class="s2-out-title">{o.title}</h3>
            <p class="s2-out-desc">{o.descriptionShort}</p>
            <footer class="s2-out-foot"><b>{o.member}</b> · {o.team}</footer>
          </a>
        ))}
      </div>
    </section>

    <!-- ─── 인사이트 (배운 것) ────────────────────────── -->
    <section class="s2-section" id="insights">
      <div class="s2-sh-row">
        <div class="s2-sh">
          <h2 class="s2-sh-title">인사이트</h2>
          <p class="s2-sh-desc">만들며 배운 것 {insightsTotal}개 중 — 직접 써보고 남긴 후기·스킬.</p>
        </div>
        <a class="s2-sh-all" href="/skills/">전체 인사이트 {insightsTotal}개 →</a>
      </div>
      <div class="s2-ins-grid">
        {insightsPreview.map((s) => (
          <a class="s2-ins-card" href="/skills/">
            <span class="s2-ins-area"># {s.area}</span>
            <h3 class="s2-ins-title">{s.title}</h3>
            {s.quotes && s.quotes.length > 0 && (
              <blockquote class="s2-ins-quote">“{s.quotes[0].text}”<cite>— {s.quotes[0].author}</cite></blockquote>
            )}
          </a>
        ))}
      </div>
    </section>

    <!-- ─── 시즌 진입 (현재 시즌 활동 + 지난 시즌 아카이브) ─── -->
    <section class="s2-section">
      <div class="s2-seasons">
        <div class="s2-season-card s2-season-card--active">
          <span class="s2-season-tag">지금 공개 중</span>
          <h3 class="s2-season-title">{s1.label} 시즌</h3>
          <p class="s2-season-desc">{s1.members}명이 {s1.weeks}주간 만든 첫 시즌 — 결과물·인사이트가 그대로 있어요.</p>
          <a class="s2-season-cta s2-season-cta--primary" href={`${s1.path}/recap/`}>{s1.label} 활동 한눈에 다시보기 →</a>
          <a class="s2-season-cta s2-season-cta--sub" href={s1.path}>주차별로 전체 보기 →</a>
        </div>
        <div class="s2-season-card">
          <span class="s2-season-tag s2-season-tag--archive">곧 시작</span>
          <h3 class="s2-season-title">{activeSeason.label} 시즌</h3>
          <p class="s2-season-desc">{activeSeason.label}가 {upcomingOpen} 시작해요. 지금은 준비 중 — 시작하면 매주 여기서 만나요.</p>
          <a class="s2-season-cta s2-season-cta--recap" href={communityUrl} target="_blank" rel="noopener noreferrer">커뮤니티에서 소식 받기 →</a>
        </div>
      </div>
    </section>
  </main>

  <!-- ─── FOOTER ─────────────────────────────────────── -->
  <footer class="s2-footer">
    <div class="s2-footer-inner">
      <div class="s2-footer-brand">
        <span class="s2-brand-name">spongeclub</span>
        <p class="s2-footer-pitch">흡수하고, 짜내고, <span class="s2-highlight">만든다</span>.</p>
      </div>
      <div class="s2-footer-cols">
        <div class="s2-footer-col">
          <h4>둘러보기</h4>
          <ul>
            <li><a href="/gallery/">결과물</a></li>
            <li><a href="/members/">사람</a></li>
            <li><a href="/skills/">인사이트</a></li>
            <li><a href="/archive/">주차별 아카이브</a></li>
          </ul>
        </div>
        <div class="s2-footer-col">
          <h4>시즌</h4>
          <ul>
            <li><a href={`${s1.path}/recap/`}>{s1.label} 다시보기</a></li>
            <li><a href={communityUrl} target="_blank" rel="noopener noreferrer">{activeSeason.label} 곧 시작</a></li>
          </ul>
        </div>
        <div class="s2-footer-col">
          <h4>연결</h4>
          <ul>
            <li><a href="https://github.com/spongeclub/spongeclub_1" target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a href={communityUrl} target="_blank" rel="noopener noreferrer">커뮤니티</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="s2-footer-bot">© {year} SPONGECLUB · Seoul · Republic of Korea</div>
  </footer>

  <script>
    (function () {
      var header = document.getElementById('s2-header');
      var toggle = document.getElementById('s2-nav-toggle');
      var nav = document.getElementById('s2-nav');
      var heroImg = document.querySelector('.s2-hero-village');

      if (toggle && nav) {
        toggle.addEventListener('click', function () {
          var open = nav.classList.toggle('s2-nav--open');
          toggle.setAttribute('aria-expanded', String(open));
        });
        nav.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function () {
            nav.classList.remove('s2-nav--open');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
      }

      if (header) {
        var threshold = function () {
          return heroImg ? Math.max(heroImg.offsetHeight - 70, 80) : 80;
        };
        var onScroll = function () {
          if (window.scrollY > threshold()) header.classList.add('is-solid');
          else header.classList.remove('is-solid');
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    })();
  </script>
</Layout>

<style is:global>
  body.s2-body {
    margin: 0;
    min-height: 100vh;
    background: var(--sc-bg-base);
    color: var(--sc-text-primary);
    font-family: var(--sc-font-body);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.005em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  body.s2-body * { box-sizing: border-box; }
  body.s2-body h1, body.s2-body h2, body.s2-body h3, body.s2-body h4, body.s2-body p, body.s2-body ul { margin: 0; padding: 0; }
  body.s2-body ul { list-style: none; }
  body.s2-body a { color: inherit; text-decoration: none; }

  .s2-highlight {
    background: linear-gradient(transparent 55%, var(--sc-highlight-orange) 55%);
    font-weight: 700;
    padding: 0 4px;
  }

  /* ─── HEADER ─── */
  .s2-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    background: linear-gradient(180deg, rgba(20, 24, 40, 0.42), rgba(20, 24, 40, 0));
    transition: background 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }
  .s2-header .s2-brand-name { color: #FFFBED; }
  .s2-header .s2-nav a { color: rgba(255, 251, 237, 0.92); }
  .s2-header .s2-nav a:hover { color: #FFFFFF; }
  .s2-header.is-solid {
    background: var(--sc-bg-base);
    border-bottom: 1px solid var(--sc-border-soft);
    box-shadow: 0 4px 16px rgba(26, 31, 54, 0.08);
  }
  .s2-header.is-solid .s2-brand-name { color: var(--sc-text-primary); }
  .s2-header.is-solid .s2-nav a { color: var(--sc-text-muted-mid); }
  .s2-header.is-solid .s2-nav a:hover { color: var(--sc-text-primary); }
  .s2-header-inner {
    max-width: 1200px; margin: 0 auto; padding: 0 24px;
    height: 64px; display: flex; align-items: center; gap: 24px;
  }
  .s2-brand { display: inline-flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .s2-brand-mark { font-size: 22px; line-height: 1; }
  .s2-brand-name {
    font-family: var(--sc-font-display); font-weight: 400; font-size: 24px;
    letter-spacing: -0.01em; color: var(--sc-text-primary);
  }
  .s2-brand-season {
    font-family: var(--sc-font-body); font-weight: 800; font-size: 11px;
    letter-spacing: 0.06em; padding: 2px 7px; border-radius: var(--sc-radius-pill);
    background: var(--sc-accent-red); color: #fff;
  }
  .s2-nav { display: flex; align-items: center; gap: 22px; margin-left: auto; font-size: 14px; font-weight: 500; }
  .s2-nav a { transition: color 160ms; }
  .s2-nav-toggle {
    display: none; margin-left: auto; width: 42px; height: 42px;
    flex-direction: column; justify-content: center; align-items: center; gap: 5px;
    background: transparent; border: none; cursor: pointer; padding: 0;
  }
  .s2-nav-toggle span { display: block; width: 22px; height: 2px; background: #FFFBED; border-radius: 2px; transition: background 220ms; }
  .s2-header.is-solid .s2-nav-toggle span { background: var(--sc-text-primary); }
  @media (max-width: 600px) {
    .s2-nav-toggle { display: flex; }
    .s2-nav {
      display: none; position: absolute; top: calc(100% + 6px); right: 12px;
      flex-direction: column; align-items: stretch; gap: 2px; min-width: 200px; padding: 8px;
      background: var(--sc-bg-base); border: 1px solid var(--sc-border-soft);
      border-radius: 16px; box-shadow: 0 14px 34px rgba(26, 31, 54, 0.18);
    }
    .s2-nav.s2-nav--open { display: flex; }
    .s2-header .s2-nav a, .s2-header.is-solid .s2-nav a {
      color: var(--sc-text-primary); padding: 10px 12px; border-radius: 10px;
    }
    .s2-header .s2-nav a:hover { background: var(--sc-bg-signature); }
  }

  /* ─── HERO ─── */
  .s2-hero { position: relative; width: 100%; display: flex; flex-direction: column-reverse; }
  .s2-hero-village { width: 100%; display: block; position: relative; z-index: 1; background: #E5CFAA; }
  .s2-hero-village::after {
    content: ""; position: absolute; left: 0; right: 0; top: 100%; height: 100px;
    background: linear-gradient(180deg, #E5CFAA 0%, #E5CFAA 14%, #ECDFC4 42%, #F4ECD8 70%, #FFFBED 100%);
    pointer-events: none; z-index: 1;
  }
  .s2-hero-village .sv-village {
    aspect-ratio: auto; height: 34vh; min-height: 220px; max-height: 360px;
    -webkit-mask-image: linear-gradient(180deg, #000 94%, transparent 100%);
            mask-image: linear-gradient(180deg, #000 94%, transparent 100%);
  }
  .s2-hero-village .sv-village-gif { object-position: center bottom; }
  .s2-hero-text {
    position: relative; z-index: 2; max-width: 1000px; margin-inline: auto;
    padding: clamp(28px, 3.6vw, 44px) clamp(20px, 3.4vw, 44px) clamp(24px, 3vw, 34px);
    display: flex; flex-direction: column; gap: 14px; align-items: center; justify-content: center; text-align: center;
  }
  .s2-hero-kicker {
    font-family: var(--sc-font-body); font-size: 12px; font-weight: 700; letter-spacing: 0.14em;
    color: var(--sc-text-primary); background: var(--sc-bg-signature); padding: 6px 13px;
    border-radius: var(--sc-radius-pill); box-shadow: 0 4px 14px rgba(26, 31, 54, 0.12);
  }
  .s2-hero-title {
    font-family: var(--sc-font-display); font-weight: 400; font-size: clamp(32px, 5vw, 68px);
    line-height: 1.1; letter-spacing: -0.015em; color: var(--sc-text-primary); word-break: keep-all;
  }
  .s2-hero-lede { font-size: clamp(15px, 1.7vw, 19px); font-weight: 600; line-height: 1.6; color: var(--sc-text-primary); }
  .s2-hero-lede-em { display: inline-block; margin-top: 2px; font-weight: 800; }
  .s2-hero-cta { margin-top: 6px; display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .s2-btn {
    padding: 13px 24px; border-radius: var(--sc-radius-pill); font-weight: 700; font-size: 14px;
    transition: filter 160ms, transform 160ms, background 160ms;
  }
  .s2-btn-dark { background: var(--sc-surface-dark); color: var(--sc-text-on-dark); }
  .s2-btn-dark:hover { transform: translateY(-1px); filter: brightness(1.06); }
  .s2-btn-ghost { background: transparent; color: var(--sc-text-primary); border: 1.5px solid var(--sc-text-primary); }
  .s2-btn-ghost:hover { background: var(--sc-text-primary); color: var(--sc-bg-signature); }

  /* ─── STATS 띠 ─── */
  .s2-stats {
    background: #F8D64D;
    border-top: 1px solid rgba(26, 31, 54, 0.10);
    border-bottom: 1px solid rgba(26, 31, 54, 0.10);
  }
  .s2-stats-inner {
    max-width: 1200px; margin: 0 auto; padding: 24px;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
  }
  .s2-stat { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; }
  .s2-stat-num {
    font-family: var(--sc-font-display); font-weight: 400; font-size: clamp(30px, 3.6vw, 48px);
    line-height: 1; color: #523A0B; font-variant-numeric: tabular-nums;
  }
  .s2-stat-label {
    font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: rgba(26, 31, 54, 0.65);
  }
  @media (max-width: 600px) { .s2-stats-inner { grid-template-columns: repeat(2, 1fr); gap: 16px; } }

  /* ─── MAIN ─── */
  .s2-main { max-width: 1200px; margin: 0 auto; padding: 56px 24px 80px; display: flex; flex-direction: column; gap: 64px; }
  .s2-section { display: flex; flex-direction: column; gap: 24px; }
  .s2-sh { display: flex; flex-direction: column; gap: 4px; }
  .s2-sh-title {
    font-family: var(--sc-font-display); font-weight: 400; font-size: clamp(30px, 4.2vw, 50px);
    line-height: 1.05; letter-spacing: -0.01em; color: var(--sc-text-primary);
  }
  .s2-sh-desc { font-size: 14px; font-weight: 500; color: var(--sc-text-muted-mid); }

  /* ─── 이번 주 미션 ─── */
  .s2-mission-card {
    display: flex; gap: 0; border: 1px solid var(--sc-border-card); border-radius: var(--sc-radius-card);
    overflow: hidden; background: var(--sc-surface-white);
  }
  .s2-mission-week {
    flex-shrink: 0; width: 140px; background: var(--sc-surface-dark); color: var(--sc-bg-signature);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--sc-font-display); font-size: 22px; letter-spacing: 0.04em;
  }
  .s2-mission-body { padding: 28px 30px; display: flex; flex-direction: column; gap: 10px; }
  .s2-mission-title { font-family: var(--sc-font-display); font-weight: 400; font-size: clamp(22px, 3vw, 30px); color: var(--sc-text-primary); }
  .s2-mission-desc { font-size: 15px; line-height: 1.65; color: var(--sc-text-muted-high); }
  .s2-mission-flag { font-size: 13px; font-weight: 700; color: var(--sc-text-primary); }
  @media (max-width: 560px) {
    .s2-mission-card { flex-direction: column; }
    .s2-mission-week { width: 100%; height: 64px; }
  }

  /* ─── 섹션 헤더 행 (제목 + 우측 전체보기/활동 링크) ─── */
  .s2-sh-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .s2-sh-row .s2-sh { flex: 1 1 auto; }
  .s2-sh-all {
    flex-shrink: 0; white-space: nowrap; font-size: 14px; font-weight: 800; color: var(--sc-accent-red);
    padding-bottom: 4px; border-bottom: 2px solid var(--sc-accent-red); transition: opacity 140ms;
  }
  .s2-sh-all:hover { opacity: 0.7; }

  /* ─── nav CTA "2기 활동 바로가기" (강조 버튼) ─── */
  .s2-nav a.s2-nav-cta {
    font-weight: 800; padding: 8px 15px; border-radius: var(--sc-radius-pill);
