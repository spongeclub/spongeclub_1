---
import Layout from '../layouts/Layout.astro';
import MemberCard from '../components/MemberCard.astro';
import { loadMembers, loadUnitGroups } from '../lib/members';

const members = loadMembers();
const unitGroups = loadUnitGroups();
const teamCount = new Set(members.map((m) => m.team)).size;

// 조별 점 색 (조 구분용)
const TEAM_COLORS: Record<string, string> = {
  '1조': 'oklch(68% 0.20 25)',   // 빨강
  '2조': 'oklch(74% 0.17 60)',   // 주황
  '3조': 'oklch(80% 0.16 110)',  // 노랑연두
  '4조': 'oklch(68% 0.16 155)',  // 초록
  '5조': 'oklch(66% 0.17 245)',  // 파랑
  '6조': 'oklch(60% 0.18 300)',  // 보라
};

// 조별 그룹핑 (members는 이미 조 순서로 정렬됨)
const teamGroups: { team: string; list: typeof members }[] = [];
for (const m of members) {
  const last = teamGroups[teamGroups.length - 1];
  if (last && last.team === m.team) last.list.push(m);
  else teamGroups.push({ team: m.team, list: [m] });
}
---

<Layout title="스폰지클럽 1기 — 스폰지클럽" bodyClass="sc-page">
  <header class="sc-header">
    <div class="sc-header-inner">
      <a href="/" class="sc-brand">
        <span class="sc-brand-mark">🧽</span>
        <span class="sc-brand-name">spongeclub</span>
        <span class="sc-brand-sep">/</span>
        <span class="sc-brand-sub">스폰지클럽 1기</span>
      </a>
      <nav class="sc-nav" aria-label="메인 메뉴">
        <a href="/skills/">스킬&인사이트</a>
        <a href="/gallery/">갤러리</a>
        <a href="/members/" class="active">크루</a>
        <a href="/#archive">주차별 아카이브</a>
      </nav>
    </div>
  </header>

  <main class="sc-main">
    <div class="mm-title-row">
      <section class="sc-title-section">
        <p class="sc-kicker">함께 만드는 사람들</p>
        <h1 class="sc-h1">
          <span class="sc-shape sc-shape--circle" aria-hidden="true"></span>
          스폰지클럽 1기
        </h1>
        <p class="sc-lede">
          매주 만들고 나누는 <span class="sc-highlight">{members.length}명</span>의 빌더들.
          카드를 눌러 뒤집으면 소개·SNS·산출물을 볼 수 있어요.
        </p>
      </section>

      <!-- 보기 전환 (제목 레벨 오른쪽) -->
      <div class="mm-view-toggle">
        <button class="mm-view-btn" data-view="team" data-active="true">조별</button>
        <button class="mm-view-btn" data-view="unit" data-active="false">유닛별</button>
      </div>
    </div>

    <!-- 조별 보기 -->
    <div class="mm-view" data-view="team">
      {teamGroups.map(({ team, list }) => (
      <section class="mm-team-section" style={`--team-color: ${TEAM_COLORS[team] ?? 'var(--sc-accent-yellow)'};`}>
        <div class="mm-team-label"><span class="mm-team-dot" aria-hidden="true"></span>{team}</div>
        <div class="mm-grid">
          {list.map((m) => <MemberCard m={m} />)}
        </div>
      </section>
      ))}
    </div>

    <!-- 유닛별 보기 -->
    <div class="mm-view" data-view="unit" hidden>
      {unitGroups.map((u, i) => (
      <section class="mm-team-section mm-unit-section">
        <div class="mm-unit-head">
          <div class="mm-unit-title">
            <span class="mm-unit-no">유닛 {String(i + 1).padStart(2, '0')}</span>
            <span class="mm-unit-name">{u.name}</span>
            {u.tag && <span class="mm-unit-tag">{u.tag}</span>}
          </div>
          {u.desc && <p class="mm-unit-desc">{u.desc}</p>}
        </div>
        <div class="mm-grid">
          {u.members.map((m) => <MemberCard m={m} />)}
        </div>
      </section>
      ))}
    </div>

    <a href="/" class="sc-back">← 홈으로</a>
  </main>

  <footer class="sc-footer">
    스폰지클럽 · 구성원 {members.length}명 · {teamCount}개 조
  </footer>
</Layout>

<script is:inline>
  // 카드 플립
  document.querySelectorAll('.mm-card').forEach((card) => {
    card.addEventListener('click', () => card.classList.toggle('is-flipped'));
  });
  // 조별 / 유닛별 보기 전환
  const viewBtns = document.querySelectorAll('.mm-view-btn');
  const views = document.querySelectorAll('.mm-view');
  viewBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const v = btn.getAttribute('data-view');
      viewBtns.forEach((b) => b.setAttribute('data-active', b === btn ? 'true' : 'false'));
      views.forEach((view) => { view.hidden = view.getAttribute('data-view') !== v; });
    });
  });
</script>

<style is:global>
  /* 제목 + 토글 한 줄 배치 */
  .mm-title-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .mm-title-row .sc-title-section { margin-bottom: 0; }

  /* 보기 전환 토글 */
  .mm-view-toggle {
    display: inline-flex; gap: 4px;
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-pill);
    padding: 4px;
    flex-shrink: 0;
  }
  .mm-view-btn {
    padding: 7px 18px;
    border: none; background: transparent;
    border-radius: var(--sc-radius-pill);
    font-size: 13px; font-weight: 700;
    color: var(--sc-text-muted-mid);
    cursor: pointer;
    transition: all 140ms;
  }
  .mm-view-btn[data-active="true"] {
    background: var(--sc-surface-dark);
    color: var(--sc-text-on-dark);
  }
  .mm-unit-head { margin-bottom: 16px; }
  .mm-unit-title {
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
  }
  .mm-unit-no {
    font-size: 12px; font-weight: 800; letter-spacing: 0.08em;
    color: var(--sc-accent-blue);
  }
  .mm-unit-name {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 26px;
    line-height: 1.1;
    color: var(--sc-text-primary);
  }
  .mm-unit-tag {
    font-size: 11px; font-weight: 700;
    background: var(--sc-accent-blue); color: #fff;
    padding: 2px 9px; border-radius: var(--sc-radius-pill);
  }
  .mm-unit-desc {
    font-size: 13px; font-weight: 500; line-height: 1.6;
    color: var(--sc-text-muted-high);
    margin: 7px 0 0;
    max-width: 720px;
  }

  /* 조별 영역 */
  .mm-team-section {
    background: #e8f3fd; /* 연한 하늘색 */
    border: 1px solid #bcd9f5; /* 푸른 계열 경계 */
    border-radius: var(--sc-radius-card);
    padding: 18px 18px 22px;
    margin-bottom: 22px;
  }
  .mm-team-label {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 12px; font-weight: 800; letter-spacing: 0.06em;
    color: var(--sc-text-muted-high);
    margin-bottom: 14px;
  }
  .mm-team-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--team-color, var(--sc-accent-yellow));
  }

  .mm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 14px;
  }

  .mm-card {
    appearance: none;
    border: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
    perspective: 1000px;
    aspect-ratio: 3 / 4;
    font-family: inherit;
  }

  .mm-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 480ms cubic-bezier(.2,.8,.3,1.1);
    transform-style: preserve-3d;
  }
  .mm-card.is-flipped .mm-inner { transform: rotateY(180deg); }

  .mm-front, .mm-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border: 1px solid #cfe3f7; /* 푸른 계열 경계 */
    border-radius: var(--sc-radius-card);
    background: #ffffff;
    box-shadow: 0 2px 10px rgba(26, 31, 54, 0.07);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* 앞면 */
  .mm-front {
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px 16px;
    gap: 2px;
  }
  .mm-avatar {
    width: 88px; height: 88px;
    border-radius: 50%;
    background: #fff1c4; /* 연노랑 — 로고와 조화 */
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    margin-bottom: 12px;
  }
  .mm-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .mm-avatar img.is-logo { object-fit: contain; padding: 14px; }
  .mm-name {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 20px;
    color: var(--sc-text-primary);
    line-height: 1.15;
  }
  .mm-fullname { font-size: 12px; color: var(--sc-text-muted-mid); }
  .mm-team {
    margin-top: 6px;
    font-size: 11px; font-weight: 700;
    color: var(--sc-text-muted-high);
    display: inline-flex; align-items: center; gap: 6px;
  }
  .mm-crew {
    font-size: 10px; font-weight: 700;
    background: var(--sc-accent-blue); color: #fff;
    padding: 1px 6px; border-radius: 6px;
  }

  /* 뒷면 */
  .mm-back {
    transform: rotateY(180deg);
    padding: 18px 16px;
    gap: 10px;
  }
  .mm-back-fullname {
    font-size: 12px; color: var(--sc-text-muted-mid);
    margin-top: -4px;
  }
  .mm-back-name {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 17px;
    color: var(--sc-text-primary);
  }
  .mm-oneliner {
    font-size: 13px; line-height: 1.55;
    color: var(--sc-text-primary);
    margin: 0;
  }
  .mm-sns { display: flex; flex-direction: column; gap: 6px; }
  .mm-sns a {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 12px; font-weight: 600;
    color: var(--sc-text-primary);
    text-decoration: none;
  }
  .mm-sns a:hover { color: var(--sc-accent-blue); }
  .mm-sns-icon {
    width: 16px; height: 16px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .mm-sns-text-icon {
    width: 16px; height: 16px; flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    background: #00c73c; color: #fff; border-radius: 4px;
    font-size: 11px; font-weight: 800;
  }
  .mm-works { display: flex; flex-direction: column; gap: 5px; margin-top: auto; }
  .mm-work {
    font-size: 11.5px; font-weight: 600;
    color: var(--sc-text-primary);
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: 8px;
    padding: 5px 9px;
    text-decoration: none;
  }
  .mm-work:hover { border-color: var(--sc-text-primary); }
  .mm-empty {
    font-size: 12px; color: var(--sc-text-muted-mid);
    margin: auto 0; text-align: center;
  }

  @media (max-width: 640px) {
    .mm-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  }
</style>
