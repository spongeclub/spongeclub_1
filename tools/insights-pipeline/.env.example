# Slack — `xoxb-...`. Bot scopes: channels:history, chat:write, users:read, im:write
SLACK_BOT_TOKEN=

# Slack channel ID for #이기적인스킬러스 (e.g. C0123456789)
SLACK_INSIGHTS_CHANNEL_ID=

# Operator's Slack user ID (e.g. U0123456789). Optional — used for DM in draft mode.
SLACK_OPERATOR_USER_ID=

# Anthropic API key
ANTHROPIC_API_KEY=

# Anthropic model (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# draft (default) or auto. draft = DM operator only, auto = post to channel.
RUN_MODE=draft

# 1 to skip channel/DM posting entirely. Useful for debugging.
DISABLE_CHANNEL_POST=0
